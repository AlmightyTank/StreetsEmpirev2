  BOSS_HIT_DEFENSE
  BOSS_HIT_BACKUP
  OUTPOST_VISIT
  SIT_DOWN
  SIT_DOWN_AGREED
  /// 0.9.0-G clock events, written by the alert collector.
  TURF_PUSH_INCOMING
  ALLIANCE_CALL
