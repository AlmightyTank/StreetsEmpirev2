// StreetsEmpire - 0.1.0 "Classic Foundation"
// Ruleset: classic-og-v0.1
//
// Money is stored as INTEGER CENTS (BigInt). $1.00 = 100. Never floats.
// Anything not player-facing in 0.1.0 (PvP, alliances, travel) is deliberately
// absent, but the shapes below are chosen so 0.2.0 does not need a redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & sessions
// ---------------------------------------------------------------------------

/// A permanent player identity. Survives every round.
model Account {
  id                 String    @id @default(cuid())
  username           String
  /// Lowercased username. Enforces case-insensitive uniqueness.
  usernameNormalized String    @unique
  /// Lowercased email. Private account recovery and login address.
  email              String    @unique
  emailVerifiedAt    DateTime?
  passwordHash       String

  discordId       String?   @unique
  discordUsername String?
  discordAvatar   String?
  discordLinkedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  isActive     Boolean @default(true)
  isAdmin      Boolean @default(false)
  betaApproved Boolean @default(false)

  /// 0.3.0-B. A timed suspension. The account signs back in on its own once this
  /// passes; the fields are cleared lazily on the next sign-in attempt.
  suspendedUntil      DateTime?
  suspendedReason     String?
  suspendedByUsername String?

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  accountEmailTokens   AccountEmailToken[]
  forumLink            ForumLink?
  forumLinkRequest     ForumLinkRequest?
  notificationSettings NotificationSettings?
  notificationOutbox   NotificationOutbox[]
  pushSubscriptions    PushSubscription[]
  profile              AccountProfile?
  roundPlayers         RoundPlayer[]
  authoredNews         GameNews[]            @relation("GameNewsAuthor")
  adminAuditEntries    AdminAuditLog[]       @relation("AdminAuditActor")
}

/// 0.3.0-B. One row per admin action: who, what, when, and the target before
/// and after. The app only ever inserts these.
model AdminAuditLog {
  id String @id @default(cuid())

  /// Null once the acting account is deleted; actorUsername keeps the name.
  actorAccountId String?
  actor          Account? @relation("AdminAuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorUsername  String

  /// Dotted verb, e.g. round.schedule or round.end-early.
  action     String
  targetType String
  targetId   String?
  reason     String?

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

/// Cosmetic and preference settings. Pure prestige: never affects round starts,
/// action math, stores, ranks or combat.
model AccountProfile {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  activeTitleKey    String?
  featuredBadgeKeys Json    @default("[]")
  profileAccent     String  @default("default")
  uiDensity         String  @default("comfortable")
  reducedMotion     Boolean @default(false)
  moneyFormat       String  @default("full")
  defaultLanding    String  @default("game")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Verified public profile connection; owned by the permanent account.
model ForumLink {
  accountId     String   @id
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  forumOrigin   String
  forumUserId   String
  forumUsername String
  createdAt     DateTime @default(now())

  @@unique([forumOrigin, forumUserId])
}

/// Only the latest request in the initiating game session can be completed.
model ForumLinkRequest {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nonceHash String   @unique
  sessionId String
  expiresAt DateTime
}

/// Opt-in alerts for one account: which categories, and which channels deliver them.
/// turnsArmed: turns were below the cap at the last check, so reaching it sends one reminder.
/// rankRoundId/rankLastNational: the national rank last seen, to notice losing #1 or the top 10.
model NotificationSettings {
  accountId        String    @id
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  turnsEnabled     Boolean   @default(false)
  turnsArmed       Boolean   @default(false)
  turnsLastSentAt  DateTime?
  attacksEnabled   Boolean   @default(false)
  roundEnabled     Boolean   @default(false)
  rankEnabled      Boolean   @default(false)
  turfEnabled      Boolean   @default(false)
  turfEnabledAt    DateTime?
  allianceEnabled  Boolean   @default(false)
  allianceEnabledAt DateTime?
  rankRoundId      String?
  rankLastNational Int?
  /// Discord DMs; only delivered while Discord is linked.
  discordEnabled   Boolean   @default(true)
  /// Web Push to every registered device.
  pushEnabled      Boolean   @default(false)
  updatedAt        DateTime  @updatedAt

  @@index([turnsEnabled])
}

enum NotificationChannel {
  DISCORD
  PUSH
}

/// One alert waiting for one channel. The server works out what is due once and
/// writes a row per channel; each channel claims its own rows, so none steals another's.
model NotificationOutbox {
  id        String              @id @default(cuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  /// attacks | turns | round | rank | turf | alliance
  category  String
  /// The alert itself, without any channel address (see @streets/shared NotificationPayload).
  payload   Json
  /// e.g. battle:<id>:<account>:PUSH, so a repeated collection never duplicates an alert.
  dedupeKey String              @unique
  createdAt DateTime            @default(now())
  claimedAt DateTime?

  @@index([channel, claimedAt, createdAt])
  @@index([createdAt])
}

/// A browser or phone that accepts Web Push for an account.
model PushSubscription {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  deviceLabel   String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([accountId])
}

enum AccountEmailTokenPurpose {
  VERIFY_EMAIL
  CHANGE_EMAIL
}

model AccountEmailToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  purpose  AccountEmailTokenPurpose
  newEmail String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

/// Server-side session record. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a database leak cannot be replayed as a login.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Rounds
// ---------------------------------------------------------------------------

enum RoundStatus {
  SCHEDULED
  REGISTRATION
  ACTIVE
  ENDED
  ARCHIVED
}

enum QuestStatus {
  LOCKED
  AVAILABLE
  ACTIVE
  READY_TO_TURN_IN
  COMPLETED
  FAILED
  EXPIRED
}

enum QuestRepeatability {
  ONCE
  DAILY
  WEEKLY
  REPEATABLE
}

/// Relationship standing for one player. Historically this held store-trader
/// standing only; the unified Jobs system also stores named contact reputation
/// here so old rounds and current contacts can coexist without copying scores.
model PlayerReputation {
  id            String @id @default(cuid())
  roundPlayerId String
  /// Relationship key. Historical store keys include CORNER/TOMMY/CHARLIE/PIP;
  /// current job contacts may also use MAMA_KING/WHEELS/VIC/BLOCKS.
  trader        String

  points      Int       @default(0)
  /// Day the regular-trade credit was last paid, so it can be paid at most
  /// once a day without keeping a history of every trade.
  creditedOn  DateTime?
  /// Legacy one-favor completion marker. Current Jobs use PlayerQuest instead.
  questDoneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roundPlayer RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  @@unique([roundPlayerId, trader])
  @@index([roundPlayerId])
}

// ---------------------------------------------------------------------------
// Handcrafted quests
// ---------------------------------------------------------------------------

/// Version-pinned quest content. Definitions are separate from PlayerQuest so
/// one ruleset can publish a catalog once and every seasonal RoundPlayer can
/// progress through it independently.
model QuestDefinition {
  id String @id @default(cuid())

  /// Stable key inside one ruleset version, e.g. FIRST_NIGHT_OUT.
  key            String
  rulesetId      String
  rulesetVersion String

  title       String
  description String
  /// Future contact/NPC key. Null permits system/event quests.
  contactKey  String?
  /// STORY, SIDE, CONTRACT, DAILY, WEEKLY, SECRET, ALLIANCE or EVENT.
  type        String
  /// Free-form gameplay grouping such as STREET, COMBAT, TRAVEL or TURF.
  category    String
  /// STREET_JOB, CONTRACT, SERIOUS_BUSINESS, HIGH_RISK or KINGPIN_CONTRACT.
  difficulty  String

  /// JSON keeps the foundation extensible while Phase B supplies typed
  /// objective/prerequisite/reward kinds in the ruleset package.
  prerequisites   Json @default("[]")
  objectives      Json
  bonusObjectives Json @default("[]")
  rewards         Json
  followUpKeys    Json @default("[]")
  availability    Json @default("{}")

  repeatability       QuestRepeatability @default(ONCE)
  expiresAfterMinutes Int?
  isEnabled           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerQuests PlayerQuest[]

  @@unique([rulesetId, rulesetVersion, key])
  @@index([rulesetId, rulesetVersion, isEnabled])
  @@index([contactKey, isEnabled])
}

/// One player's attempt at one quest. The attempt number prevents
/// daily/weekly/repeatable contracts from requiring a second schema later,
/// while ONCE quests naturally stay on attempt 1.
model PlayerQuest {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  questDefinitionId String
  questDefinition   QuestDefinition @relation(fields: [questDefinitionId], references: [id], onDelete: Restrict)
  progressReceipts QuestProgressReceipt[]

  attempt   Int @default(1)
  status    QuestStatus @default(AVAILABLE)
  isTracked Boolean @default(false)

  objectiveProgress Json @default("{}")
  bonusProgress     Json @default("{}")
  chosenBranch      String?
  rewardState       Json @default("{}")

  acceptedAt  DateTime?
  completedAt DateTime?
  claimedAt   DateTime?
  failedAt    DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, questDefinitionId, attempt])
  @@index([roundPlayerId, status])
  @@index([questDefinitionId, status])
  @@index([status, expiresAt])
}

/// Idempotency/audit receipt for one source event applied to one quest attempt.
/// The source key is usually activity:<PlayerActivity.id>; explicit emitters may
/// use another stable domain key.
model QuestProgressReceipt {
  id String @id @default(cuid())

  playerQuestId String
  playerQuest   PlayerQuest @relation(fields: [playerQuestId], references: [id], onDelete: Cascade)

  sourceKey String
  eventType String
  /// Objective deltas actually credited by this event.
  applied Json @default("{}")

  createdAt DateTime @default(now())

  @@unique([playerQuestId, sourceKey])
  @@index([playerQuestId, createdAt])
  @@index([sourceKey])
}

model Round {
  id   String @id @default(cuid())
  name String
  slug String @unique

  rulesetId      String
  rulesetVersion String

  status RoundStatus @default(SCHEDULED)

  startsAt DateTime
  endsAt   DateTime

  registrationOpensAt DateTime?

  /// Round alerts collected for players, each once. Rounds that already opened
  /// or ended before these existed were backfilled.
  alertsOpenedAt     DateTime?
  alertsEndingSoonAt DateTime?
  alertsEndedAt      DateTime?
  /// When the Discord bot claimed the public round-end post.
  discordEndedAt     DateTime?

  /// Next OG-style public pimp id to hand out. Raw database ids are never
  /// exposed; players see e.g. BigDaddy (#1842).
  nextPublicPimpId Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players     RoundPlayer[]
  news        GameNews[]
  alliances   Alliance[]
  highMarkets HighMarket[]
  turf        Turf[]
  turfTax     TurfTaxLedger[]
  turfPushes  TurfPush[]
  turfControlEvents TurfControlEvent[]
  turfHoldSegments TurfHoldSegment[]
  turfCrackdown TurfCrackdown?

  @@index([status])
}

// ---------------------------------------------------------------------------
// Cities
// ---------------------------------------------------------------------------

/// Travel does not exist in 0.1.0, but every player has a home city from day
/// one and the modifiers are already wired into the ruleset math.
model City {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  isEnabled Boolean @default(false)

  // 0.5.0-A: a city's character (prices, supply, police, Heat levels, roads and the
  // old scout/income/crack modifiers) lives in the round's pinned ruleset.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players RoundPlayer[]
  turf    Turf[]
  turfPresence TurfPresence[]
  turfControlEvents TurfControlEvent[]
  turfCrackdowns TurfCrackdown[]
}

// ---------------------------------------------------------------------------
// Round players
// ---------------------------------------------------------------------------

model RoundPlayer {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Player-visible OG id, unique inside the round.
  publicPimpId Int

  displayName String

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Integer cents.
  cashCents BigInt @default(0)

  turns                 Int       @default(0)
  lastTurnCalculationAt DateTime  @default(now())
  lastActiveAt          DateTime  @default(now())
  /// Durable away-bonus state. Prevents collecting twice by refresh spam.
  lastAwayBonusAt       DateTime?

  payoutPercent Int @default(50)

  whores       Int @default(0)
  thugs        Int @default(0)
  woundedThugs Int @default(0)

  condoms  Int @default(0)
  medicine Int @default(0)
  crack    Int @default(0)
  beer     Int @default(0)

  pistols  Int @default(0)
  shotguns Int @default(0)
  tek9s    Int @default(0)
  ak47s    Int @default(0)

  /// What each shop currently has on the shelf for this player, and the clock
  /// each shelf refills on. Same lazy-regeneration shape as turns: the counter only
  /// moves when the player is looked at. A ruleset with no limit on a weapon
  /// simply never reads its pair.
  pistolStock    Int      @default(0)
  pistolStockAt  DateTime @default(now())
  shotgunStock   Int      @default(0)
  shotgunStockAt DateTime @default(now())
  tek9Stock      Int      @default(0)
  tek9StockAt    DateTime @default(now())
  ak47Stock      Int      @default(0)
  ak47StockAt    DateTime @default(now())

  lowRiderStock   Int      @default(0)
  lowRiderStockAt DateTime @default(now())

  condomStock     Int      @default(0)
  condomStockAt   DateTime @default(now())
  medicineStock   Int      @default(0)
  medicineStockAt DateTime @default(now())
  beerStock       Int      @default(0)
  beerStockAt     DateTime @default(now())
  crackStock      Int      @default(0)
  crackStockAt    DateTime @default(now())
  thugStock       Int      @default(0)
  thugStockAt     DateTime @default(now())

  lowRiders Int @default(0)

  /// Weapon access, earned with reputation and never revoked once granted.
  shotgunUnlocked Boolean @default(false)
  tek9Unlocked    Boolean @default(false)
  ak47Unlocked    Boolean @default(false)

  /// Consecutive trips worked without sending anyone out short on condoms.
  /// The clerk's favour is the only thing that reads it.
  cleanShiftStreak Int @default(0)

  /// 0.4.0-C. Attention the crew's product draws, 0..ruleset heat max. Decays on the turn clock
  /// (lastTurnCalculationAt), so it needs no clock of its own. Always 0 on rounds without Heat.
  heat               Int @default(0)
  /// 0.5.0-C. Locked up after an arrest at home: no actions until then.
  lockedUntil        DateTime?
  /// 0.5.0-D. On the road to a new home until then: no actions, and still a target in
  /// the old city (cityId changes on arrival). The move itself is a Relocation row.
  movingUntil        DateTime?
  /// 0.5.0-E. Thugs out on a tail or riding backup for a convoy: still the player's, still
  /// in net worth, but not fit for anything else until the fight is settled.
  busyThugs          Int @default(0)
  /// 0.6.0-A. Thugs standing on corners this crew holds: still the player's and still in
  /// net worth, but not at home to work, cover the street, cook or defend. Unlike
  /// `busyThugs` they have no deadline: they stand there until they are pulled or pushed off.
  postedThugs        Int @default(0)
  /// 0.6.0-B. Net-worth value of guns removed from the home arsenal and posted on turf.
  postedNetWorthCents BigInt @default(0)
  /// 0.6.0-D. Net-worth value stored in away outpost boxes.
  outpostNetWorthCents BigInt @default(0)
  /// Rocks sold to Pip this round, for his favour. Cumulative, never reset.
  rocksSuppliedToPip Int @default(0)
  /// Drive-bys carried out this round, landed or not, for Charlie's favour.
  driveBysDone       Int @default(0)
  /// 0.3.0-B favours. Store purchases this round, whichever shop sold them. Rows from
  /// rounds before these were added start at zero.
  condomsBought      Int @default(0)
  medicineBought     Int @default(0)
  beerBought         Int @default(0)
  pistolsBought      Int @default(0)
  /// Raids carried out this round in any form but the drive-by, landed or not.
  raidsDone          Int @default(0)

  /// Derived from supplies, protection and fatigue. Stored so it can be read
  /// and ranked without recomputing, but never the source of truth.
  whoreHappiness Int @default(100)
  thugHappiness  Int @default(100)

  /// Integer cents.
  netWorthCents     BigInt @default(0)
  /// 0.5.0-B. Net worth of what is out on a run (cash, cars, escorts, cargo), which has
  /// left the columns above. Zero when nothing is out.
  awayNetWorthCents BigInt @default(0)

  localRank           Int?
  nationalRank        Int?
  localRankSinceAt    DateTime @default(now())
  nationalRankSinceAt DateTime @default(now())

  dailyStartingLocalRank    Int?
  dailyStartingNationalRank Int?
  /// When the daily rank snapshot above was taken. Null means never.
  dailyRankSnapshotAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity              PlayerActivity[]
  economyLedger         EconomyLedgerEntry[]
  processedActions      ProcessedAction[]
  reputation            PlayerReputation[]
  playerQuests          PlayerQuest[]
  raidsSent             RaidBattle[]       @relation("RaidAttacker")
  raidsReceived         RaidBattle[]       @relation("RaidDefender")
  combatInjuries        CombatInjury[]
  observedIntel         CombatIntel[]      @relation("IntelObserver")
  targetedIntel         CombatIntel[]      @relation("IntelTarget")
  raidProtectedUntil    DateTime?
  raidCooldownUntil     DateTime?
  lastRaidedAt          DateTime?
  /// Drive-bys run on their own clocks so one can set up a raid.
  driveByCooldownUntil  DateTime?
  driveByProtectedUntil DateTime?
  lastDrivenByAt        DateTime?

  /// Seasonal hideout rooms. These reset naturally because each round creates
  /// a fresh RoundPlayer row, while ended rows keep the final build archived.
  hideoutSafeRoomLevel   Int @default(0)
  hideoutLookoutsLevel   Int @default(0)
  hideoutWorkshopLevel   Int @default(0)
  hideoutBackOfficeLevel Int @default(0)
  /// 0.6.0-D. One level opens a second concurrent travel run.
  hideoutGarageLevel    Int @default(0)
  /// 0.7.0-F. Which guns home squads and run escorts consume first.
  hideoutWeaponPriority String @default("POWER")
  /// 0.7.0-G. Permanent for this RoundPlayer; the next season starts clean.
  hideoutSafeRoomSpecialization   String?
  hideoutLookoutsSpecialization   String?
  hideoutWorkshopSpecialization   String?
  hideoutBackOfficeSpecialization String?

  /// 0.3.0-C. The alliance this player is in now, and since when. Shared revenge only
  /// counts hits on the alliance from after the member joined.
  allianceId            String?
  alliance              Alliance?          @relation("AllianceMembers", fields: [allianceId], references: [id], onDelete: SetNull)
  allianceJoinedAt      DateTime?
  /// The alliance this player last left or was kicked from. Until the cooldown passes
  /// they cannot join or found an alliance, and they and that alliance cannot hit each other.
  formerAllianceId      String?
  allianceCooldownUntil DateTime?
  allianceInvites       AllianceInvite[]   @relation("AllianceInvitee")
  /// 0.4.0-A. Every product except crack, which stays on the `crack` column in every round.
  products              PlayerProduct[]
  productShelves        ProductShelf[]
  /// 0.5.0-B. Runs out of town, Pip's shelves in other cities, and what the crew saw there.
  runs                  Run[]
  cityShelves           CityShelf[]
  citySightings         CitySighting[]
  relocations           Relocation[]
  convoyTailsOwned      ConvoyTail[]   @relation("ConvoyTailOwner")
  convoyTailsStarted    ConvoyTail[]   @relation("ConvoyTailAttacker")
  convoyBackups         ConvoyBackup[]
  convoyRecon           ConvoyRecon?
  /// 0.6.0-A. Blocks this crew holds, and the blocks it has worked lately.
  turfHeld              Turf[]             @relation("TurfHolder")
  turfPresence          TurfPresence[]
  turfTaxPaid           TurfTaxLedger[]    @relation("TurfTaxPayer")
  turfTaxEarned         TurfTaxLedger[]    @relation("TurfTaxHolder")
  /// 0.6.0-C. Turf wars started against or defended by this crew.
  turfPushesStarted      TurfPush[]          @relation("TurfPushAttacker")
  turfPushesDefended     TurfPush[]          @relation("TurfPushDefender")
  turfPushBackups        TurfPushBackup[]
  /// 0.6.0-D. Supply/tax boxes for away turf.
  turfOutposts           TurfOutpost[]
  turfHoldSegments       TurfHoldSegment[]
  /// 0.4.0-B. Which products each job burns, in order.
  supplyPolicies        WorkSupplyPolicy[]
  /// 0.3.0-D. Wire posts written, and the private rolodex in both directions.
  wirePosts             AllianceWirePost[] @relation("WireAuthor")
  contacts              PlayerContact[]    @relation("ContactOwner")
  contactOf             PlayerContact[]    @relation("ContactTarget")

  @@unique([roundId, accountId])
  @@unique([roundId, publicPimpId])
  @@index([roundId, netWorthCents(sort: Desc)])
  @@index([roundId, cityId, netWorthCents(sort: Desc)])
  @@index([allianceId])
}

// ---------------------------------------------------------------------------
// Alliances (0.3.0-C)
// ---------------------------------------------------------------------------

/// A crew of players inside one round. Resets with the round like everything else.
model Alliance {
  id      String @id @default(cuid())
  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  name           String
  /// Lowercased. A disbanded alliance gets its id appended so the name is free again.
  nameNormalized String
  /// Shown in brackets beside member names, e.g. [NYC].
  tag            String
  tagNormalized  String

  /// A RoundPlayer id. No foreign key: leadership moves inside the same locked
  /// transaction as membership, and a disbanded alliance keeps its last leader.
  leaderId String

  disbandedAt   DateTime?
  disbandReason String?

  /// 0.3.0-C recruitment thread in the forum's recruitment tag. Posted once, by the leader.
  /// forumPostStartedAt claims the post so a double click cannot open two threads.
  forumDiscussionId  String?
  forumPostStartedAt DateTime?
  forumError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members RoundPlayer[]      @relation("AllianceMembers")
  invites AllianceInvite[]
  events  AllianceEvent[]
  wire    AllianceWirePost[]

  @@unique([roundId, nameNormalized])
  @@unique([roundId, tagNormalized])
  @@index([roundId, disbandedAt])
}

/// A standing offer to one player. Accepting re-checks the cap under the alliance lock.
model AllianceInvite {
  id            String      @id @default(cuid())
  allianceId    String
  alliance      Alliance    @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  inviteeId     String
  invitee       RoundPlayer @relation("AllianceInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  /// Display name of whoever sent it, kept as text so it survives them leaving.
  invitedByName String
  createdAt     DateTime    @default(now())
  expiresAt     DateTime

  @@unique([allianceId, inviteeId])
  @@index([inviteeId, expiresAt])
}

/// 0.3.0-D. A short post only the alliance's current members can read.
/// Removed posts stay for moderation history but are never shown to players.
model AllianceWirePost {
  id         String      @id @default(cuid())
  allianceId String
  alliance   Alliance    @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  authorId   String
  author     RoundPlayer @relation("WireAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime    @default(now())

  /// Set when the author, the alliance leader or an admin removed it.
  removedAt     DateTime?
  removedByName String?
  /// author, leader or admin.
  removedByRole String?
  removedReason String?

  @@index([allianceId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

/// 0.4.0-A. Stock of one product for one round player. Crack is never stored here: it keeps
/// the RoundPlayer.crack column so older rounds and every crack reader stay unchanged. Which
/// products exist, and what they do, comes from the round's pinned ruleset.
model PlayerProduct {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  /// Ruleset product key, e.g. ECSTASY.
  productKey    String
  quantity      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([roundPlayerId, productKey])
}

/// 0.4.0-D. Pip's shelf for one non-crack product, per player, on the lazy restock clock.
/// No row means a full shelf; crack keeps its crackStock columns.
model ProductShelf {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  productKey    String
  stock         Int
  stockAt       DateTime

  @@unique([roundPlayerId, productKey])
}

/// 0.5.0-B. A run: Low-Riders, escorts, cash and product out on the road. What it took is
/// all it has; everything it holds comes home when it does.
model Run {
  id             String      @id @default(cuid())
  roundPlayerId  String
  roundPlayer    RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  status         RunStatus   @default(ACTIVE)
  /// City slug the run left from and returns to.
  homeCity       String
  lowRiders      Int
  escortThugs    Int
  /// The run's wallet, integer cents. Never below zero.
  cashCents      BigInt
  startCashCents BigInt
  /// 0.6.0-D. Beer carried by the run for outpost supply.
  beer           Int         @default(0)
  startBeer      Int         @default(0)
  turnsSpent     Int
  launchedAt     DateTime    @default(now())
  returnedAt     DateTime?
  /// 0.5.0-C. Stops whose road in has been rolled for a police stop, counted from the first.
  roadChecks     Int         @default(0)
  /// 0.5.0-E. Escorts wounded in a convoy fight: not fit to fight again on this run, and
  /// still healing when they get home if their wounds have not run out.
  woundedEscorts Int         @default(0)
  /// 0.5.0-E. When the run was last hit, for the re-hit cooldown.
  lastHitAt      DateTime?
  /// 0.5.0-E. The guns the escorts carry, out of home stock, best first. A bust or an
  /// arrest on the run takes them all.
  pistols        Int         @default(0)
  shotguns       Int         @default(0)
  tek9s          Int         @default(0)
  ak47s          Int         @default(0)
  tails          ConvoyTail[]
  stops          RunStop[]
  cargo          RunCargo[]
  trades         RunTrade[]
  incidents      RunIncident[]

  @@index([roundPlayerId, status])
}

enum RunStatus {
  ACTIVE
  RETURNED
}

/// 0.5.0-B. One leg of a run and the stop it ends at. The last stop is always home, with no
/// trading window. Where the run is at any moment is worked out from these times.
model RunStop {
  id       String    @id @default(cuid())
  runId    String
  run      Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  order    Int
  city     String
  /// City slugs driven from the previous stop to this one, both ends included.
  route    Json
  departAt DateTime
  arriveAt DateTime
  /// When the trading window closes. Null for the drive home.
  leaveAt  DateTime?

  @@unique([runId, order])
}

/// 0.5.0-B. What is in the trunk.
model RunCargo {
  id            String @id @default(cuid())
  runId         String
  run           Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  productKey    String
  quantity      Int
  /// What was loaded at home, for the receipt.
  startQuantity Int

  @@unique([runId, productKey])
}

/// 0.5.0-B. Every trade a run made, for the receipt.
model RunTrade {
  id         String   @id @default(cuid())
  runId      String
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  city       String
  productKey String
  /// "buy" or "sell".
  direction  String
  /// 0.5.0-C. "pip" (his counter) or "market" (the high market).
  venue      String   @default("pip")
  quantity   Int
  unitCents  Int
  totalCents BigInt
  createdAt  DateTime @default(now())

  @@index([runId])
}

/// 0.5.0-B. Pip's shelf for one product in another city, per player, on the lazy restock clock.
/// No row means a full shelf at the city's supply level.
model CityShelf {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  city          String
  productKey    String
  stock         Int
  stockAt       DateTime

  @@unique([roundPlayerId, city, productKey])
}

/// 0.5.0-B. What a player's crew last saw at Pip's counter in a city: supply, prices and stock.
/// 0.5.0-E. A tail on a run: the attacker's squad is committed, and the hit lands at
/// `landsAt` if the run is still in reach of `city` then.
enum ConvoyTailStatus {
  PENDING
  LANDED
  ESCAPED
}

model ConvoyTail {
  id                 String           @id @default(cuid())
  runId              String
  run                Run              @relation(fields: [runId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              RoundPlayer      @relation("ConvoyTailOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  attackerId         String
  attacker           RoundPlayer      @relation("ConvoyTailAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  /// "HOME" (a squad from where the attacker lives) or "RUN" (the escorts of the attacker's own run).
  source             String
  attackerRunId      String?
  /// The city whose reach the hit lands in.
  city               String
  squad              Int
  /// The squad as it set out: morale, weapons, and the supply boost it burned.
  attackerCrew       Json
  turnsSpent         Int
  actionId           String
  startedAt          DateTime
  landsAt            DateTime
  status             ConvoyTailStatus @default(PENDING)
  settledAt          DateTime?
  /// The fight and what moved, for both sides' reports.
  result             Json?
  /// When the attacker's side (loot, the squad home, its wounds) reached them.
  attackerCreditedAt DateTime?
  alliesCalledAt     DateTime?
  voidedAt           DateTime?
  backups            ConvoyBackup[]

  @@unique([attackerId, actionId])
  @@index([runId, status])
  @@index([status, landsAt])
  @@index([attackerId, attackerCreditedAt])
}

/// 0.5.0-E. A player's last recon of the area: the runs coming near, in town or leaving
/// where they live and where their run is, as seen then. Only a run it found can be tailed.
model ConvoyRecon {
  id            String      @id @default(cuid())
  roundPlayerId String      @unique
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  seenAt        DateTime
  expiresAt     DateTime
  /// The targets as seen, for the page and for checking a tail.
  targets       Json
}

/// 0.5.0-E. Thugs sent to a convoy's fight by its owner or an ally. They come home after
/// it, win or lose, with any wounds they took.
model ConvoyBackup {
  id         String      @id @default(cuid())
  tailId     String
  tail       ConvoyTail  @relation(fields: [tailId], references: [id], onDelete: Cascade)
  playerId   String
  player     RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// "OWNER" or "ALLY".
  kind       String
  thugs      Int
  /// Weapons and morale as they rode out.
  crew       Json
  sentAt     DateTime
  wounded    Int         @default(0)
  creditedAt DateTime?

  @@unique([tailId, playerId])
  @@index([playerId, creditedAt])
}

/// 0.5.0-D. A move of the whole operation to another city. Pending until `arrivedAt`.
model Relocation {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  fromCity      String
  toCity        String
  feeCents      BigInt
  startedAt     DateTime
  arrivesAt     DateTime
  arrivedAt     DateTime?

  @@index([roundPlayerId, startedAt(sort: Desc)])
  @@index([arrivedAt, arrivesAt])
}

/// 0.5.0-C. What went wrong on a run: a police stop on a road, or a bust or arrest in a town.
enum RunIncidentKind {
  STOP
  BUST
  ARREST
}

model RunIncident {
  id        String          @id @default(cuid())
  runId     String
  run       Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      RunIncidentKind
  /// The town, for a bust or arrest; the city the road led to, for a stop.
  city      String
  /// The road, for a stop: "I-95".
  road      String?
  /// Units taken, by product.
  seized    Json
  fineCents BigInt
  at        DateTime

  @@index([runId])
}

/// 0.5.0-C. One shared high market per round, city and product. Only the push off the
/// baseline is stored: the baseline itself is the round's seeded schedule.
model HighMarket {
  id         String   @id @default(cuid())
  roundId    String
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  city       String
  productKey String
  /// Share off the baseline as of `pushAt`, wearing off from there.
  push       Float    @default(0)
  pushAt     DateTime

  @@unique([roundId, city, productKey])
}

model CitySighting {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  city          String
  seenAt        DateTime
  counter       Json

  @@unique([roundPlayerId, city])
}

/// 0.4.0-B. What one job burns: a district worked on a Scout trip, or PRODUCE. No row means
/// the default, crack only, as every older round works.
model WorkSupplyPolicy {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  /// Ruleset district key, e.g. CASINO, or PRODUCE.
  job           String
  primary       String
  fallback      String?
  emergency     String?
  /// Only the primary is ever burned.
  strict        Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@unique([roundPlayerId, job])
}

/// 0.3.0-D. A player's private rolodex entry for another player in the same round.
model PlayerContact {
  id        String      @id @default(cuid())
  ownerId   String
  owner     RoundPlayer @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    RoundPlayer @relation("ContactTarget", fields: [targetId], references: [id], onDelete: Cascade)
  note      String      @default("")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([ownerId, targetId])
  @@index([ownerId, updatedAt(sort: Desc)])
}

/// The alliance's own history: founded, joined, left, kicked, handed over, renamed, disbanded.
model AllianceEvent {
  id          String   @id @default(cuid())
  allianceId  String
  alliance    Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  type        String
  /// Names as text: history outlives membership.
  actorName   String?
  subjectName String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([allianceId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// News & activity
// ---------------------------------------------------------------------------

model GameNews {
  id String @id @default(cuid())

  /// Null = global announcement, shown in every round.
  roundId String?
  round   Round?  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  title String
  body  String

  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())

  /// When the Discord bot claimed it for the news channel. Posts from before
  /// auto-posting were backfilled so the first run doesn't flood the channel.
  discordPostedAt DateTime?

  createdByAccountId String?
  createdBy          Account? @relation("GameNewsAuthor", fields: [createdByAccountId], references: [id], onDelete: SetNull)

  /// 0.3.0-B forum announcements mirror. The discussion id is set once the forum
  /// accepted the post; forumError keeps the last failure for a retry.
  forumDiscussionId String?
  forumPostedAt     DateTime?
  forumError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([roundId, isPinned, publishedAt(sort: Desc)])
}

/// 0.3.0-B. A short site-wide notice (maintenance, downtime, round reminders)
/// shown above every page while it is live.
model SiteBanner {
  id String @id @default(cuid())

  message String
  /// info, warning or critical.
  tone    String @default("info")

  startsAt DateTime @default(now())
  endsAt   DateTime

  /// No foreign key: a banner outlives the admin who posted it.
  createdByAccountId String?
  createdByUsername  String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([startsAt, endsAt])
}

/// 0.3.0-B. An admin asked the Discord bot to re-sync roles now instead of on its
/// next scheduled pass. A null discordId means every member. The bot claims each
/// request once, like the news and alert queues.
model DiscordResyncRequest {
  id String @id @default(cuid())

  discordId String?

  /// No foreign key: the request outlives the admin who made it.
  requestedByAccountId String?
  requestedByUsername  String

  createdAt DateTime  @default(now())
  claimedAt DateTime?

  @@index([claimedAt, createdAt])
}

enum ActivityType {
  RAID_ATTACK
  RAID_DEFENSE
  DRIVE_BY_ATTACK
  DRIVE_BY_DEFENSE
  COMBAT_TREATMENT
  COMBAT_RECON
  ROUND_JOINED
  SCOUT
  WORK_STREETS
  PRODUCE_CRACK
  STORE_BUY
  STORE_SELL
  WEAPON_UNLOCK
  PAYOUT_CHANGE
  AWAY_BONUS
  HIDEOUT_UPGRADE
  QUEST_READY
  QUEST_CLAIMED
  BATTLE_VOIDED
  ADMIN_GRANT
  HEAT_BRIBE
  RUN_LAUNCHED
  RUN_RETURNED
  RUN_INCIDENT
  RELOCATION_STARTED
  RELOCATED
  CONVOY_TAIL
  /// Unused since nobody is told a tail started; kept because Postgres cannot drop an enum value.
  CONVOY_TAILED
  CONVOY_ATTACK
  CONVOY_DEFENSE
  CONVOY_BACKUP
  TURF_CLAIM
  TURF_POST
  TURF_PULL
  TURF_PUSH
  TURF_PUSH_BACKUP
  TURF_PUSH_ATTACK
  TURF_PUSH_DEFENSE
  TURF_OUTPOST_ESTABLISH
  TURF_OUTPOST_TRANSFER
}

enum BattleKind {
  RAID
  DRIVE_BY
}

/// Durable receipt and replay guard for the lifetime of both round players.
/// Raids and drive-bys share it, so reports, revenge and replay see both.
model RaidBattle {
  id                 String         @id @default(cuid())
  kind               BattleKind     @default(RAID)
  attackerId         String
  defenderId         String
  attacker           RoundPlayer    @relation("RaidAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  defender           RoundPlayer    @relation("RaidDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  actionId           String
  attackingThugs     Int
  modelVersion       String
  /// Full internal calculation, including rolls; never returned wholesale.
  calculation        Json
  attackerReport     Json
  defenderReport     Json
  injuries           CombatInjury[]
  createdAt          DateTime       @default(now())
  /// When the Discord bot claimed it for the public raid feed (older battles backfilled).
  discordPostedAt    DateTime?
  /// When the defender's attack alert was collected (older battles backfilled).
  alertsCollectedAt  DateTime?
  /// 0.3.0-B. An admin reversed this battle. Voided battles stay visible but no longer count for
  /// revenge, trophies, repeat-target limits, stats or the raid feed.
  voidedAt           DateTime?
  voidedByUsername   String?
  voidReason         String?
  /// 0.3.0-C. The defender's alliance when the hit landed. Shared revenge reads this, so
  /// the victim leaving afterwards cannot take the window away from the alliance.
  defenderAllianceId String?
  /// 0.3.0-E. The attacker's alliance when the hit landed, and whose recon they had
  /// (own, ally or none), so alliance rounds can be balanced from real battles.
  attackerAllianceId String?
  attackerIntel      String?

  @@unique([attackerId, actionId])
  @@index([attackerId, createdAt(sort: Desc), id])
  @@index([defenderId, createdAt(sort: Desc), id])
  @@index([defenderAllianceId, attackerId, createdAt])
}

model CombatInjury {
  id            String    @id @default(cuid())
  roundPlayerId String
  battleId      String?
  thugs         Int
  recoverAt     DateTime
  createdAt     DateTime  @default(now())
  treatedAt     DateTime?

  roundPlayer RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  battle      RaidBattle? @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@index([roundPlayerId, recoverAt])
  @@index([battleId])
}

model CombatIntel {
  id         String      @id @default(cuid())
  observerId String
  targetId   String
  observer   RoundPlayer @relation("IntelObserver", fields: [observerId], references: [id], onDelete: Cascade)
  target     RoundPlayer @relation("IntelTarget", fields: [targetId], references: [id], onDelete: Cascade)
  report     Json
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([observerId, targetId])
  @@index([observerId, expiresAt])
  @@index([targetId])
}

model PlayerActivity {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  type    ActivityType
  payload Json

  createdAt DateTime @default(now())

  @@index([roundPlayerId, createdAt(sort: Desc)])
}

/// 0.7.0-E. Durable economic lines for the Back Office ledger.
/// Positive amounts are income; negative amounts are expenses. Internal transfers
/// (for example cash loaded into a run) are intentionally not recorded here.
model EconomyLedgerEntry {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  source      String
  label       String
  amountCents BigInt
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([roundPlayerId, createdAt(sort: Desc)])
}


// ---------------------------------------------------------------------------
// Turf (0.6.0-A)
// ---------------------------------------------------------------------------

/// One district in one city: forty blocks a round with all eight cities enabled. A row is
/// created for every block when the round first reads its turf, held by the locals.
///
/// A null `holderId` means no player holds it. Before `localsReclaimAt` it is vacant;
/// afterwards the locals have it. `localsThugs` grows back from `localsAt` on the
/// ruleset's clock, exactly like Pip's shelves: nothing sweeps this table.
model Turf {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Ruleset district key, e.g. CASINO.
  district String

  /// The crew standing on it, or null for the locals.
  holderId    String?
  holder      RoundPlayer? @relation("TurfHolder", fields: [holderId], references: [id], onDelete: SetNull)
  /// The holder's posted thugs on this corner. Part of the holder's `postedThugs`.
  cornerThugs    Int @default(0)
  /// Their guns have physically left the holder's home arsenal while posted.
  cornerPistols  Int @default(0)
  cornerShotguns Int @default(0)
  cornerTek9s    Int @default(0)
  cornerAk47s    Int @default(0)
  heldSince      DateTime?
  /// 0.6.0-C. Taken blocks cannot be taken again until this passes.
  shieldUntil DateTime?

  /// What the locals hold it with, and when that was last worked out.
  localsThugs Int
  localsAt    DateTime @default(now())
  /// 0.6.0-C. A released block stays vacant until this time, then the locals return.
  /// Null means the locals are already on a holderless block, or a player currently holds it.
  localsReclaimAt DateTime?

  /// 0.6.0-B. Last corner-upkeep boundary settled.
  upkeepAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pushes TurfPush[]
  outpost TurfOutpost?
  holdSegments TurfHoldSegment[]

  @@unique([roundId, cityId, district])
  @@index([roundId, holderId])
}

/// 0.6.0-D. The box attached to one away-held block. A home block never needs one.
/// Runs are the only intended way to move stock in or out; later D slices enforce that.
model TurfOutpost {
  id String @id @default(cuid())

  turfId String @unique
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  ownerId String
  owner   RoundPlayer @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  cashCents BigInt @default(0)
  beer      Int    @default(0)
  /// Product-key -> quantity. Crack is stored here too because this is not home inventory.
  products  Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// 0.6.0-A. Turns a crew has worked on a block lately. You cannot claim a block you have
/// never worked, and presence fades on the ruleset's half-life, settled from `at` on read.
model TurfPresence {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Ruleset district key, e.g. CASINO.
  district String

  /// Turns worked, as of `at`. Faded on read, never by a sweep.
  turns Float    @default(0)
  at    DateTime @default(now())

  @@unique([roundPlayerId, cityId, district])
}


/// 0.6.0-C. A player-vs-player attempt to take one block. The attacking squad
/// is committed at start and the fight lands after the warning window.
enum TurfPushStatus {
  PENDING
  LANDED
}

model TurfPush {
  id String @id @default(cuid())

  roundId String
  round   Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  turfId String
  turf   Turf @relation(fields: [turfId], references: [id], onDelete: Cascade)

  attackerId String
  attacker   RoundPlayer @relation("TurfPushAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  /// Alliance snapshots make shared revenge stable if either player later leaves.
  attackerAllianceId String?

  /// Holder when the push started. The block may be abandoned before it lands.
  defenderId String
  defender   RoundPlayer @relation("TurfPushDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  defenderAllianceId String?

  squad        Int
  /// Morale and the exact guns committed from home.
  attackerCrew Json
  turnsSpent   Int
  actionId     String
  startedAt    DateTime
  landsAt      DateTime
  status       TurfPushStatus @default(PENDING)
  settledAt    DateTime?
  /// True only when this push actually transferred the block to the attacker.
  captured     Boolean @default(false)
  result       Json?
  attackerCreditedAt DateTime?
  alliesCalledAt DateTime?
  /// Public turf-feed claim, parallel to RaidBattle.discordPostedAt.
  discordPostedAt DateTime?
  /// Private notification collection is independent from the public feed.
  alertsCollectedAt DateTime?
  backups      TurfPushBackup[]

  @@unique([attackerId, actionId])
  @@index([turfId, status])
  @@index([roundId, status, landsAt])
  @@index([roundId, captured, settledAt(sort: Desc)])
  @@index([alertsCollectedAt, settledAt])
  @@index([attackerId, turfId, startedAt(sort: Desc)])
  @@index([attackerId, captured, settledAt(sort: Desc)])
  @@index([defenderAllianceId, attackerId, captured, settledAt(sort: Desc)])
  @@index([attackerId, attackerCreditedAt])
}

/// Real home/alliance help committed to a pending turf push. C landing decides
/// whether an ally's uncertain reinforcement actually arrives.
model TurfPushBackup {
  id String @id @default(cuid())

  pushId String
  push   TurfPush @relation(fields: [pushId], references: [id], onDelete: Cascade)

  playerId String
  player   RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// OWNER or ALLY.
  kind    String
  thugs   Int
  crew    Json
  sentAt  DateTime
  showedUp Boolean?
  wounded Int @default(0)
  creditedAt DateTime?

  @@unique([pushId, playerId])
  @@index([playerId, creditedAt])
}

/// 0.6.0-E. One continuous stretch where a crew held a block with one alliance
/// identity. Alliance membership changes split the segment so old hours never move
/// retroactively to a new alliance.
model TurfHoldSegment {
  id String @id @default(cuid())

  roundId String
  round   Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  turfId String
  turf   Turf @relation(fields: [turfId], references: [id], onDelete: Cascade)

  holderId String
  holder   RoundPlayer @relation(fields: [holderId], references: [id], onDelete: Cascade)

  holderPublicPimpId Int
  holderName         String

  /// Snapshot only. We deliberately do not FK this because disband/rename history must survive.
  allianceId   String?
  allianceName String?
  allianceTag  String?

  startedAt DateTime
  endedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([roundId, holderId, startedAt])
  @@index([roundId, allianceId, startedAt])
  @@index([turfId, endedAt])
}

/// 0.6.0-E. One durable alliance city-control change. Snapshot names/tags keep
/// history readable if an alliance later renames or disbands.
model TurfControlEvent {
  id String @id @default(cuid())

  roundId String
  round   Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  cityId String
  city   City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  previousAllianceId   String?
  previousAllianceName String?
  previousAllianceTag  String?
  nextAllianceId       String?
  nextAllianceName     String?
  nextAllianceTag      String?

  previousBlocksHeld Int @default(0)
  nextBlocksHeld     Int @default(0)
  blocksTotal        Int

  happenedAt        DateTime
  discordPostedAt   DateTime?
  alertsCollectedAt DateTime?

  @@index([roundId, happenedAt(sort: Desc)])
  @@index([discordPostedAt, happenedAt])
  @@index([alertsCollectedAt, happenedAt])
}

/// 0.6.0-F. One seeded late-round Federal sweep. The target and clock are fixed per
/// round, so the warning and the sweep can be replayed/idempotently claimed by Discord.
model TurfCrackdown {
  id String @id @default(cuid())

  roundId String @unique
  round   Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  cityId String
  city   City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  warningAt DateTime
  sweepAt   DateTime
  sweptAt   DateTime?

  holdersAffected Int @default(0)
  thugsPickedUp   Int @default(0)
  /// Per-holder result snapshots for receipts/feed summaries.
  results Json @default("[]")

  warningDiscordPostedAt DateTime?
  sweepDiscordPostedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warningAt])
  @@index([sweepAt, sweptAt])
  @@index([warningDiscordPostedAt, warningAt])
  @@index([sweepDiscordPostedAt, sweepAt])
}

/// 0.6.0-B. The daily turf-tax cap is per payer and holder. The worker's burn is not
/// stored here; only the minted holder share needs a cap and a dashboard/history read.
model TurfTaxLedger {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  payerId String
  payer   RoundPlayer @relation("TurfTaxPayer", fields: [payerId], references: [id], onDelete: Cascade)

  holderId String
  holder   RoundPlayer @relation("TurfTaxHolder", fields: [holderId], references: [id], onDelete: Cascade)

  /// UTC calendar day, stored at midnight.
  day DateTime

  mintedCents   BigInt @default(0)
  /// House-minted tax already credited to the holder's home cash or, in 0.6.0-D, an outpost box.
  creditedCents BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, payerId, holderId, day])
  @@index([roundId, holderId, day])
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

/// Short-lived record of a completed resource-changing action. A repeated
/// actionId replays the stored result instead of executing twice.
model ProcessedAction {
  id String @id @default(cuid())

  /// Client generated. Scoped to the player, so one player's action id can
  /// never collide with or block another's.
  actionId String

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  action String
  result Json

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([roundPlayerId, actionId])
  @@index([expiresAt])
}
