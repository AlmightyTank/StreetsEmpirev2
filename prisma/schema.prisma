// StreetsEmpire - 0.1.0 "Classic Foundation"
// Ruleset: classic-og-v0.1
//
// Money is stored as INTEGER CENTS (BigInt). $1.00 = 100. Never floats.
// Anything not player-facing in 0.1.0 (PvP, alliances, travel) is deliberately
// absent, but the shapes below are chosen so 0.2.0 does not need a redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & sessions
// ---------------------------------------------------------------------------

/// A permanent player identity. Survives every round.
model Account {
  id                          String    @id @default(cuid())
  username                    String
  /// Lowercased username. Enforces case-insensitive uniqueness.
  usernameNormalized          String    @unique
  /// Lowercased email. Private account recovery and login address.
  email                       String    @unique
  emailVerifiedAt             DateTime?
  /// Set for every account that existed before email verification was required: they may
  /// keep playing without verifying. Accounts created later are never grandfathered.
  verificationGrandfatheredAt DateTime?
  /// When the player accepted the game rules, and which version of them.
  rulesAcceptedAt             DateTime?
  rulesAcceptedVersion        String?
  /// rc.2. When the player closed their own account (isActive false). Null for staff deactivations.
  closedAt                    DateTime?
  /// rc.2. The address the account signed up from, for the per-address daily sign-up cap.
  registeredIp                String?
  /// rc.5. When the player confirmed at sign-up that they are 13 or older. The rules
  /// agreement asks every player too (Discord sign-ups included).
  ageConfirmedAt              DateTime?
  /// rc.3. Authenticator-app two-step sign-in. Secrets are AES-GCM sealed (auth/totp.ts).
  twoFactorSecret             String?
  /// Set while the player is scanning the QR code, before they confirm a first code.
  twoFactorPendingSecret      String?
  twoFactorEnabledAt          DateTime?
  /// The last code step used, so a code cannot be used twice.
  twoFactorLastStep           Int?
  passwordHash                String

  discordId       String?   @unique
  discordUsername String?
  discordAvatar   String?
  discordLinkedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  isActive     Boolean @default(true)
  isAdmin      Boolean @default(false)
  betaApproved Boolean @default(false)

  /// 0.3.0-B. A timed suspension. The account signs back in on its own once this
  /// passes; the fields are cleared lazily on the next sign-in attempt.
  suspendedUntil      DateTime?
  suspendedReason     String?
  suspendedByUsername String?
  /// 1.0.0-E. A ban: the account is shut down (isActive false) for this recorded reason.
  bannedAt            DateTime?
  bannedReason        String?
  bannedByUsername    String?

  /// 0.9.0-H. Communication restriction: no private messages or wire posts while it
  /// runs. The account still plays. Permanent wins over a date; both cleared by unmute.
  commsMutedUntil      DateTime?
  commsMutedPermanent  Boolean   @default(false)
  commsMuteReason      String?
  commsMutedByUsername String?

  sessions               Session[]
  bugReports             BugReport[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  trustedDevices         TrustedDevice[]
  knownDevices           AccountDevice[]
  loginChallenges        LoginChallenge[]
  passwordResetTokens    PasswordResetToken[]
  accountEmailTokens     AccountEmailToken[]
  forumLink              ForumLink?
  forumLinkRequest       ForumLinkRequest?
  notificationSettings   NotificationSettings?
  notificationOutbox     NotificationOutbox[]
  pushSubscriptions      PushSubscription[]
  profile                AccountProfile?
  cosmeticUnlocks        AccountCosmeticUnlock[]
  roundPlayers           RoundPlayer[]
  authoredNews           GameNews[]              @relation("GameNewsAuthor")
  adminAuditEntries      AdminAuditLog[]         @relation("AdminAuditActor")
  messageBlocksMade      PlayerBlock[]           @relation("PlayerBlocker")
  messageBlocksReceived  PlayerBlock[]           @relation("PlayerBlocked")
  messageReports         PlayerMessageReport[]
  /// 0.9.0-H.
  mutesMade              PlayerMute[]            @relation("PlayerMuter")
  mutesReceived          PlayerMute[]            @relation("PlayerMuted")
  moderationNotes        AccountModerationNote[]
  surveySubmissions      SurveySubmission[]
  experienceEvents       PlayerExperienceEvent[]
  experiencePoints       Int                     @default(0)

  @@index([registeredIp, createdAt])
}

/// Permanent account progress, separate from season resources and Street Pass Cred.
model PlayerExperienceEvent {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  sourceKey String
  source    String
  amount    Int
  awardedAt DateTime @default(now())

  @@unique([accountId, sourceKey])
  @@index([accountId, awardedAt(sort: Desc)])
}

/// 0.9.0-H. Private admin notes on an account. Never shown to the player.
model AccountModerationNote {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  authorAccountId String?
  authorUsername  String
  body            String

  createdAt DateTime @default(now())

  @@index([accountId, createdAt(sort: Desc)])
}

/// 0.3.0-B. One row per admin action: who, what, when, and the target before
/// and after. The app only ever inserts these.
/// 1.0.0-A. Which environment owns this database. A production server refuses a
/// database claimed by beta and the reverse, so a wrong DATABASE_URL fails loudly
/// at boot instead of mixing live and test data. One row, id "singleton".
model DeploymentIdentity {
  id              String   @id @default("singleton")
  environment     String
  claimedAt       DateTime @default(now())
  lastBootAt      DateTime @default(now())
  lastBootVersion String
}

model AdminAuditLog {
  id String @id @default(cuid())

  /// Null once the acting account is deleted; actorUsername keeps the name.
  actorAccountId String?
  actor          Account? @relation("AdminAuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorUsername  String

  /// Dotted verb, e.g. round.schedule or round.end-early.
  action     String
  targetType String
  targetId   String?
  reason     String?

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

/// Cosmetic and preference settings. Pure prestige: never affects round starts,
/// action math, stores, ranks or combat.
model AccountProfile {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  activeTitleKey        String?
  titlePlacement        String  @default("prefix")
  /// 0.9.0-F. Optional public crew name, account-level so it carries across seasons.
  crewName              String?
  profileBio            String?
  profileImageUrl       String?
  profileBannerUrl      String?
  profileEffect         String  @default("none")
  activeProfileFrameKey String?
  activeAvatarFrameKey  String?
  activeSiteThemeKey    String?
  /// Player-selected visual skin per inventory item key. Cosmetic only.
  itemCosmetics         Json    @default("{}")
  /// THUG / HOE visual styles. Crew is aggregate inventory, so the style applies to the whole type.
  crewCosmetics         Json    @default("{}")
  /// Slice E. Visitors see the owner's site theme on their public profile.
  showThemeOnProfile    Boolean @default(true)
  /// Slice E. Visitors see the owner's item and crew look on their public profile.
  showLookOnProfile     Boolean @default(true)
  featuredBadgeKeys     Json    @default("[]")
  profileAccent         String  @default("default")
  uiDensity             String  @default("comfortable")
  reducedMotion         Boolean @default(false)
  moneyFormat           String  @default("full")
  defaultLanding        String  @default("game")
  /// Start daily, weekly and city board work as soon as it appears.
  autoAcceptBoardWork   Boolean @default(true)
  /// 1.0.0-B. Tutorial progress: intro completed/skipped, page intros seen, guide
  /// dismissed for a season. Never gameplay state; see OnboardingService.
  onboarding            Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Permanent account cosmetics. Display metadata is snapshotted when earned so
/// titles and badges survive ruleset changes and round resets.
model AccountCosmeticUnlock {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  key         String
  kind        String
  title       String
  description String
  rarity      String
  styleKey    String?

  /// Quest key or another permanent account reward source.
  sourceQuestKey       String
  sourceRulesetId      String
  sourceRulesetVersion String
  awardedAt            DateTime @default(now())

  @@unique([accountId, key])
  @@index([accountId, awardedAt])
  @@index([key])
}

/// Verified public profile connection; owned by the permanent account.
model ForumLink {
  accountId     String   @id
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  forumOrigin   String
  forumUserId   String
  forumUsername String
  createdAt     DateTime @default(now())

  @@unique([forumOrigin, forumUserId])
}

/// Only the latest request in the initiating game session can be completed.
model ForumLinkRequest {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nonceHash String   @unique
  sessionId String
  expiresAt DateTime
}

/// Opt-in alerts for one account: which categories, and which channels deliver them.
/// turnsArmed: turns were below the cap at the last check, so reaching it sends one reminder.
/// rankRoundId/rankLastNational: the national rank last seen, to notice losing #1 or the top 10.
model NotificationSettings {
  accountId             String    @id
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  turnsEnabled          Boolean   @default(false)
  turnsArmed            Boolean   @default(false)
  turnsLastSentAt       DateTime?
  attacksEnabled        Boolean   @default(false)
  roundEnabled          Boolean   @default(false)
  rankEnabled           Boolean   @default(false)
  turfEnabled           Boolean   @default(false)
  turfEnabledAt         DateTime?
  allianceEnabled       Boolean   @default(false)
  allianceEnabledAt     DateTime?
  rankRoundId           String?
  rankLastNational      Int?
  /// Discord DMs; only delivered while Discord is linked.
  discordEnabled        Boolean   @default(true)
  /// Web Push to every registered device.
  pushEnabled           Boolean   @default(false)
  /// 0.9.0-G categories. Like the ones above they switch outside alerts (Discord, push);
  /// the in-game bell is controlled separately by `bellMuted`.
  turfPushEnabled       Boolean   @default(false)
  reinforcementsEnabled Boolean   @default(false)
  convoyEnabled         Boolean   @default(false)
  runsEnabled           Boolean   @default(false)
  revengeEnabled        Boolean   @default(false)
  ordersEnabled         Boolean   @default(false)
  announcementsEnabled  Boolean   @default(false)
  messagesEnabled       Boolean   @default(false)
  /// 1.3.0-B. A Case rising to a new Wanted stage. On by default: the ladder promises a warning.
  lawEnabled            Boolean   @default(true)
  /// 1.4.0-D. Early warnings from a faction the player is Trusted with. The bell always has them.
  factionsEnabled       Boolean   @default(false)
  /// 0.9.0-G master switch: pauses every outside alert without losing category choices.
  alertsPaused          Boolean   @default(false)
  /// 0.9.0-G quiet hours, minutes after local midnight in `timeZone`. Both set or neither;
  /// a window may wrap past midnight. The bell still records everything.
  quietStartMinute      Int?
  quietEndMinute        Int?
  timeZone              String?
  /// 0.9.0-G categories hidden from the in-game bell (their events stay in Activity).
  bellMuted             Json      @default("[]")
  updatedAt             DateTime  @updatedAt

  @@index([turnsEnabled])
}

enum NotificationChannel {
  DISCORD
  PUSH
}

/// One alert waiting for one channel. The server works out what is due once and
/// writes a row per channel; each channel claims its own rows, so none steals another's.
model NotificationOutbox {
  id        String              @id @default(cuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  /// attacks | turns | round | rank | turf | alliance
  category  String
  /// The alert itself, without any channel address (see @streets/shared NotificationPayload).
  payload   Json
  /// e.g. battle:<id>:<account>:PUSH, so a repeated collection never duplicates an alert.
  dedupeKey String              @unique
  createdAt DateTime            @default(now())
  claimedAt DateTime?

  @@index([channel, claimedAt, createdAt])
  @@index([createdAt])
}

/// A browser or phone that accepts Web Push for an account.
model PushSubscription {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  deviceLabel   String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([accountId])
}

enum AccountEmailTokenPurpose {
  VERIFY_EMAIL
  CHANGE_EMAIL
}

model AccountEmailToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  purpose  AccountEmailTokenPurpose
  newEmail String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

/// Server-side session record. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a database leak cannot be replayed as a login.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  userAgent         String?
  ip                String?
  /// rc.2. How the session signed in: PASSWORD or DISCORD. Admin tools can require DISCORD.
  method            String    @default("PASSWORD")
  /// rc.3. True when this sign-in passed an authenticator (or recovery) code.
  twoFactor         Boolean   @default(false)
  /// rc.4. "Keep me signed in": a long session that renews while used. False: ends with the
  /// browser, or after a short idle time.
  remember          Boolean   @default(true)
  /// rc.4. Hard end, however active the session is. Null on sessions from before rc.4
  /// (then createdAt plus the maximum).
  absoluteExpiresAt DateTime?
  /// rc.4. When this session last proved a second factor (Discord sign-in or a code).
  /// Admin tools need it to be recent.
  secondFactorAt    DateTime?
  /// rc.4. Wrong codes entered while signed in; too many signs the session out.
  codeFailures      Int       @default(0)

  @@index([accountId])
  @@index([expiresAt])
}

/// rc.3. One-use codes for signing in when the authenticator phone is lost. Only hashes are kept.
model TwoFactorRecoveryCode {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

/// rc.4. A browser that passed two-step sign-in with "Trust this browser" ticked: sign-ins
/// from it skip the code until it expires or is forgotten. The cookie holds the token;
/// only its hash is stored.
model TrustedDevice {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([accountId])
  @@index([expiresAt])
}

/// rc.5. Browsers this account has signed in from, so a sign-in from a new one can be
/// emailed about. Keyed by a hash of a long-lived per-browser cookie.
model AccountDevice {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  deviceHash  String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([accountId, deviceHash])
}

/// rc.3. A sign-in that passed the password (or Discord) and now waits for the authenticator code.
model LoginChallenge {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// PASSWORD or DISCORD: what the session will record once the code is right.
  method    String
  /// rc.4. The "Keep me signed in" choice, carried to the session the code makes.
  remember  Boolean  @default(true)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

/// rc.2. A bug a player reported from the game. Staff read and resolve these in Admin → Bug reports.
model BugReport {
  id String @id @default(cuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Kept so the report still says who sent it after the account is gone.
  username  String

  /// GAMEPLAY, DISPLAY, ACCOUNT, PERFORMANCE or OTHER.
  category   String
  summary    String
  details    String
  pagePath   String?
  userAgent  String?
  appVersion String?

  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  resolvedByUsername String?
  /// FIXED, WONT_FIX or DUPLICATE.
  resolution         String?
  /// Staff only: why it was resolved, kept in the queue and the audit log.
  resolutionNote     String?

  /// GAME (the report form) or DISCORD (/bug).
  source             String    @default("GAME")
  /// Optional words for the reporter, sent with the "your report was resolved" notice.
  playerReply        String?
  /// When that notice was collected; set at once for reports resolved before notices existed.
  reporterNotifiedAt DateTime?

  @@index([resolvedAt, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
}

/// What the Discord bot posts to the staff channel: a new bug report, its
/// resolution (an edit of the first post), held patch notes. Claimed once, like news.
model DiscordStaffPost {
  id        String    @id @default(cuid())
  /// BUG_REPORT, BUG_REPORT_RESOLVED or PATCH_NOTES_HELD.
  kind      String
  /// The bug report or news post it is about; read fresh when the bot claims it.
  targetId  String
  createdAt DateTime  @default(now())
  claimedAt DateTime?
  /// The staff channel message, so a later post about the same target can edit it.
  messageId String?
  /// Why Discord refused it, as the bot reported it.
  error     String?

  @@index([claimedAt, createdAt])
  @@index([kind, targetId])
}

// ---------------------------------------------------------------------------
// Player surveys
// ---------------------------------------------------------------------------

/// Admin-authored feedback request. Surveys are account-scoped for completion
/// so one account can never earn the same survey reward twice, even if round
/// player state changes.
model Survey {
  id String @id @default(cuid())

  title       String
  description String
  status      SurveyStatus @default(DRAFT)

  /// Optional release/change labels such as 1.1.0-F, Stores, Combat or Mobile UI.
  releaseTag String?
  featureTag String?

  /// Null means the survey is not limited to one round.
  roundId String?
  round   Round?  @relation(fields: [roundId], references: [id], onDelete: SetNull)

  /// Reward definitions use the same shape as quest/pass rewards. Phase B/C
  /// validates and grants them; Phase A only stores the authored snapshot.
  rewards Json @default("[]")

  startsAt    DateTime?
  endsAt      DateTime?
  publishedAt DateTime?
  closedAt    DateTime?
  /// Set when the alert collector has fanned this live survey out to players.
  announcedAt DateTime?

  /// Keep the author name even if that admin account is later removed.
  createdByUsername String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions   SurveyQuestion[]
  submissions SurveySubmission[]

  @@index([status, startsAt, endsAt])
  @@index([status, announcedAt])
  @@index([roundId, status])
  @@index([releaseTag])
  @@index([featureTag])
}

/// One ordered question in a survey. Published survey structure will be treated
/// as immutable by the admin service so historical answers keep their meaning.
model SurveyQuestion {
  id String @id @default(cuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  type        SurveyQuestionType
  prompt      String
  description String?
  required    Boolean            @default(true)
  position    Int

  /// Text questions may use these; null means the service default.
  minLength Int?
  maxLength Int?

  /// Rating questions may use these; the first release supports 1..10.
  ratingMin Int?
  ratingMax Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options SurveyOption[]
  answers SurveyAnswer[]

  @@unique([surveyId, position])
  @@index([surveyId, type])
}

/// Ordered choice for SINGLE_CHOICE or MULTIPLE_CHOICE questions.
model SurveyOption {
  id String @id @default(cuid())

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Stable machine value stored in answers; label is player-facing copy.
  value    String
  label    String
  position Int

  @@unique([questionId, value])
  @@unique([questionId, position])
}

/// A completed survey. The unique account key is the duplicate-reward barrier.
/// roundPlayerId records which round player received a round-scoped reward.
model SurveySubmission {
  id String @id @default(cuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  roundPlayerId String?
  roundPlayer   RoundPlayer? @relation(fields: [roundPlayerId], references: [id], onDelete: SetNull)

  submittedAt DateTime @default(now())

  /// Exact reward definition snapshot used for this completion.
  rewardSnapshot  Json      @default("[]")
  rewardGrantedAt DateTime?

  answers SurveyAnswer[]

  @@unique([surveyId, accountId])
  @@index([surveyId, submittedAt(sort: Desc)])
  @@index([accountId, submittedAt(sort: Desc)])
  @@index([roundPlayerId])
}

/// One answer per question in one completed submission. JSON supports booleans,
/// option values, option arrays, ratings and text without lossy coercion.
model SurveyAnswer {
  id String @id @default(cuid())

  submissionId String
  submission   SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  value Json

  createdAt DateTime @default(now())

  @@unique([submissionId, questionId])
  @@index([questionId, createdAt])
}

// ---------------------------------------------------------------------------
// Rounds
// ---------------------------------------------------------------------------

enum RoundStatus {
  SCHEDULED
  REGISTRATION
  ACTIVE
  ENDED
  ARCHIVED
}

enum QuestStatus {
  LOCKED
  AVAILABLE
  ACTIVE
  READY_TO_TURN_IN
  COMPLETED
  FAILED
  EXPIRED
}

enum QuestRepeatability {
  ONCE
  DAILY
  WEEKLY
  REPEATABLE
}

enum SurveyStatus {
  DRAFT
  SCHEDULED
  LIVE
  CLOSED
}

enum SurveyQuestionType {
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  SHORT_TEXT
  LONG_TEXT
}

/// Relationship standing for one player. Historically this held store-trader
/// standing only; the unified Jobs system also stores named contact reputation
/// here so old rounds and current contacts can coexist without copying scores.
model PlayerReputation {
  id            String @id @default(cuid())
  roundPlayerId String
  /// Relationship key. Historical store keys include CORNER/TOMMY/CHARLIE/PIP;
  /// current job contacts may also use MAMA_KING/WHEELS/VIC/BLOCKS.
  trader        String

  points      Int       @default(0)
  /// Day the regular-trade credit was last paid, so it can be paid at most
  /// once a day without keeping a history of every trade.
  creditedOn  DateTime?
  /// Legacy one-favor completion marker. Current Jobs use PlayerQuest instead.
  questDoneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roundPlayer RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  @@unique([roundPlayerId, trader])
  @@index([roundPlayerId])
}

// ---------------------------------------------------------------------------
// Consumable favor inventory
// ---------------------------------------------------------------------------

model PlayerFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// Stable ruleset-defined favor key.
  key                String
  quantity           Int     @default(0)
  totalGranted       Int     @default(0)
  /// Most recent job that added this favor to the stack.
  lastSourceQuestKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, key])
  @@index([roundPlayerId, updatedAt])
  @@index([key])
}

// ---------------------------------------------------------------------------
// Admin favor content controls
// ---------------------------------------------------------------------------

/// Per-ruleset emergency switch for favor effects. Missing rows mean enabled,
/// so pinned rulesets keep their original behavior until an admin intervenes.
model FavorContentSetting {
  id String @id @default(cuid())

  rulesetId      String
  rulesetVersion String
  key            String
  isEnabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rulesetId, rulesetVersion, key])
  @@index([rulesetId, rulesetVersion, isEnabled])
}

// ---------------------------------------------------------------------------
// Active timed favors
// ---------------------------------------------------------------------------

model PlayerActiveFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// STREET, UNDERWORLD or MUSCLE. Only one live timed favor per category.
  category  String
  favorKey  String
  startedAt DateTime
  expiresAt DateTime

  @@unique([roundPlayerId, category])
  @@index([roundPlayerId, expiresAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Armed single-use favors
// ---------------------------------------------------------------------------

model PlayerArmedFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  category String
  favorKey String
  armedAt  DateTime @default(now())

  @@unique([roundPlayerId, category])
  @@index([roundPlayerId, favorKey])
}

// ---------------------------------------------------------------------------
// Street Pass (docs/STREET-PASS.md)
// ---------------------------------------------------------------------------

/// A player's Street Cred for the round's pass. Created on the first Cred earned.
model StreetPassProgress {
  id String @id @default(cuid())

  roundPlayerId String      @unique
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// The ruleset's streetPass.key, e.g. street-pass-s1.
  passKey                String
  /// Cred earned, late-join bonus included.
  cred                   Int       @default(0)
  /// Fixed when the row is created, from how long the round had run when the player joined.
  lateJoinBonusPercent   Int       @default(0)
  /// Start of the daily window the turn Cred cap is counting, and the base turn Cred counted in it.
  turnCredWindowStartsAt DateTime?
  turnCredInWindow       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One claimed tier. The unique key is what stops a tier paying twice.
model StreetPassClaim {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  passKey   String
  tier      Int
  /// True when round close granted an unclaimed permanent cosmetic tier.
  automatic Boolean  @default(false)
  claimedAt DateTime @default(now())

  @@unique([roundPlayerId, passKey, tier])
}

// ---------------------------------------------------------------------------
// Permanent per-round unlocks
// ---------------------------------------------------------------------------

model PlayerUnlock {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// Stable ruleset-defined key, e.g. PRODUCT_METH_ACCESS.
  key            String
  /// Quest that granted it, when the unlock came from a job reward.
  sourceQuestKey String?
  awardedAt      DateTime @default(now())

  @@unique([roundPlayerId, key])
  @@index([roundPlayerId, awardedAt])
  @@index([key])
}

// ---------------------------------------------------------------------------
// Handcrafted quests
// ---------------------------------------------------------------------------

/// Version-pinned quest content. Definitions are separate from PlayerQuest so
/// one ruleset can publish a catalog once and every seasonal RoundPlayer can
/// progress through it independently.
model QuestDefinition {
  id String @id @default(cuid())

  /// Stable key inside one ruleset version, e.g. FIRST_NIGHT_OUT.
  key            String
  rulesetId      String
  rulesetVersion String

  title       String
  description String
  /// Future contact/NPC key. Null permits system/event quests.
  contactKey  String?
  /// STORY, SIDE, CONTRACT, DAILY, WEEKLY, SECRET, ALLIANCE, CITY_CONTRACT or EVENT.
  type        String
  /// Free-form gameplay grouping such as STREET, COMBAT, TRAVEL or TURF.
  category    String
  /// STREET_JOB, CONTRACT, SERIOUS_BUSINESS, HIGH_RISK or KINGPIN_CONTRACT.
  difficulty  String

  /// JSON keeps the foundation extensible while Phase B supplies typed
  /// objective/prerequisite/reward kinds in the ruleset package.
  prerequisites   Json @default("[]")
  objectives      Json
  bonusObjectives Json @default("[]")
  rewards         Json
  followUpKeys    Json @default("[]")
  availability    Json @default("{}")

  repeatability       QuestRepeatability @default(ONCE)
  expiresAfterMinutes Int?
  isEnabled           Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerQuests PlayerQuest[]

  @@unique([rulesetId, rulesetVersion, key])
  @@index([rulesetId, rulesetVersion, isEnabled])
  @@index([contactKey, isEnabled])
}

/// One player's attempt at one quest. The attempt number prevents
/// daily/weekly/repeatable contracts from requiring a second schema later,
/// while ONCE quests naturally stay on attempt 1.
model PlayerQuest {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  questDefinitionId String
  questDefinition   QuestDefinition        @relation(fields: [questDefinitionId], references: [id], onDelete: Restrict)
  progressReceipts  QuestProgressReceipt[]

  attempt   Int         @default(1)
  status    QuestStatus @default(AVAILABLE)
  isTracked Boolean     @default(false)

  objectiveProgress Json    @default("{}")
  bonusProgress     Json    @default("{}")
  chosenBranch      String?
  rewardState       Json    @default("{}")

  acceptedAt  DateTime?
  completedAt DateTime?
  claimedAt   DateTime?
  failedAt    DateTime?
  expiresAt   DateTime?
  /// Set when the player abandons this attempt, so auto-accept leaves it alone.
  abandonedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, questDefinitionId, attempt])
  @@index([roundPlayerId, status])
  @@index([questDefinitionId, status])
  @@index([status, expiresAt])
}

/// Idempotency/audit receipt for one source event applied to one quest attempt.
/// The source key is usually activity:<PlayerActivity.id>; explicit emitters may
/// use another stable domain key.
model QuestProgressReceipt {
  id String @id @default(cuid())

  playerQuestId String
  playerQuest   PlayerQuest @relation(fields: [playerQuestId], references: [id], onDelete: Cascade)

  sourceKey String
  eventType String
  /// Objective deltas actually credited by this event.
  applied   Json   @default("{}")

  createdAt DateTime @default(now())

  @@unique([playerQuestId, sourceKey])
  @@index([playerQuestId, createdAt])
  @@index([sourceKey])
}

model Round {
  id   String @id @default(cuid())
  name String
  slug String @unique

  rulesetId          String
  rulesetVersion     String
  /// Per-round Street Pass reward edits, frozen when registration opens.
  streetPassOverride Json?

  status RoundStatus @default(SCHEDULED)

  startsAt DateTime
  endsAt   DateTime

  /// 1.0.0-E. A paused round refuses player actions; timers already running still land.
  pausedAt           DateTime?
  pauseReason        String?
  pausedByUsername   String?
  /// Minutes of completed pauses, for the record and for extending the end on resume.
  pausedMinutesTotal Int       @default(0)

  registrationOpensAt DateTime?

  /// Round alerts collected for players, each once. Rounds that already opened
  /// or ended before these existed were backfilled.
  alertsOpenedAt     DateTime?
  alertsEndingSoonAt DateTime?
  alertsEndedAt      DateTime?
  /// When the Discord bot claimed the public round-end post.
  discordEndedAt     DateTime?

  /// Next OG-style public pimp id to hand out. Raw database ids are never
  /// exposed; players see e.g. BigDaddy (#1842).
  nextPublicPimpId Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players              RoundPlayer[]
  news                 GameNews[]
  alliances            Alliance[]
  highMarkets          HighMarket[]
  turf                 Turf[]
  turfTax              TurfTaxLedger[]
  turfPushes           TurfPush[]
  turfControlEvents    TurfControlEvent[]
  turfHoldSegments     TurfHoldSegment[]
  turfCrackdown        TurfCrackdown?
  directMessages       DirectMessage[]
  businesses           Business[]
  blockWars            BlockWar[]
  surveys              Survey[]
  casinoJackpots       CasinoJackpot[]
  casinoPokerTables    CasinoPokerTable[]
  supplySupplierStocks SupplySupplierStock[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Cities
// ---------------------------------------------------------------------------

/// Travel does not exist in 0.1.0, but every player has a home city from day
/// one and the modifiers are already wired into the ruleset math.
model City {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  isEnabled Boolean @default(false)

  // 0.5.0-A: a city's character (prices, supply, police, Heat levels, roads and the
  // old scout/income/crack modifiers) lives in the round's pinned ruleset.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players           RoundPlayer[]
  turf              Turf[]
  turfPresence      TurfPresence[]
  turfControlEvents TurfControlEvent[]
  turfCrackdowns    TurfCrackdown[]
  casinoWallets     CasinoWallet[]
  casinoSessions    CasinoSession[]
  casinoLedger      CasinoLedgerEntry[]
  casinoRatings     CasinoRating[]
  playerCases       PlayerCase[]
  caseReceipts      PlayerCaseReceipt[]
  warrants          PlayerWarrant[]
  officials         PlayerOfficial[]
  tips              PlayerTip[]
  npcGangs          NpcGang[]           @relation("NpcGangHomeCity")
}

// ---------------------------------------------------------------------------
// Round players
// ---------------------------------------------------------------------------

model RoundPlayer {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Player-visible OG id, unique inside the round.
  publicPimpId Int

  displayName String

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Integer cents.
  cashCents BigInt @default(0)

  turns                 Int       @default(0)
  lastTurnCalculationAt DateTime  @default(now())
  lastActiveAt          DateTime  @default(now())
  /// Durable away-bonus state. Prevents collecting twice by refresh spam.
  lastAwayBonusAt       DateTime?

  payoutPercent Int @default(50)

  whores       Int @default(0)
  thugs        Int @default(0)
  woundedThugs Int @default(0)

  condoms  Int @default(0)
  medicine Int @default(0)
  crack    Int @default(0)
  beer     Int @default(0)

  pistols  Int @default(0)
  shotguns Int @default(0)
  tek9s    Int @default(0)
  ak47s    Int @default(0)

  /// What each shop currently has on the shelf for this player, and the clock
  /// each shelf refills on. Same lazy-regeneration shape as turns: the counter only
  /// moves when the player is looked at. A ruleset with no limit on a weapon
  /// simply never reads its pair.
  pistolStock    Int      @default(0)
  pistolStockAt  DateTime @default(now())
  shotgunStock   Int      @default(0)
  shotgunStockAt DateTime @default(now())
  tek9Stock      Int      @default(0)
  tek9StockAt    DateTime @default(now())
  ak47Stock      Int      @default(0)
  ak47StockAt…20061 tokens truncated…)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  /// 1-based lot on the block. Lot 1 opens first.
  lot   Int
  /// Ruleset business key, e.g. CASINO_FRONT.
  kind  String
  /// 0 is an empty lot.
  level Int    @default(0)

  /// 1.1.0-B. Staff working it: thugs, or girls for a Strip Club. Still counted in the
  /// owner's `thugs`/`whores`, and marked there as `businessThugs`/`businessWhores`.
  staff           Int             @default(0)
  /// How many staff the crew wants here: up to the level's max, 0 to close it.
  staffTarget     Int             @default(0)
  /// Replace staff who desert or are lured from the fit crew, up to the target, on settle.
  autoStaff       Boolean         @default(true)
  /// Whose staff they are. Only earns while this crew holds the block; when it no longer
  /// does, the staff go home on the owner's next settle and the register is lost.
  staffOwnerId    String?
  staffOwner      RoundPlayer?    @relation("BusinessStaffOwner", fields: [staffOwnerId], references: [id], onDelete: SetNull)
  /// Income waiting to be collected, capped at the ruleset's register hours.
  registerCents   BigInt          @default(0)
  /// Whole hours of income and supply are settled up to here.
  accruedAt       DateTime        @default(now())
  /// 1.1.0-C. The ruleset racket key this business runs on top of its front, if any.
  /// Cleared when another crew takes it over.
  racket          String?
  /// When the racket was last set or switched; the switch cooldown runs from here.
  racketSince     DateTime?
  /// 1.1.0-D. A torch the holder lit during a war: it burns down at `torchUntil`.
  torchUntil      DateTime?
  torchById       String?
  /// 1.3.0-C. A business raid shuts the racket (never the front) for this window.
  racketShutFrom  DateTime?
  racketShutUntil DateTime?
  warrants        PlayerWarrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([turfId, lot])
  @@index([roundId])
  @@index([staffOwnerId])
}

/// 1.2.0-A. Chips never sit on RoundPlayer cash. Every city owns a separate wallet.
model CasinoWallet {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  chipsCents BigInt   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roundPlayerId, cityId])
  @@index([cityId])
}

/// One in-person casino bankroll. Later games mutate bankrollCents under the same player lock.
model CasinoSession {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  status        String    @default("OPEN")
  bankrollCents BigInt
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ledger CasinoLedgerEntry[]

  @@index([roundPlayerId, status, openedAt(sort: Desc)])
  @@index([cityId, status])
}

/// 1.2.0-B. One durable non-retriggering free-spin bundle per player.
/// The wager configuration that earned it is frozen until the bundle is consumed.
model CasinoFreeSpinBonus {
  id String @id @default(cuid())

  roundPlayerId String      @unique
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  citySlug          String
  machineKey        String
  betPerLineCents   BigInt
  activePaylineKeys Json
  awardedSpins      Int
  remainingSpins    Int
  totalWonCents     BigInt   @default(0)
  sourceActionId    String
  awardedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([machineKey])
  @@index([citySlug])
}

/// 1.2.0-C. Server-owned shuffled shoe for one player/table.
/// The cursor advances only under the RoundPlayer row lock.
model CasinoBlackjackShoe {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  tableKey      String
  cards         Json
  cursor        Int      @default(0)
  shuffleNumber Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([roundPlayerId, tableKey])
  @@index([tableKey])
}

/// 1.2.0-C. Reconnect-safe blackjack hand. Player/dealer cards and split-hand
/// state stay server-owned; settled rows double as durable hand history.
model CasinoBlackjackHand {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  sessionId           String
  cityId              String
  tableKey            String
  status              String    @default("ACTIVE")
  wagerCents          BigInt
  committedWagerCents BigInt
  playerHands         Json
  dealerCards         Json
  activeHandIndex     Int       @default(0)
  totalReturnCents    BigInt    @default(0)
  bankrollAfterCents  BigInt    @default(0)
  shoeRemainingCards  Int       @default(0)
  shuffleNumber       Int       @default(1)
  initialActionId     String
  settledAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([roundPlayerId, initialActionId])
  @@index([roundPlayerId, status, createdAt(sort: Desc)])
  @@index([sessionId, status])
  @@index([cityId, createdAt(sort: Desc)])
}

/// Idempotency receipt for blackjack Deal / Hit / Stand / Double / Split.
/// response is the exact post-action hand snapshot returned on retry.
model CasinoBlackjackAction {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  handId    String
  actionId  String
  kind      String
  response  Json
  createdAt DateTime @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([handId, createdAt])
}

/// 1.2.0-D. One reconnect-safe Street Dice pass-line cycle.
/// The line and odds wagers stay committed until the point resolves.
model CasinoStreetDiceRound {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  sessionId String
  cityId    String
  tableKey  String
  status    String @default("ACTIVE")

  lineWagerCents BigInt
  oddsWagerCents BigInt  @default(0)
  point          Int?
  lastDice       Json    @default("[]")
  lastOutcome    String?
  rollCount      Int     @default(0)

  totalReturnCents   BigInt @default(0)
  bankrollAfterCents BigInt @default(0)

  initialActionId String
  settledAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([roundPlayerId, initialActionId])
  @@index([roundPlayerId, status, createdAt(sort: Desc)])
  @@index([sessionId, status])
  @@index([cityId, createdAt(sort: Desc)])
}

/// Idempotency receipt for Street Dice start / roll / odds actions.
model CasinoStreetDiceAction {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  diceRoundId String
  actionId    String
  kind        String
  response    Json
  createdAt   DateTime @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([diceRoundId, createdAt])
}

/// 1.2.0-E. Server-owned solo Hold’em hand. The JSON game state includes bot cards
/// and is never returned directly; the service builds viewer-safe DTOs from it.
model CasinoPokerHand {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  sessionId          String
  cityId             String
  tableKey           String
  status             String    @default("ACTIVE")
  buyInCents         BigInt
  state              Json
  bankrollAfterCents BigInt
  initialActionId    String
  settledAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([roundPlayerId, initialActionId])
  @@index([roundPlayerId, status, createdAt(sort: Desc)])
  @@index([sessionId, status])
  @@index([cityId, createdAt(sort: Desc)])
}

/// Idempotent action receipt for solo Hold’em, including the exact safe response.
model CasinoPokerAction {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  handId    String
  actionId  String
  kind      String
  response  Json
  createdAt DateTime @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([handId, createdAt])
}

/// 1.2.0-F. Multiplayer Hold’em lobby table; gameplay is added in the next slice.
model CasinoPokerTable {
  id                   String                 @id @default(cuid())
  roundId              String
  round                Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  cityId               String
  name                 String
  visibility           String                 @default("PUBLIC")
  inviteCodeHash       String?
  creatorRoundPlayerId String
  createActionId       String
  maxPlayers           Int                    @default(6)
  buyInCents           BigInt
  status               String                 @default("WAITING")
  dealerSeatNo         Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  seats                CasinoPokerSeat[]
  hands                CasinoPokerTableHand[]

  @@unique([creatorRoundPlayerId, createActionId])
  @@index([roundId, status, visibility, createdAt])
  @@index([cityId, status])
}

model CasinoPokerSeat {
  id            String           @id @default(cuid())
  tableId       String
  table         CasinoPokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  roundPlayerId String
  roundPlayer   RoundPlayer      @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  sessionId     String
  actionId      String
  seatNo        Int
  stackCents    BigInt
  status        String           @default("WAITING")
  joinedAt      DateTime         @default(now())
  leftAt        DateTime?

  @@unique([tableId, seatNo])
  @@unique([roundPlayerId, actionId])
  @@index([roundPlayerId, status])
  @@index([tableId, status, seatNo])
}

model CasinoPokerTableHand {
  id        String                   @id @default(cuid())
  tableId   String
  table     CasinoPokerTable         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  handNo    Int
  status    String                   @default("ACTIVE")
  state     Json
  outcome   String?
  startedAt DateTime                 @default(now())
  settledAt DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  actions   CasinoPokerTableAction[]

  @@unique([tableId, handNo])
  @@index([tableId, status, handNo])
}

model CasinoPokerTableAction {
  id            String               @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer          @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  handId        String
  hand          CasinoPokerTableHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  actionId      String
  kind          String
  response      Json
  createdAt     DateTime             @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([handId, createdAt])
}

/// Immutable retry receipt for every casino money movement.
model CasinoLedgerEntry {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  sessionId String?
  session   CasinoSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  actionId               String
  kind                   String
  cashDeltaCents         BigInt   @default(0)
  walletChipDeltaCents   BigInt   @default(0)
  sessionChipDeltaCents  BigInt   @default(0)
  walletChipsAfterCents  BigInt
  sessionChipsAfterCents BigInt   @default(0)
  metadata               Json     @default("{}")
  createdAt              DateTime @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@index([cityId, createdAt(sort: Desc)])
}

/// 1.2.0-E. Rated play for one player at one city's casino. Every charged wager adds its
/// theoretical house win (wager x pinned edge), never its result. Network status is the
/// sum of theo across cities; comps are earned as a share of theo and spent on Boss Trip
/// hotel nights. Basis columns hold cents x basis points so small wagers lose nothing to
/// rounding; whole cents are basis / 10,000. Status and comps never feed any game's odds.
model CasinoRating {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// Charged chips wagered here. Free spins and comped play add nothing.
  wageredCents    BigInt    @default(0)
  /// Theoretical house win in cents x bps.
  theoBasis       BigInt    @default(0)
  /// Comps earned here in cents x bps.
  compBasis       BigInt    @default(0)
  /// Whole comp cents redeemed while the boss was in this city.
  compsSpentCents BigInt    @default(0)
  ratedWagers     Int       @default(0)
  /// 1.2.0-F. Season casino feats: wagers placed at VIP tables, progressive jackpots hit,
  /// and the biggest net win on one settled hand, spin, roll or poker hand.
  vipWagers       Int       @default(0)
  jackpots        Int       @default(0)
  biggestWinCents BigInt    @default(0)
  lastRatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([roundPlayerId, cityId])
  @@index([cityId])
}

/// 1.2.0-B. One progressive pool per round/machine. It is house money, never player net worth.
model CasinoJackpot {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  machineKey String
  poolCents  BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roundId, machineKey])
  @@index([machineKey])
}

/// 0.6.0-D. The box attached to one away-held block. A home block never needs one.
/// Runs are the only intended way to move stock in or out; later D slices enforce that.
model TurfOutpost {
  id String @id @default(cuid())

  turfId String @unique
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  ownerId String
  owner   RoundPlayer @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  cashCents BigInt @default(0)
  beer      Int    @default(0)
  /// Product-key -> quantity. Crack is stored here too because this is not home inventory.
  products  Json   @default("{}")

  /// Trips D2. The boss walked this corner: its crew stays put until `moraleUntil`.
  visitedAt   DateTime?
  moraleUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// 0.6.0-A. Turns a crew has worked on a block lately. You cannot claim a block you have
/// never worked, and presence fades on the ruleset's half-life, settled from `at` on read.
model TurfPresence {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Ruleset district key, e.g. CASINO.
  district String

  /// Turns worked, as of `at`. Faded on read, never by a sweep.
  turns Float    @default(0)
  at    DateTime @default(now())

  @@unique([roundPlayerId, cityId, district])
}

/// 0.6.0-C. A player-vs-player attempt to take one block. The attacking squad
/// is committed at start and the fight lands after the warning window.
enum TurfPushStatus {
  PENDING
  LANDED
}

model TurfPush {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  attackerId         String
  attacker           RoundPlayer @relation("TurfPushAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  /// Alliance snapshots make shared revenge stable if either player later leaves.
  attackerAllianceId String?

  /// Holder when the push started. The block may be abandoned before it lands.
  defenderId         String
  defender           RoundPlayer @relation("TurfPushDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  defenderAllianceId String?

  squad              Int
  /// Morale and the exact guns committed from home.
  attackerCrew       Json
  turnsSpent         Int
  actionId           String
  startedAt          DateTime
  landsAt            DateTime
  status             TurfPushStatus   @default(PENDING)
  settledAt          DateTime?
  /// True only when this push actually transferred the block to the attacker.
  captured           Boolean          @default(false)
  result             Json?
  attackerCreditedAt DateTime?
  alliesCalledAt     DateTime?
  /// Public turf-feed claim, parallel to RaidBattle.discordPostedAt.
  discordPostedAt    DateTime?
  /// 0.9.0-G. When the holder was told their block is being pushed (once their Lookouts saw it),
  /// and when their alliance was told about the call for help.
  defenderAlertedAt  DateTime?
  alliesAlertedAt    DateTime?
  /// Private notification collection is independent from the public feed.
  alertsCollectedAt  DateTime?
  backups            TurfPushBackup[]

  @@unique([attackerId, actionId])
  @@index([turfId, status])
  @@index([roundId, status, landsAt])
  @@index([roundId, captured, settledAt(sort: Desc)])
  @@index([alertsCollectedAt, settledAt])
  @@index([attackerId, turfId, startedAt(sort: Desc)])
  @@index([attackerId, captured, settledAt(sort: Desc)])
  @@index([defenderAllianceId, attackerId, captured, settledAt(sort: Desc)])
  @@index([attackerId, attackerCreditedAt])
}

/// Real home/alliance help committed to a pending turf push. C landing decides
/// whether an ally's uncertain reinforcement actually arrives.
model TurfPushBackup {
  id String @id @default(cuid())

  pushId String
  push   TurfPush @relation(fields: [pushId], references: [id], onDelete: Cascade)

  playerId String
  player   RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// OWNER or ALLY.
  kind       String
  thugs      Int
  crew       Json
  sentAt     DateTime
  showedUp   Boolean?
  wounded    Int       @default(0)
  creditedAt DateTime?

  @@unique([pushId, playerId])
  @@index([playerId, creditedAt])
}

/// 0.6.0-E. One continuous stretch where a crew held a block with one alliance
/// identity. Alliance membership changes split the segment so old hours never move
/// retroactively to a new alliance.
model TurfHoldSegment {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  holderId String
  holder   RoundPlayer @relation(fields: [holderId], references: [id], onDelete: Cascade)

  holderPublicPimpId Int
  holderName         String

  /// Snapshot only. We deliberately do not FK this because disband/rename history must survive.
  allianceId   String?
  allianceName String?
  allianceTag  String?

  startedAt DateTime
  endedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([roundId, holderId, startedAt])
  @@index([roundId, allianceId, startedAt])
  @@index([turfId, endedAt])
}

/// 0.6.0-E. One durable alliance city-control change. Snapshot names/tags keep
/// history readable if an alliance later renames or disbands.
model TurfControlEvent {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  previousAllianceId   String?
  previousAllianceName String?
  previousAllianceTag  String?
  nextAllianceId       String?
  nextAllianceName     String?
  nextAllianceTag      String?

  previousBlocksHeld Int @default(0)
  nextBlocksHeld     Int @default(0)
  blocksTotal        Int

  happenedAt        DateTime
  discordPostedAt   DateTime?
  alertsCollectedAt DateTime?

  @@index([roundId, happenedAt(sort: Desc)])
  @@index([discordPostedAt, happenedAt])
  @@index([alertsCollectedAt, happenedAt])
}

/// 0.6.0-F. One seeded late-round Federal sweep. The target and clock are fixed per
/// round, so the warning and the sweep can be replayed/idempotently claimed by Discord.
model TurfCrackdown {
  id String @id @default(cuid())

  roundId String @unique
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  warningAt DateTime
  sweepAt   DateTime
  sweptAt   DateTime?

  holdersAffected Int  @default(0)
  thugsPickedUp   Int  @default(0)
  /// Per-holder result snapshots for receipts/feed summaries.
  results         Json @default("[]")

  warningDiscordPostedAt DateTime?
  sweepDiscordPostedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warningAt])
  @@index([sweepAt, sweptAt])
  @@index([warningDiscordPostedAt, warningAt])
  @@index([sweepDiscordPostedAt, sweepAt])
}

/// 0.6.0-B. The daily turf-tax cap is per payer and holder. The worker's burn is not
/// stored here; only the minted holder share needs a cap and a dashboard/history read.
model TurfTaxLedger {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  payerId String
  payer   RoundPlayer @relation("TurfTaxPayer", fields: [payerId], references: [id], onDelete: Cascade)

  holderId String
  holder   RoundPlayer @relation("TurfTaxHolder", fields: [holderId], references: [id], onDelete: Cascade)

  /// UTC calendar day, stored at midnight.
  day DateTime

  mintedCents   BigInt @default(0)
  /// House-minted tax already credited to the holder's home cash or, in 0.6.0-D, an outpost box.
  creditedCents BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, payerId, holderId, day])
  @@index([roundId, holderId, day])
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

/// Short-lived record of a completed resource-changing action. A repeated
/// actionId replays the stored result instead of executing twice.
model ProcessedAction {
  id String @id @default(cuid())

  /// Client generated. Scoped to the player, so one player's action id can
  /// never collide with or block another's.
  actionId String

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  action String
  result Json

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([roundPlayerId, actionId])
  @@index([expiresAt])
}

/// 1.0.0-E. Something the server refused because it looked like an exploit or a bug:
/// a database guard, a broken invariant, a hit between linked accounts, a flood of
/// refused requests. The same thing from the same account on the same day folds into
/// one row. No foreign keys: a flag outlives what it points at.
model ExploitFlag {
  id            String   @id @default(cuid())
  fingerprint   String   @unique
  kind          String
  /// info, warning or critical.
  severity      String   @default("warning")
  accountId     String?
  roundPlayerId String?
  roundId       String?
  route         String?
  message       String
  detail        Json?
  occurrences   Int      @default(1)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  reviewedAt         DateTime?
  reviewedByUsername String?
  /// dismissed or actioned.
  resolution         String?
  reviewNote         String?

  @@index([reviewedAt, lastSeenAt(sort: Desc)])
  @@index([accountId, lastSeenAt(sort: Desc)])
}

/// 1.1.0-D. A block war against a player-held block: declared, opened with a fight, then a
/// siege that builds Control until the attacker wins, or the holder breaks it, concedes, or
/// the time limit runs out. Everything is settled lazily, like turf pushes.
model BlockWar {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  attackerId         String
  attacker           RoundPlayer @relation("BlockWarAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  attackerAllianceId String?
  defenderId         String
  defender           RoundPlayer @relation("BlockWarDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  defenderAllianceId String?

  goal       BlockWarGoal
  status     BlockWarStatus @default(OPENING)
  actionId   String
  declaredAt DateTime
  endsBy     DateTime

  /// Control 0..100, as of `controlAt`, while a siege is on.
  control        Float     @default(0)
  controlAt      DateTime?
  siegeSince     DateTime?
  /// Every hour of siege so far, and every fight, for fatigue.
  siegeHours     Float     @default(0)
  fights         Int       @default(0)
  /// After a lost assault or a broken siege, when the declarer may assault again.
  nextAssaultAt  DateTime?
  fatigueAtStart Float     @default(0)

  /// One ally slot per side for the whole war, the cut its caller promised (0..0.5), the
  /// call's open window, and whether the ally actually fought.
  attackerAllyId     String?
  defenderAllyId     String?
  attackerCut        Float     @default(0)
  defenderCut        Float     @default(0)
  attackerCallUntil  DateTime?
  defenderCallUntil  DateTime?
  attackerAllyFought Boolean   @default(false)
  defenderAllyFought Boolean   @default(false)

  winner                  BlockWarSide?
  /// CONTROL, CONCEDED, WITHDREW, TIMEOUT, ABANDONED or CUTOFF.
  endReason               String?
  endedAt                 DateTime?
  result                  Json?
  /// The public Discord street feed: when the declaration and the end were posted.
  discordDeclaredPostedAt DateTime?
  discordEndedPostedAt    DateTime?

  squads    BlockWarSquad[]
  fightRows BlockWarFight[]

  @@unique([attackerId, actionId])
  @@index([turfId, status])
  @@index([roundId, status])
  @@index([attackerId, status])
  @@index([defenderId, status])
}

/// A fight in a block war: the opening fight, a re-assault after a lost one, or the holder's
/// attempt to break the siege. It lands at `landsAt`, after the warning or muster window.
model BlockWarFight {
  id String @id @default(cuid())

  warId String
  war   BlockWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  kind      BlockWarFightKind
  startedAt DateTime
  landsAt   DateTime
  /// PENDING, LANDED or CANCELLED.
  status    String            @default("PENDING")
  result    Json?

  @@index([warId, status])
}

/// Thugs (and their guns) a crew has committed to a block war: the declarer's squad, the
/// holder's backup, an ally. They leave home while committed, like a push squad, and come
/// back through the player's own credit pass, so nobody else's row is written for them.
model BlockWarSquad {
  id String @id @default(cuid())

  warId String
  war   BlockWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  playerId String
  player   RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  side            BlockWarSide
  /// DECLARER, HOLDER or ALLY.
  role            String
  /// The fight it was sent to, or null for the occupying squad's siege presence.
  fightId         String?
  sent            Int
  /// Still deployed. Wounded thugs go home as they are hurt; the rest when it is released.
  thugs           Int
  wounded         Int          @default(0)
  /// Morale and the exact guns committed from home.
  crew            Json
  active          Boolean      @default(true)
  recoverAt       DateTime?
  /// On a Take, the declarer's thugs that stay on as the new corner crew.
  posted          Int          @default(0)
  /// Paid with the squad's final credit: Sack loot or an ally's cut, and Heat.
  payoutCents     BigInt       @default(0)
  heat            Int          @default(0)
  /// What the owner's credit pass has already taken back.
  creditedThugs   Int          @default(0)
  creditedWounded Int          @default(0)
  gunsCreditedAt  DateTime?
  createdAt       DateTime     @default(now())

  @@index([playerId, active])
  @@index([warId, active])
}

enum BlockWarGoal {
  TAKE
  SACK
}

enum BlockWarStatus {
  OPENING
  SIEGE
  BETWEEN
  ENDED
}

enum BlockWarSide {
  ATTACKER
  DEFENDER
}

enum BlockWarFightKind {
  OPENING
  ASSAULT
  BREAK
}

// ---------------------------------------------------------------------------
// Law enforcement (1.3.0)
// ---------------------------------------------------------------------------

/// 1.3.0-A. One city's Case on one player: what that city's police have on them. Stored
/// in hundredths of a point (the ruleset's caseMax x 100 at most). Private to its player,
/// and gone with the round like every RoundPlayer row. Heat is unaffected by it.
model PlayerCase {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  caseHundredths Int       @default(0)
  /// The Wanted stage the Case last read as; a rise logs CASE_STAGE_UP once.
  stage          String    @default("QUIET")
  /// 1.3.0-B. When `caseHundredths` was last brought up to date. Cooling after it is worked
  /// out on read and written as a COOLING receipt with the next change.
  caseAt         DateTime  @default(now())
  /// 1.3.0-B. The player's last act that added evidence here. Cooling starts a quiet spell after it.
  lastEvidenceAt DateTime?
  /// 1.3.0-B. Cash moved in this city on `reportDay` (UTC), for currency reports.
  reportDay      String?
  reportCents    BigInt    @default(0)
  /// 1.3.0-F. The highest stage this Case has reached since it last left Quiet, and when it
  /// left Quiet. Both reset when it cools back to Quiet. Ledger's Jobs read them.
  peakStage      String    @default("QUIET")
  openedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, cityId])
  @@index([cityId])
}

/// 1.3.0-A. An itemised, immutable change to a Case: why it exists. Keyed on the act that
/// caused it, so a retried action or a re-run settle never adds evidence twice.
model PlayerCaseReceipt {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// What drew it: SCOUT, PRODUCE, RUN_SALE, COMBAT, CONVOY, TORCH, SACK, RACKETS, CRACKDOWN,
  /// and from 1.3.0-B BUST, ARREST, ROAD_STOP, HIJACK, CURRENCY_REPORT, LAUNDERING and COOLING.
  source              String
  sourceKey           String
  /// Heat the act drew, before the Heat meter's cap.
  heat                Float
  deltaHundredths     Int
  caseAfterHundredths Int
  stageAfter          String
  /// 1.3.0-B. This change took the Case to a higher stage; the alert collector tells the player.
  stageUp             Boolean   @default(false)
  alertsCollectedAt   DateTime?
  createdAt           DateTime  @default(now())

  @@unique([roundPlayerId, sourceKey])
  @@index([stageUp, alertsCollectedAt])
  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([roundPlayerId, cityId, createdAt(sort: Desc)])
}

/// 1.3.0-C. A warrant a city's police drafted when the player's Case there reached the Warrant
/// stage. It names one target and is served at `servesAt` unless answered first. A personal
/// warrant past `servesAt` waits (WAITING) until the boss is in that city, or the round ends.
model PlayerWarrant {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// HIDEOUT, BUSINESS or PERSONAL.
  target     String
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  /// OPEN, WAITING, SERVED, LAWYERED, or (1.3.0-D) QUASHED by a District Attorney.
  status     String    @default("OPEN")
  draftedAt  DateTime
  servesAt   DateTime
  resolvedAt DateTime?
  /// What serving or answering it did: seizures, fines, the shut window, the lock-up, or the fee.
  outcome    Json      @default("{}")

  /// Alert collection markers, one per event the player is told about.
  draftAlertedAt    DateTime?
  waitingAlertedAt  DateTime?
  resolvedAlertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roundPlayerId, status])
  @@index([status, servesAt])
  @@index([cityId])
  @@index([businessId])
}

/// 1.3.0-D. A corrupt official on one player's payroll in one city: a Precinct Captain, a
/// District Attorney, a Judge or a Customs Officer. Paid by the week; works only while paid.
/// Every favor adds exposure; past the line Internal Affairs opens a file, and an official
/// still on the books when `stingAt` comes is stung, which ends them and adds evidence.
model PlayerOfficial {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// CAPTAIN, DA, JUDGE or CUSTOMS.
  role         String
  /// ACTIVE (working while `paidUntil` is ahead), CUT (let go) or STUNG (caught by Internal Affairs).
  status       String    @default("ACTIVE")
  hiredAt      DateTime
  paidUntil    DateTime
  /// Exposure points from favors. Starts again from zero with each new hire.
  exposure     Int       @default(0)
  /// Internal Affairs opened a file at `iaOpenedAt`; the sting lands at `stingAt` unless cut first.
  iaOpenedAt   DateTime?
  stingAt      DateTime?
  /// A DA can quash again from here.
  quashReadyAt DateTime?
  endedAt      DateTime?

  /// Alert collection markers.
  iaAlertedAt    DateTime?
  stungAlertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, cityId, role])
  @@index([status, stingAt])
  @@index([cityId])
}

/// 1.3.0-D. A tip bought from an informant: information, never protection. SWEEP names the
/// federal sweep's city and time before it is public; CITY names a city's police lines.
model PlayerTip {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  kind    String
  cityId  String?
  city    City?   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  payload Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([cityId])
}

/// 1.4.0-B. A player's seasonal standing with one faction. Starts at zero every round; only the
/// player's own one-time Jobs add to it, each with a receipt.
model PlayerFactionStanding {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// KINGS, OUTFIT, ROAD_SAINTS, CARTEL_LINE or CIVIC_HANDSHAKE.
  factionKey          String
  points              Int       @default(0)
  /// The tier the standing last read as; a rise logs FACTION_TIER_UP once.
  tier                String    @default("UNKNOWN")
  /// 1.4.0-F. When the player reached Inner Circle, and when the street feed posted it.
  innerCircleAt       DateTime?
  innerCirclePostedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, factionKey])
  @@index([innerCirclePostedAt, innerCircleAt])
}

/// 1.4.0-B. An immutable change to faction standing, keyed on the act that caused it so a retry
/// never pays twice. The receipts always add up to the stored standing.
model PlayerFactionReceipt {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  factionKey  String
  /// JOB (a one-time Job), CONTRACT (a sponsored board contract, 1.4.0-C), later ADMIN and others.
  source      String
  sourceKey   String
  delta       Int
  pointsAfter Int
  tierAfter   String

  createdAt DateTime @default(now())

  @@unique([roundPlayerId, sourceKey])
  @@index([roundPlayerId, factionKey, createdAt])
}

/// 1.4.0-D. A Connected nudge taking effect: which faction, which nudge, the percent the ruleset
/// pinned, and what it saved. Keyed on the act it applied to, so a retried action or a re-run
/// settle never logs twice. Read-only to play; G's admin view audits it.
model PlayerFactionPerkUse {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  factionKey String
  /// CORNER_UPKEEP, TOMMY_WEAPONS, BODYGUARD_TICKETS, PIP_PRODUCT or OFFICIAL_EXPOSURE.
  kind       String
  sourceKey  String
  percent    Int
  /// What it saved: { cents }, { beer, product } or { exposure }.
  saved      Json

  createdAt DateTime @default(now())

  @@unique([roundPlayerId, sourceKey])
  @@index([roundPlayerId, factionKey, createdAt])
}

/// 1.4.0-D. An early warning from a faction the player is Trusted with that has reached the bell.
/// Keyed on the warning itself (a shield, a run's leg, a drought, a Case nearing a stage), so the
/// alert sweep sends each warning once however often it looks.
model PlayerFactionWarning {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  factionKey        String
  warningKey        String
  /// What the warning said and where it pointed, for the push and Discord alert.
  text              String    @default("")
  href              String    @default("/game/quests#factions")
  /// When the alert collector turned it into push and Discord alerts.
  alertsCollectedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([roundPlayerId, warningKey])
  @@index([alertsCollectedAt, createdAt])
}
