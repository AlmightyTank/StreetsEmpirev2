// StreetsEmpire - 0.1.0 "Classic Foundation"
// Ruleset: classic-og-v0.1
//
// Money is stored as INTEGER CENTS (BigInt). $1.00 = 100. Never floats.
// Anything not player-facing in 0.1.0 (PvP, alliances, travel) is deliberately
// absent, but the shapes below are chosen so 0.2.0 does not need a redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & sessions
// ---------------------------------------------------------------------------

/// A permanent player identity. Survives every round.
model Account {
  id                          String              @id @default(cuid())
  username                    String
  crewLegendArchives          CrewLegendArchive[]
  /// Lowercased username. Enforces case-insensitive uniqueness. A database CHECK
  /// (Account_usernameNormalized_lowercase) refuses any row where this is not lower(username).
  usernameNormalized          String              @unique
  /// Lowercased email. Private account recovery and login address.
  email                       String              @unique
  emailVerifiedAt             DateTime?
  /// Set for every account that existed before email verification was required: they may
  /// keep playing without verifying. Accounts created later are never grandfathered.
  verificationGrandfatheredAt DateTime?
  /// When the player accepted the game rules, and which version of them.
  rulesAcceptedAt             DateTime?
  rulesAcceptedVersion        String?
  /// rc.2. When the player closed their own account (isActive false). Null for staff deactivations.
  closedAt                    DateTime?
  /// rc.2. The address the account signed up from, for the per-address daily sign-up cap.
  registeredIp                String?
  /// rc.5. When the player confirmed at sign-up that they meet the minimum age. The rules
  /// agreement asks every player too (Discord sign-ups included).
  ageConfirmedAt              DateTime?
  /// Private date-only birthday. Null on legacy/Discord accounts until collected after sign-in.
  birthDate                   DateTime?           @db.Date
  /// rc.3. Authenticator-app two-step sign-in. Secrets are AES-GCM sealed (auth/totp.ts).
  twoFactorSecret             String?
  /// Set while the player is scanning the QR code, before they confirm a first code.
  twoFactorPendingSecret      String?
  twoFactorEnabledAt          DateTime?
  /// The last code step used, so a code cannot be used twice.
  twoFactorLastStep           Int?
  passwordHash                String

  discordId       String?   @unique
  discordUsername String?
  discordAvatar   String?
  discordLinkedAt DateTime?

  /// Google Play Games player identity. Never auto-linked by email.
  playGamesId          String?   @unique
  playGamesDisplayName String?
  playGamesLinkedAt    DateTime?

  /// Apple Sign in subject identifier. Stored independently of email so Private Relay works.
  appleId       String?   @unique
  appleEmail   String?
  appleLinkedAt DateTime?

  /// Google OAuth subject. Kept separate from Google Play Games credentials.
  googleId       String?   @unique
  googleEmail   String?
  googleLinkedAt DateTime?

  /// Facebook Login subject identifier, separate from the profile email.
  facebookId       String?   @unique
  facebookEmail    String?
  facebookLinkedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  isActive     Boolean    @default(true)
  /// Kept equal to "staffRole is FOUNDER or ADMIN" by a database trigger and CHECK
  /// (see the staff_roles migration). Writing isAdmin alone still works: true makes
  /// the account ADMIN, false takes ADMIN away. New code reads and writes staffRole.
  isAdmin      Boolean    @default(false)
  /// Null for players. Set from Admin → Staff; FOUNDER only from the console.
  staffRole    StaffRole?
  betaApproved Boolean    @default(false)
  /// 2.4.0-F. Explicitly marked disposable account eligible for the beta territory encounter tester.
  territoryTestAccount Boolean @default(false)

  /// 0.3.0-B. A timed suspension. The account signs back in on its own once this
  /// passes; the fields are cleared lazily on the next sign-in attempt.
  suspendedUntil      DateTime?
  suspendedReason     String?
  suspendedByUsername String?
  /// 1.0.0-E. A ban: the account is shut down (isActive false) for this recorded reason.
  bannedAt            DateTime?
  bannedReason        String?
  bannedByUsername    String?

  /// 0.9.0-H. Communication restriction: no private messages or wire posts while it
  /// runs. The account still plays. Permanent wins over a date; both cleared by unmute.
  commsMutedUntil      DateTime?
  commsMutedPermanent  Boolean   @default(false)
  commsMuteReason      String?
  commsMutedByUsername String?

  sessions                         Session[]
  bugReports                       BugReport[]
  supportTickets                   SupportTicket[]
  twoFactorRecoveryCodes           TwoFactorRecoveryCode[]
  trustedDevices                   TrustedDevice[]
  knownDevices                     AccountDevice[]
  loginChallenges                  LoginChallenge[]
  passwordResetTokens              PasswordResetToken[]
  accountEmailTokens               AccountEmailToken[]
  forumLink                        ForumLink?
  forumLinkRequest                 ForumLinkRequest?
  notificationSettings             NotificationSettings?
  notificationOutbox               NotificationOutbox[]
  pushSubscriptions                PushSubscription[]
  profile                          AccountProfile?
  cosmeticUnlocks                  AccountCosmeticUnlock[]
  legacyEntries                    LegacyEntry[]
  playerCareer                     PlayerCareer?
  careerStoryPortfolios            CareerStoryPortfolio[]
  supporterMembership              SupporterMembership?
  googlePlaySupporterSubscriptions GooglePlaySupporterSubscription[]
  supporterPayments                SupporterPayment[]
  crownWallet                      CrownWallet?
  crownLedger                      CrownLedgerEntry[]
  dropOrders                       DropOrder[]
  crownPackOrders                  CrownPackOrder[]
  googlePlayCrownPackOrders        GooglePlayCrownPackOrder[]
  crownAdjustments                 CrownAdjustmentRequest[]
  supporterSeasonStamps            SupporterSeasonStamp[]
  supporterVotes                   SupporterVote[]
  admissionTickets                 AdmissionTicket[]
  admissionLeases                  AdmissionLease[]
  roundPlayers                     RoundPlayer[]
  aftermathRewardClaims            RoundAftermathRewardClaim[]
  authoredNews                     GameNews[]                        @relation("GameNewsAuthor")
  adminAuditEntries                AdminAuditLog[]                   @relation("AdminAuditActor")
  messageBlocksMade                PlayerBlock[]                     @relation("PlayerBlocker")
  messageBlocksReceived            PlayerBlock[]                     @relation("PlayerBlocked")
  messageReports                   PlayerMessageReport[]
  /// 0.9.0-H.
  mutesMade                        PlayerMute[]                      @relation("PlayerMuter")
  mutesReceived                    PlayerMute[]                      @relation("PlayerMuted")
  moderationNotes                  AccountModerationNote[]
  surveySubmissions                SurveySubmission[]
  experienceEvents                 PlayerExperienceEvent[]
  mentees                          Mentorship[]                      @relation("Mentor")
  mentor                           Mentorship?                       @relation("Mentee")
  experiencePoints                 Int                               @default(0)
  /// Turn XP taper: the daily window being counted and the turns spent in it.
  turnXpWindowStartsAt             DateTime?
  turnXpTurnsInWindow              Int                               @default(0)
  /// When the player last changed their own pimp name. Null until the first change, which is free.
  usernameChangedAt                DateTime?
  usernameChanges                  AccountUsernameChange[]
  staffRoleChanges                 StaffRoleChange[]                 @relation("StaffRoleTarget")
  staffRoleChangesMade             StaffRoleChange[]                 @relation("StaffRoleActor")

  @@index([registeredIp, createdAt])
  @@index([staffRole])
}

/// Staff ranks, highest first. Discord roles and forum groups follow these.
enum StaffRole {
  FOUNDER
  ADMIN
  MOD
  JR_MOD
  HELPER
}

/// Every staff role change. Unlike AdminAuditLog it is never purged by audit retention,
/// so the Staff page can always say who was staff and who made them so.
model StaffRoleChange {
  id String @id @default(cuid())

  accountId String?
  account   Account? @relation("StaffRoleTarget", fields: [accountId], references: [id], onDelete: SetNull)
  username  String

  actorAccountId String?
  actor          Account? @relation("StaffRoleActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorUsername  String

  fromRole StaffRole?
  toRole   StaffRole?
  reason   String
  /// GAME (Admin → Staff), DISCORD (/staff) or CONSOLE (npm run admin).
  source   String

  createdAt DateTime @default(now())

  @@index([accountId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Every pimp name an account has had, so staff can tell who a player used to be.
model AccountUsernameChange {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fromUsername           String
  /// lower(fromUsername). A name given up is held for its previous owner for 30 days.
  fromUsernameNormalized String
  toUsername             String
  /// PLAYER for a self-service change, REVERT for a player taking back the name they just
  /// gave up, STAFF for an admin rename (whose old name nobody may take for 30 days).
  source                 String
  createdAt              DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([fromUsernameNormalized, createdAt])
}

/// Permanent account progress, separate from season resources and Street Pass Cred.
/// Mentoring: a new player names one seasoned mentor, who earns account XP
/// as the mentee reaches levels. One mentor per mentee, for good.
model Mentorship {
  id              String   @id @default(cuid())
  mentorAccountId String
  mentor          Account  @relation("Mentor", fields: [mentorAccountId], references: [id], onDelete: Cascade)
  menteeAccountId String   @unique
  mentee          Account  @relation("Mentee", fields: [menteeAccountId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([mentorAccountId])
}

model PlayerExperienceEvent {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  sourceKey String
  source    String
  amount    Int
  awardedAt DateTime @default(now())

  @@unique([accountId, sourceKey])
  @@index([accountId, awardedAt(sort: Desc)])
  @@index([awardedAt])
}

/// The server-selected monthly Double XP Weekend. The schedule is persisted so
/// every request and every server instance uses the same weekend.
model DoubleXpWeekend {
  id         String    @id @default(cuid())
  monthKey   String    @unique
  startsAt   DateTime
  endsAt     DateTime
  announceAt DateTime
  newsId     String?   @unique
  news       GameNews? @relation(fields: [newsId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([startsAt, endsAt])
}

/// 0.9.0-H. Private admin notes on an account. Never shown to the player.
model AccountModerationNote {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  authorAccountId String?
  authorUsername  String
  body            String

  createdAt DateTime @default(now())

  @@index([accountId, createdAt(sort: Desc)])
}

/// 0.3.0-B. One row per admin action: who, what, when, and the target before
/// and after. The app only ever inserts these.
/// 1.0.0-A. Which environment owns this database. A production server refuses a
/// database claimed by beta and the reverse, so a wrong DATABASE_URL fails loudly
/// at boot instead of mixing live and test data. One row, id "singleton".
model DeploymentIdentity {
  id              String   @id @default("singleton")
  environment     String
  claimedAt       DateTime @default(now())
  lastBootAt      DateTime @default(now())
  lastBootVersion String
}

model AdminAuditLog {
  id String @id @default(cuid())

  /// Null once the acting account is deleted; actorUsername keeps the name.
  actorAccountId String?
  actor          Account? @relation("AdminAuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorUsername  String

  /// Dotted verb, e.g. round.schedule or round.end-early.
  action     String
  targetType String
  targetId   String?
  reason     String?

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

/// Cosmetic and preference settings. Pure prestige: never affects round starts,
/// action math, stores, ranks or combat.
model AccountProfile {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  activeTitleKey             String?
  titlePlacement             String  @default("prefix")
  /// 0.9.0-F. Optional public crew name, account-level so it carries across seasons.
  crewName                   String?
  /// Slice A. Versioned cosmetic street-sign design; never used as turf ownership.
  streetSign                 Json?
  profileBio                 String?
  profileImageUrl            String?
  /// Avatar built from face pieces (base, hair, eyes, shirt, ...). Shown when there is no image.
  profileAvatar              Json?
  profileBannerUrl           String?
  /// Slice C. Stable supporter crew banner key; entitlement is checked before display.
  activeCrewBannerKey        String?
  profileEffect              String  @default("none")
  activeProfileFrameKey      String?
  activeAvatarFrameKey       String?
  /// Signature Profile Card surface finish: brushed, carbon or engine-turned. Null shows brushed.
  profileSurface             String?
  /// Supporter thank-you list on the public site. Opt-in, so off by default.
  showOnSupporterList        Boolean @default(false)
  /// Supporter release-notes credits are opt-in and never list payments.
  releaseNotesCreditOptIn    Boolean @default(false)
  activeSiteThemeKey         String?
  /// Account-level hideout presentation; cosmetic only and independent of seasonal room state.
  activeHideoutDecorationKey String?
  activeStreetSignKey        String?
  /// Player-selected visual skin per inventory item key. Cosmetic only.
  itemCosmetics              Json    @default("{}")
  /// Slice F. A player's featured named item survives the round that created it.
  famousItem                 Json?
  /// THUG / HOE visual styles. Crew is aggregate inventory, so the style applies to the whole type.
  crewCosmetics              Json    @default("{}")
  /// Slice E. Visitors see the owner's site theme on their public profile.
  showThemeOnProfile         Boolean @default(true)
  /// Slice E. Visitors see the owner's item and crew look on their public profile.
  showLookOnProfile          Boolean @default(true)
  /// Slice E. Opt-in decorative cosmetics for the linked forum account.
  forumCosmeticsVisible      Boolean @default(false)
  /// 2.1.0-C. Player-only crew stories; never affects gameplay.
  showCrewMoments            Boolean @default(false)
  /// 2.1.0-F. Account-private cosmetic milestone celebrations, off by default.
  showCrewCelebrations       Boolean @default(false)
  /// Birthdays (docs/BIRTHDAYS.md). A cake on the name on the birthday itself. Opt-in, so off by default.
  showBirthdayCake           Boolean @default(false)
  featuredBadgeKeys          Json    @default("[]")
  featuredLegacyEntryId      String?
  profileAccent              String  @default("default")
  uiDensity                  String  @default("comfortable")
  reducedMotion              Boolean @default(false)
  moneyFormat                String  @default("full")
  defaultLanding             String  @default("game")
  /// Whether this player wants ordinary profanity shown in communication.
  showProfanity              Boolean @default(false)
  /// Start daily, weekly and city board work as soon as it appears.
  autoAcceptBoardWork        Boolean @default(true)
  /// 1.0.0-B. Tutorial progress: intro completed/skipped, page intros seen, guide
  /// dismissed for a season. Never gameplay state; see OnboardingService.
  onboarding                 Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Permanent cosmetic identity. Gameplay and fresh-round resources never read it.
model PlayerCareer {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  career            String
  history           Json     @default("[]")
  selectedAt        DateTime @default(now())
  switchAvailableAt DateTime
  updatedAt         DateTime @updatedAt

  @@index([career])
}

/// Permanent account cosmetics. Display metadata is snapshotted when earned so
/// titles and badges survive ruleset changes and round resets.
model AccountCosmeticUnlock {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  key         String
  kind        String
  title       String
  description String
  rarity      String
  styleKey    String?

  /// Quest key or another permanent account reward source.
  sourceQuestKey       String
  sourceRulesetId      String
  sourceRulesetVersion String
  awardedAt            DateTime @default(now())

  @@unique([accountId, key])
  @@index([accountId, awardedAt])
  @@index([key])
}

/// Supporter billing through Stripe: one row per account that started a
/// subscription. The rewards themselves are AccountCosmeticUnlock rows and stay
/// forever; this only says whether the account is supporting right now.
model SupporterMembership {
  accountId            String    @id
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  /// Stripe's subscription status: active, trialing, past_due, unpaid, canceled,
  /// incomplete, incomplete_expired or paused.
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  startedAt            DateTime  @default(now())
  endedAt              DateTime?
  /// When the newest Stripe event applied here was created, so an older,
  /// late-arriving event never overwrites a newer status.
  stripeEventAt        DateTime?
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

/// One verified provider payment for a supporter subscription. Kept when the
/// account is deleted (the link is cleared), since it is a financial record.
model SupporterPayment {
  id                String   @id @default(cuid())
  accountId         String?
  account           Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  provider          String   @default("stripe")
  providerPaymentId String   @unique
  stripeInvoiceId   String?  @unique
  stripeCustomerId  String?
  amountCents       Int
  currency          String
  /// paid, refunded or disputed. Refunds and disputes never take rewards back.
  status            String
  paidAt            DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId, paidAt])
  @@index([stripeCustomerId, paidAt])
  @@index([provider, paidAt])
}

/// A Google Play supporter subscription. Tokens can be replaced during plan
/// changes, so history is retained and the newest verified row is authoritative.
model GooglePlaySupporterSubscription {
  purchaseToken       String    @id
  accountId           String
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  productId           String
  status              String
  currentPeriodEnd    DateTime?
  autoRenewing        Boolean   @default(false)
  startedAt           DateTime
  endedAt             DateTime?
  latestOrderId       String?
  linkedPurchaseToken String?
  lastVerifiedAt      DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([accountId, lastVerifiedAt])
  @@index([status, currentPeriodEnd])
  @@map("google_play_supporter_subscription")
}

/// A verified record for one Google Play Crown pack. The purchase token is the
/// provider idempotency key; wallet changes remain server-authoritative.
model GooglePlayCrownPackOrder {
  purchaseToken  String    @id
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  productId      String
  packId         String
  crowns         Int
  status         String    @default("pending")
  orderId        String?
  currency       String?
  amountCents    Int?
  purchasedAt    DateTime?
  creditedAt     DateTime?
  refundedAt     DateTime?
  lastVerifiedAt DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([accountId, createdAt])
  @@index([orderId])
  @@index([status, createdAt])
}

/// One permanent record that an account supported during a season (round).
/// Written once at round close for every player whose account has a paid
/// invoice in the season window; career and Hall of Fame reads join it so a
/// finished season keeps its support stamp forever.
model SupporterSeasonStamp {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([accountId, roundId])
  @@index([roundId])
}

/// A staged supporter-only vote, such as picking a future monthly-drop theme.
model SupporterPoll {
  id          String          @id @default(cuid())
  title       String
  description String?
  /// Array of {key,label,description?}. Stored as JSON so admins can stage small polls without another table.
  options     Json
  status      String          @default("open")
  opensAt     DateTime        @default(now())
  closesAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  votes       SupporterVote[]

  @@index([status, opensAt])
  @@map("supporter_poll")
}

/// One supporter vote per account per poll.
model SupporterVote {
  id        String        @id @default(cuid())
  pollId    String
  poll      SupporterPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  accountId String
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  optionKey String
  createdAt DateTime      @default(now())

  @@unique([pollId, accountId])
  @@index([accountId, createdAt])
  @@map("supporter_vote")
}

/// Stripe webhook events already applied, so a redelivered event changes nothing.
// ---------------------------------------------------------------------------
// The Drop: Crowns and the cosmetic storefront (docs/THE-DROP.md)
// ---------------------------------------------------------------------------

/// Canonical account for persistent Drop entitlements shared by beta and live.
/// These tables intentionally have no Account relation: the entitlement store
/// is a separate database from either gameplay deployment.
model SharedEntitlementAccount {
  id          String                    @id @default(cuid())
  identityKey String                    @unique
  links       SharedEntitlementLink[]
  wallets     SharedCrownWallet?
  ledger      SharedCrownLedgerEntry[]
  unlocks     SharedCosmeticUnlock[]
  purchases   SharedEntitlementPurchase[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

/// Explicit mapping between an isolated gameplay account and its canonical
/// entitlement account. Email and username are intentionally not used for
/// automatic linking; operators create this row after verifying ownership.
model SharedEntitlementLink {
  id             String                   @id @default(cuid())
  accountId      String
  account        SharedEntitlementAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  environment    String
  localAccountId String
  createdAt      DateTime                 @default(now())

  @@unique([environment, localAccountId])
  @@index([accountId])
}

model SharedCrownWallet {
  accountId  String                   @id
  account    SharedEntitlementAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balance    Int                      @default(0)
  version    Int                      @default(0)
  heldAt     DateTime?
  holdReason String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
}

model SharedCrownLedgerEntry {
  id             String                   @id @default(cuid())
  accountId      String
  account        SharedEntitlementAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind           String
  delta          Int
  balanceAfter   Int
  source         String
  externalRef    String                   @unique
  environment    String
  localAccountId String?
  roundId        String?
  reason         String?
  metadata       Json?
  createdAt      DateTime                 @default(now())

  @@index([accountId, createdAt])
}

model SharedCosmeticUnlock {
  id             String                   @id @default(cuid())
  accountId      String
  account        SharedEntitlementAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key            String
  kind           String
  title          String
  description    String
  rarity         String
  styleKey       String?
  source         String
  environment    String
  localAccountId String?
  awardedAt      DateTime                 @default(now())

  @@unique([accountId, key])
  @@index([accountId, awardedAt])
}

model SharedEntitlementPurchase {
  id             String                   @id @default(cuid())
  accountId      String
  account        SharedEntitlementAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  environment    String
  localOrderId   String?
  provider       String?
  providerRef    String?
  kind           String
  refKey         String
  crownsDelta    Int                      @default(0)
  status         String                   @default("completed")
  metadata       Json?
  createdAt      DateTime                 @default(now())

  @@unique([environment, localOrderId])
  @@index([accountId, createdAt])
  @@index([provider, providerRef])
}

/// One Crown balance per account, never per round. Only CrownWalletService
/// changes it, under a row lock and always together with a CrownLedgerEntry, so
/// the balance always equals the sum of the ledger.
model CrownWallet {
  accountId  String    @id
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Whole Crowns. A CHECK keeps it at zero or above.
  balance    Int       @default(0)
  /// Bumped on every change.
  version    Int       @default(0)
  /// Set when a refunded or disputed pack was already spent: spending stops until support clears it.
  heldAt     DateTime?
  holdReason String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Append-only. Every Crown that moves has one row; `externalRef` is the
/// idempotency key of the event that moved it, so a replay can never apply twice.
model CrownLedgerEntry {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// EARN, PAID_GRANT, SPEND, ADJUSTMENT or REVERSAL.
  kind           String
  delta          Int
  balanceAfter   Int
  /// What moved it, e.g. daily-contract, pack:boss, drop-order, street-pass-skip, admin.
  source         String
  externalRef    String   @unique
  /// The round an EARN was earned in, for the per-round cap. Never used for ownership.
  roundId        String?
  reason         String?
  metadata       Json?
  actorAccountId String?
  createdAt      DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([accountId, kind, roundId])
  @@index([kind, createdAt])
}

/// Admin overrides for one Drop item or bundle. Art, names and kinds stay in
/// code (packages/rulesets/src/drop.ts); a missing row means the code defaults.
model DropCatalogEntry {
  key               String   @id
  /// ITEM or BUNDLE.
  kind              String
  /// DRAFT, QA, SCHEDULED, LIVE, VAULTED or ARCHIVED. Only LIVE is sold.
  state             String   @default("LIVE")
  priceCrowns       Int?
  /// MAY_RETURN, PERMANENT or NEVER_RETURNING.
  returnPolicy      String   @default("MAY_RETURN")
  inDailyPool       Boolean  @default(true)
  homepageSlot      Int?
  updatedAt         DateTime @updatedAt
  updatedByUsername String?
}

/// An admin-scheduled offer. Daily and weekly-featured offers are computed
/// from the rotation and are not stored.
model DropOffer {
  id                String    @id @default(cuid())
  /// ITEM or BUNDLE.
  kind              String
  refKey            String
  /// FEATURED, DAILY or CATALOG.
  slot              String
  /// DROP_EXCLUSIVE, DAILY, FEATURED, RETURNING or PERMANENT.
  badge             String
  /// Null sells at the catalog price.
  priceCrowns       Int?
  startsAt          DateTime
  endsAt            DateTime?
  cancelledAt       DateTime?
  createdByUsername String
  note              String?
  createdAt         DateTime  @default(now())

  @@index([startsAt, endsAt])
  @@index([refKey])
}

/// One Crown purchase: an item, a bundle or Street Pass level skips. Written in
/// the same transaction as the debit and the unlocks. Kept, unlinked, if the
/// account is deleted.
model DropOrder {
  id            String   @id @default(cuid())
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// The client's idempotency key: the same id never charges twice.
  actionId      String
  /// ITEM, BUNDLE or STREET_PASS_SKIP.
  kind          String
  refKey        String
  offerId       String?
  priceCrowns   Int
  grantedKeys   String[]
  roundPlayerId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@unique([accountId, actionId])
  @@index([accountId, createdAt])
  @@index([createdAt])
}

/// A real-money Crown pack checkout. Credited once, only from a verified
/// provider event. Kept, unlinked, if the account is deleted.
model CrownPackOrder {
  id                String    @id @default(cuid())
  accountId         String?
  account           Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  provider          String    @default("stripe")
  packId            String
  crowns            Int
  amountCents       Int
  currency          String
  /// pending, credited, refunded, refund_review, disputed, failed or expired.
  status            String    @default("pending")
  checkoutSessionId String?   @unique
  /// Stripe payment intent; refunds and disputes are matched on it.
  providerPaymentId String?   @unique
  creditedAt        DateTime?
  refundedAt        DateTime?
  lastEventAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([accountId, createdAt])
  @@index([status])
}

/// Kill switches and tuning for The Drop. One row, id "global".
model DropSettings {
  id                       String   @id @default("global")
  storefrontEnabled        Boolean  @default(true)
  purchasesEnabled         Boolean  @default(true)
  earningEnabled           Boolean  @default(true)
  checkoutEnabled          Boolean  @default(false)
  streetPassSkipsEnabled   Boolean  @default(true)
  dailyOfferCount          Int      @default(4)
  dailyResetHourUtc        Int      @default(0)
  autoFeatured             Boolean  @default(true)
  roundEarnCap             Int      @default(500)
  largeAdjustmentThreshold Int      @default(1000)
  updatedAt                DateTime @updatedAt
  updatedByUsername        String?
}

/// An admin Crown grant or removal. Small ones apply at once; ones at or above
/// the threshold wait for a second admin.
model CrownAdjustmentRequest {
  id                  String    @id @default(cuid())
  accountId           String
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  delta               Int
  reason              String
  /// PENDING, APPLIED or REJECTED.
  status              String    @default("PENDING")
  requestedById       String
  requestedByUsername String
  decidedById         String?
  decidedByUsername   String?
  ledgerEntryId       String?
  createdAt           DateTime  @default(now())
  decidedAt           DateTime?

  @@index([status, createdAt])
  @@index([accountId, createdAt])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Verified public profile connection; owned by the permanent account.
model ForumLink {
  accountId     String   @id
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  forumOrigin   String
  forumUserId   String
  forumUsername String
  createdAt     DateTime @default(now())

  @@unique([forumOrigin, forumUserId])
}

/// Only the latest request in the initiating game session can be completed.
model ForumLinkRequest {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nonceHash String   @unique
  sessionId String
  expiresAt DateTime
}

/// Opt-in alerts for one account: which categories, and which channels deliver them.
/// turnsArmed: turns were below the cap at the last check, so reaching it sends one reminder.
/// rankRoundId/rankLastNational: the national rank last seen, to notice losing #1 or the top 10.
model NotificationSettings {
  accountId             String    @id
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  turnsEnabled          Boolean   @default(false)
  turnsArmed            Boolean   @default(false)
  turnsLastSentAt       DateTime?
  attacksEnabled        Boolean   @default(false)
  roundEnabled          Boolean   @default(false)
  rankEnabled           Boolean   @default(false)
  turfEnabled           Boolean   @default(false)
  turfEnabledAt         DateTime?
  allianceEnabled       Boolean   @default(false)
  allianceEnabledAt     DateTime?
  rankRoundId           String?
  rankLastNational      Int?
  /// Discord DMs; only delivered while Discord is linked.
  discordEnabled        Boolean   @default(true)
  /// Web Push to every registered device.
  pushEnabled           Boolean   @default(false)
  /// 0.9.0-G categories. Like the ones above they switch outside alerts (Discord, push);
  /// the in-game bell is controlled separately by `bellMuted`.
  turfPushEnabled       Boolean   @default(false)
  reinforcementsEnabled Boolean   @default(false)
  convoyEnabled         Boolean   @default(false)
  runsEnabled           Boolean   @default(false)
  revengeEnabled        Boolean   @default(false)
  ordersEnabled         Boolean   @default(false)
  announcementsEnabled  Boolean   @default(false)
  messagesEnabled       Boolean   @default(false)
  /// 1.3.0-B. A Case rising to a new Wanted stage. On by default: the ladder promises a warning.
  lawEnabled            Boolean   @default(true)
  /// 1.4.0-D. Early warnings from a faction the player is Trusted with. The bell always has them.
  factionsEnabled       Boolean   @default(false)
  /// 0.9.0-G master switch: pauses every outside alert without losing category choices.
  alertsPaused          Boolean   @default(false)
  /// 0.9.0-G quiet hours, minutes after local midnight in `timeZone`. Both set or neither;
  /// a window may wrap past midnight. The bell still records everything.
  quietStartMinute      Int?
  quietEndMinute        Int?
  timeZone              String?
  /// 0.9.0-G categories hidden from the in-game bell (their events stay in Activity).
  bellMuted             Json      @default("[]")
  updatedAt             DateTime  @updatedAt

  @@index([turnsEnabled])
}

enum NotificationChannel {
  DISCORD
  PUSH
}

/// One alert waiting for one channel. The server works out what is due once and
/// writes a row per channel; each channel claims its own rows, so none steals another's.
model NotificationOutbox {
  id        String              @id @default(cuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  /// attacks | turns | round | rank | turf | alliance
  category  String
  /// The alert itself, without any channel address (see @streets/shared NotificationPayload).
  payload   Json
  /// e.g. battle:<id>:<account>:PUSH, so a repeated collection never duplicates an alert.
  dedupeKey String              @unique
  createdAt DateTime            @default(now())
  claimedAt DateTime?

  @@index([channel, claimedAt, createdAt])
  @@index([createdAt])
}

/// A browser or phone that accepts Web Push for an account.
model PushSubscription {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  deviceLabel   String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([accountId])
}

enum AccountEmailTokenPurpose {
  VERIFY_EMAIL
  CHANGE_EMAIL
}

model AccountEmailToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  purpose  AccountEmailTokenPurpose
  newEmail String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

/// Server-side session record. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a database leak cannot be replayed as a login.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  userAgent         String?
  ip                String?
  /// rc.2. How the session signed in: PASSWORD or DISCORD. Admin tools can require DISCORD.
  method            String    @default("PASSWORD")
  /// rc.3. True when this sign-in passed an authenticator (or recovery) code.
  twoFactor         Boolean   @default(false)
  /// rc.4. "Keep me signed in": a long session that renews while used. False: ends with the
  /// browser, or after a short idle time.
  remember          Boolean   @default(true)
  /// rc.4. Hard end, however active the session is. Null on sessions from before rc.4
  /// (then createdAt plus the maximum).
  absoluteExpiresAt DateTime?
  /// rc.4. When this session last proved a second factor (Discord sign-in or a code).
  /// Admin tools need it to be recent.
  secondFactorAt    DateTime?
  /// rc.4. Wrong codes entered while signed in; too many signs the session out.
  codeFailures      Int       @default(0)

  @@index([accountId])
  @@index([expiresAt])
}

/// A single account's place in the optional capacity waiting room. This is
/// deliberately account-scoped, rather than session-scoped, so extra tabs and
/// devices cannot consume extra admission slots.
model AdmissionTicket {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roundId    String
  round      Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  lane       String
  enqueuedAt DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  admittedAt DateTime?
  canceledAt DateTime?

  @@unique([accountId, roundId])
  @@index([lane, enqueuedAt])
  @@index([canceledAt, enqueuedAt])
  @@index([roundId, lane, enqueuedAt])
}

/// Renewable account admission lease. A lease is never tied to a browser
/// session and is the only thing that permits gameplay while capacity control
/// is enabled.
model AdmissionLease {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roundId   String
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  issuedAt  DateTime @default(now())
  renewedAt DateTime @default(now())
  expiresAt DateTime

  @@unique([accountId, roundId])
  @@index([expiresAt])
  @@index([roundId, expiresAt])
}

/// One row controls admission for one round. It is seeded lazily so a migration
/// never enables a queue by accident.
model AdmissionSettings {
  id                   Int       @id @default(autoincrement())
  roundId              String    @unique
  round                Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  enabled              Boolean   @default(false)
  supporterPriority    Boolean   @default(false)
  capacity             Int?
  rotationSequence     Int       @default(0)
  renewalFailures      Int       @default(0)
  lastRenewalFailureAt DateTime?
  lastPromotionAt      DateTime?
  updatedAt            DateTime  @updatedAt
}

/// rc.3. One-use codes for signing in when the authenticator phone is lost. Only hashes are kept.
model TwoFactorRecoveryCode {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

/// rc.4. A browser that passed two-step sign-in with "Trust this browser" ticked: sign-ins
/// from it skip the code until it expires or is forgotten. The cookie holds the token;
/// only its hash is stored.
model TrustedDevice {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([accountId])
  @@index([expiresAt])
}

/// rc.5. Browsers this account has signed in from, so a sign-in from a new one can be
/// emailed about. Keyed by a hash of a long-lived per-browser cookie.
model AccountDevice {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  deviceHash  String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([accountId, deviceHash])
}

/// rc.3. A sign-in that passed the password (or Discord) and now waits for the authenticator code.
model LoginChallenge {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// PASSWORD or DISCORD: what the session will record once the code is right.
  method    String
  /// rc.4. The "Keep me signed in" choice, carried to the session the code makes.
  remember  Boolean  @default(true)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

/// rc.2. A bug a player reported from the game. Staff read and resolve these in Admin → Bug reports.
model BugReport {
  id String @id @default(cuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Kept so the report still says who sent it after the account is gone.
  username  String

  /// GAMEPLAY, DISPLAY, ACCOUNT, PERFORMANCE or OTHER.
  category   String
  summary    String
  details    String
  pagePath   String?
  userAgent  String?
  appVersion String?

  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  resolvedByUsername String?
  /// FIXED, WONT_FIX or DUPLICATE.
  resolution         String?
  /// Staff only: why it was resolved, kept in the queue and the audit log.
  resolutionNote     String?

  /// GAME (the report form) or DISCORD (/bug).
  source             String    @default("GAME")
  /// Optional words for the reporter, sent with the "your report was resolved" notice.
  playerReply        String?
  /// When that notice was collected; set at once for reports resolved before notices existed.
  reporterNotifiedAt DateTime?

  @@index([resolvedAt, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
}

/// A /support ticket: a private Discord thread between one member and staff.
/// Members without a linked game account can open one too, since "I can't sign
/// in" is exactly what support is for. One open ticket per member at a time.
model SupportTicket {
  id             String    @id @default(cuid())
  discordId      String
  /// The member's Discord name when they opened it, for staff who never see the thread.
  discordName    String
  /// Their linked game account then, if any.
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  subject        String
  /// Set once the bot has made the thread and its staff channel post.
  threadId       String?   @unique
  staffMessageId String?
  createdAt      DateTime  @default(now())
  closedAt       DateTime?
  /// Who closed it, by Discord name: the member themselves or a staff member.
  closedByName   String?

  @@index([discordId, closedAt])
  @@index([accountId, createdAt(sort: Desc)])
}

/// What the Discord bot posts to the staff channel: a new bug report, its
/// resolution (an edit of the first post), held patch notes. Claimed once, like news.
model DiscordStaffPost {
  id           String    @id @default(cuid())
  /// BUG_REPORT, BUG_REPORT_RESOLVED or PATCH_NOTES_HELD.
  kind         String
  /// The bug report or news post it is about; read fresh when the bot claims it.
  targetId     String
  createdAt    DateTime  @default(now())
  claimedAt    DateTime?
  /// The staff channel message, so a later post about the same target can edit it.
  messageId    String?
  /// Why Discord refused it, as the bot reported it.
  error        String?
  /// Last patch-notes snapshot shown in the staff channel, for in-place refreshes.
  syncedNewsAt DateTime?
  syncedState  String?

  @@index([claimedAt, createdAt])
  @@index([kind, targetId])
}

// ---------------------------------------------------------------------------
// Player surveys
// ---------------------------------------------------------------------------

/// Admin-authored feedback request. Surveys are account-scoped for completion
/// so one account can never earn the same survey reward twice, even if round
/// player state changes.
model Survey {
  id String @id @default(cuid())

  title       String
  description String
  status      SurveyStatus @default(DRAFT)

  /// Optional release/change labels such as 1.1.0-F, Stores, Combat or Mobile UI.
  releaseTag String?
  featureTag String?

  /// Null means the survey is not limited to one round.
  roundId String?
  round   Round?  @relation(fields: [roundId], references: [id], onDelete: SetNull)

  /// Reward definitions use the same shape as quest/pass rewards. Phase B/C
  /// validates and grants them; Phase A only stores the authored snapshot.
  rewards Json @default("[]")

  startsAt    DateTime?
  endsAt      DateTime?
  publishedAt DateTime?
  closedAt    DateTime?
  /// Set when the alert collector has fanned this live survey out to players.
  announcedAt DateTime?

  /// Keep the author name even if that admin account is later removed.
  createdByUsername String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions   SurveyQuestion[]
  submissions SurveySubmission[]

  @@index([status, startsAt, endsAt])
  @@index([status, announcedAt])
  @@index([roundId, status])
  @@index([releaseTag])
  @@index([featureTag])
}

/// One ordered question in a survey. Published survey structure will be treated
/// as immutable by the admin service so historical answers keep their meaning.
model SurveyQuestion {
  id String @id @default(cuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  type        SurveyQuestionType
  prompt      String
  description String?
  required    Boolean            @default(true)
  position    Int

  /// Text questions may use these; null means the service default.
  minLength Int?
  maxLength Int?

  /// Rating questions may use these; the first release supports 1..10.
  ratingMin Int?
  ratingMax Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options SurveyOption[]
  answers SurveyAnswer[]

  @@unique([surveyId, position])
  @@index([surveyId, type])
}

/// Ordered choice for SINGLE_CHOICE or MULTIPLE_CHOICE questions.
model SurveyOption {
  id String @id @default(cuid())

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Stable machine value stored in answers; label is player-facing copy.
  value    String
  label    String
  position Int

  @@unique([questionId, value])
  @@unique([questionId, position])
}

/// A completed survey. The unique account key is the duplicate-reward barrier.
/// roundPlayerId records which round player received a round-scoped reward.
model SurveySubmission {
  id String @id @default(cuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  roundPlayerId String?
  roundPlayer   RoundPlayer? @relation(fields: [roundPlayerId], references: [id], onDelete: SetNull)

  submittedAt DateTime @default(now())

  /// Exact reward definition snapshot used for this completion.
  rewardSnapshot  Json      @default("[]")
  rewardGrantedAt DateTime?

  answers SurveyAnswer[]

  @@unique([surveyId, accountId])
  @@index([surveyId, submittedAt(sort: Desc)])
  @@index([accountId, submittedAt(sort: Desc)])
  @@index([roundPlayerId])
}

/// One answer per question in one completed submission. JSON supports booleans,
/// option values, option arrays, ratings and text without lossy coercion.
model SurveyAnswer {
  id String @id @default(cuid())

  submissionId String
  submission   SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  value Json

  createdAt DateTime @default(now())

  @@unique([submissionId, questionId])
  @@index([questionId, createdAt])
}

// ---------------------------------------------------------------------------
// Rounds
// ---------------------------------------------------------------------------

enum RoundStatus {
  SCHEDULED
  REGISTRATION
  ACTIVE
  ENDED
  ARCHIVED
}

enum RoundAftermathStatus {
  PREPARING
  READY
  UNAVAILABLE
}

enum RingStatus {
  HIDDEN
  SURFACED
  DESTROYED
}

enum GameEventType {
  COMMUNITY
  SEASONAL
  RANDOM_ENCOUNTER
  CITY_CONDITION
}

enum GameEventScope {
  ROUND
  PLAYER
  CITY
}

enum GameEventOccurrenceStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum GameEventParticipationStatus {
  OFFERED
  ACTIVE
  COMPLETED
  CLAIMED
  EXPIRED
  WITHDRAWN
}

enum QuestStatus {
  LOCKED
  AVAILABLE
  ACTIVE
  READY_TO_TURN_IN
  COMPLETED
  FAILED
  EXPIRED
}

enum QuestRepeatability {
  ONCE
  DAILY
  WEEKLY
  REPEATABLE
}

enum SurveyStatus {
  DRAFT
  SCHEDULED
  LIVE
  CLOSED
}

enum SurveyQuestionType {
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  SHORT_TEXT
  LONG_TEXT
}

/// Relationship standing for one player. Historically this held store-trader
/// standing only; the unified Jobs system also stores named contact reputation
/// here so old rounds and current contacts can coexist without copying scores.
model PlayerReputation {
  id            String @id @default(cuid())
  roundPlayerId String
  /// Relationship key. Historical store keys include CORNER/TOMMY/CHARLIE/PIP;
  /// current job contacts may also use MAMA_KING/WHEELS/VIC/BLOCKS.
  trader        String

  points      Int       @default(0)
  /// Day the regular-trade credit was last paid, so it can be paid at most
  /// once a day without keeping a history of every trade.
  creditedOn  DateTime?
  /// Legacy one-favor completion marker. Current Jobs use PlayerQuest instead.
  questDoneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roundPlayer RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  @@unique([roundPlayerId, trader])
  @@index([roundPlayerId])
}

// ---------------------------------------------------------------------------
// Consumable favor inventory
// ---------------------------------------------------------------------------

model PlayerFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// Stable ruleset-defined favor key.
  key                String
  quantity           Int     @default(0)
  totalGranted       Int     @default(0)
  /// Most recent job that added this favor to the stack.
  lastSourceQuestKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, key])
  @@index([roundPlayerId, updatedAt])
  @@index([key])
}

// ---------------------------------------------------------------------------
// Admin favor content controls
// ---------------------------------------------------------------------------

/// Per-ruleset emergency switch for favor effects. Missing rows mean enabled,
/// so pinned rulesets keep their original behavior until an admin intervenes.
model FavorContentSetting {
  id String @id @default(cuid())

  rulesetId      String
  rulesetVersion String
  key            String
  isEnabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rulesetId, rulesetVersion, key])
  @@index([rulesetId, rulesetVersion, isEnabled])
}

// ---------------------------------------------------------------------------
// Active timed favors
// ---------------------------------------------------------------------------

model PlayerActiveFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// STREET, UNDERWORLD or MUSCLE. Only one live timed favor per category.
  category  String
  favorKey  String
  startedAt DateTime
  expiresAt DateTime

  @@unique([roundPlayerId, category])
  @@index([roundPlayerId, expiresAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Armed single-use favors
// ---------------------------------------------------------------------------

model PlayerArmedFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  category String
  favorKey String
  armedAt  DateTime @default(now())

  @@unique([roundPlayerId, category])
  @@index([roundPlayerId, favorKey])
}

// ---------------------------------------------------------------------------
// Round Roll Call (docs/ROUND-ROLL-CALL.md)
// ---------------------------------------------------------------------------

/// A stamp is an authenticated foreground visit to one server-side round day.
model RoundLoginCheckIn {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  dayIndex      Int
  checkedInAt   DateTime    @default(now())
  /// LOGIN is an actual foreground check-in, RECOVERY is an audited missed-day repair.
  source        String      @default("LOGIN")

  @@unique([roundPlayerId, dayIndex])
  @@index([roundPlayerId, checkedInAt])
}

/// One bounded, account-owned, server-verified recovery of a missed round day.
/// No purchases, transferable tokens, or privileged shortcuts may create this receipt.
model RoundLoginRecovery {
  id             String      @id @default(cuid())
  roundPlayerId  String
  roundPlayer    RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  dayIndex       Int
  actionId       String
  actorAccountId String
  reason         String      @default("SELF_SERVICE")
  stampsBefore   Int
  missedBefore   Int
  createdAt      DateTime    @default(now())

  @@unique([roundPlayerId, dayIndex])
  @@unique([roundPlayerId, actionId])
  @@index([roundPlayerId, createdAt])
}

/// One atomic paid reward step; ownership and payout are per round player.
/// Cosmetics in Slice D will separately use persistent AccountCosmeticUnlock.
model RoundLoginRewardClaim {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  tier          Int
  rewardVersion String
  rarity        String
  /// Stable snapshot of what was actually awarded, including amounts in cents.
  definition    Json
  claimedAt     DateTime    @default(now())

  @@unique([roundPlayerId, tier])
  @@index([roundPlayerId, claimedAt])
}

// ---------------------------------------------------------------------------
// Street Pass (docs/STREET-PASS.md)
// ---------------------------------------------------------------------------

/// A player's Street Cred for the round's pass. Created on the first Cred earned.
model StreetPassProgress {
  id String @id @default(cuid())

  roundPlayerId String      @unique
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// The ruleset's streetPass.key, e.g. street-pass-s1.
  passKey                Strin…32185 tokens truncated…oundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  chipsCents BigInt   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roundPlayerId, cityId])
  @@index([cityId])
}

/// One in-person casino bankroll. Later games mutate bankrollCents under the same player lock.
model CasinoSession {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  status        String    @default("OPEN")
  bankrollCents BigInt
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ledger         CasinoLedgerEntry[]
  sportsbookBets SportsbookBet[]

  @@index([roundPlayerId, status, openedAt(sort: Desc)])
  @@index([cityId, status])
}

/// 1.2.0-B. One durable non-retriggering free-spin bundle per player.
/// The wager configuration that earned it is frozen until the bundle is consumed.
model CasinoFreeSpinBonus {
  id String @id @default(cuid())

  roundPlayerId String      @unique
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  citySlug          String
  machineKey        String
  betPerLineCents   BigInt
  activePaylineKeys Json
  awardedSpins      Int
  remainingSpins    Int
  totalWonCents     BigInt   @default(0)
  sourceActionId    String
  awardedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([machineKey])
  @@index([citySlug])
}

/// 1.2.0-C. Server-owned shuffled shoe for one player/table.
/// The cursor advances only under the RoundPlayer row lock.
model CasinoBlackjackShoe {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  tableKey      String
  cards         Json
  cursor        Int      @default(0)
  shuffleNumber Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([roundPlayerId, tableKey])
  @@index([tableKey])
}

/// 1.2.0-C. Reconnect-safe blackjack hand. Player/dealer cards and split-hand
/// state stay server-owned; settled rows double as durable hand history.
model CasinoBlackjackHand {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  sessionId           String
  cityId              String
  tableKey            String
  status              String    @default("ACTIVE")
  wagerCents          BigInt
  committedWagerCents BigInt
  playerHands         Json
  dealerCards         Json
  activeHandIndex     Int       @default(0)
  totalReturnCents    BigInt    @default(0)
  bankrollAfterCents  BigInt    @default(0)
  shoeRemainingCards  Int       @default(0)
  shuffleNumber       Int       @default(1)
  initialActionId     String
  settledAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([roundPlayerId, initialActionId])
  @@index([roundPlayerId, status, createdAt(sort: Desc)])
  @@index([sessionId, status])
  @@index([cityId, createdAt(sort: Desc)])
}

/// Idempotency receipt for blackjack Deal / Hit / Stand / Double / Split.
/// response is the exact post-action hand snapshot returned on retry.
model CasinoBlackjackAction {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  handId    String
  actionId  String
  kind      String
  response  Json
  createdAt DateTime @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([handId, createdAt])
}

/// Reconnect-safe eight-ball rack against a house hustler. The rack JSON holds both
/// groups, ball in hand and the shot log; settled rows double as game history.
model CasinoPoolGame {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  sessionId           String
  cityId              String
  tableKey            String
  status              String    @default("ACTIVE")
  wagerCents          BigInt
  /// The opening wager plus any press.
  committedWagerCents BigInt
  pressed             Boolean   @default(false)
  rack                Json
  totalReturnCents    BigInt    @default(0)
  bankrollAfterCents  BigInt    @default(0)
  initialActionId     String
  settledAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([roundPlayerId, initialActionId])
  @@index([roundPlayerId, status, createdAt(sort: Desc)])
  @@index([sessionId, status])
  @@index([cityId, createdAt(sort: Desc)])
}

/// Idempotency receipt for Pool Rack / Shot / Press, holding the exact response.
model CasinoPoolAction {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  gameId    String
  actionId  String
  kind      String
  response  Json
  createdAt DateTime @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([gameId, createdAt])
}

/// 1.2.0-E. Server-owned solo Hold’em hand. The JSON game state includes bot cards
/// and is never returned directly; the service builds viewer-safe DTOs from it.
model CasinoPokerHand {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  sessionId          String
  cityId             String
  tableKey           String
  status             String    @default("ACTIVE")
  buyInCents         BigInt
  state              Json
  bankrollAfterCents BigInt
  initialActionId    String
  settledAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([roundPlayerId, initialActionId])
  @@index([roundPlayerId, status, createdAt(sort: Desc)])
  @@index([sessionId, status])
  @@index([cityId, createdAt(sort: Desc)])
}

/// Idempotent action receipt for solo Hold’em, including the exact safe response.
model CasinoPokerAction {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  handId    String
  actionId  String
  kind      String
  response  Json
  createdAt DateTime @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([handId, createdAt])
}

/// 1.2.0-F. Multiplayer Hold’em lobby table; gameplay is added in the next slice.
model CasinoPokerTable {
  id                   String                 @id @default(cuid())
  roundId              String
  round                Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  cityId               String
  name                 String
  visibility           String                 @default("PUBLIC")
  inviteCodeHash       String?
  creatorRoundPlayerId String
  createActionId       String
  maxPlayers           Int                    @default(6)
  buyInCents           BigInt
  status               String                 @default("WAITING")
  dealerSeatNo         Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  seats                CasinoPokerSeat[]
  hands                CasinoPokerTableHand[]

  @@unique([creatorRoundPlayerId, createActionId])
  @@index([roundId, status, visibility, createdAt])
  @@index([cityId, status])
}

model CasinoPokerSeat {
  id            String           @id @default(cuid())
  tableId       String
  table         CasinoPokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  roundPlayerId String
  roundPlayer   RoundPlayer      @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  sessionId     String
  actionId      String
  seatNo        Int
  stackCents    BigInt
  status        String           @default("WAITING")
  joinedAt      DateTime         @default(now())
  leftAt        DateTime?

  @@unique([tableId, seatNo])
  @@unique([roundPlayerId, actionId])
  @@index([roundPlayerId, status])
  @@index([tableId, status, seatNo])
}

model CasinoPokerTableHand {
  id        String                   @id @default(cuid())
  tableId   String
  table     CasinoPokerTable         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  handNo    Int
  status    String                   @default("ACTIVE")
  state     Json
  outcome   String?
  startedAt DateTime                 @default(now())
  settledAt DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  actions   CasinoPokerTableAction[]

  @@unique([tableId, handNo])
  @@index([tableId, status, handNo])
}

model CasinoPokerTableAction {
  id            String               @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer          @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  handId        String
  hand          CasinoPokerTableHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  actionId      String
  kind          String
  response      Json
  createdAt     DateTime             @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([handId, createdAt])
}

/// Immutable retry receipt for every casino money movement.
model CasinoLedgerEntry {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  sessionId String?
  session   CasinoSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  actionId               String
  kind                   String
  cashDeltaCents         BigInt   @default(0)
  walletChipDeltaCents   BigInt   @default(0)
  sessionChipDeltaCents  BigInt   @default(0)
  walletChipsAfterCents  BigInt
  sessionChipsAfterCents BigInt   @default(0)
  metadata               Json     @default("{}")
  createdAt              DateTime @default(now())

  @@unique([roundPlayerId, actionId])
  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@index([cityId, createdAt(sort: Desc)])
}

/// 1.2.0-E. Rated play for one player at one city's casino. Every charged wager adds its
/// theoretical house win (wager x pinned edge), never its result. Network status is the
/// sum of theo across cities; comps are earned as a share of theo and spent on Boss Trip
/// hotel nights. Basis columns hold cents x basis points so small wagers lose nothing to
/// rounding; whole cents are basis / 10,000. Status and comps never feed any game's odds.
model CasinoRating {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// Charged chips wagered here. Free spins and comped play add nothing.
  wageredCents    BigInt    @default(0)
  /// Theoretical house win in cents x bps.
  theoBasis       BigInt    @default(0)
  /// Comps earned here in cents x bps.
  compBasis       BigInt    @default(0)
  /// Whole comp cents redeemed while the boss was in this city.
  compsSpentCents BigInt    @default(0)
  ratedWagers     Int       @default(0)
  /// 1.2.0-F. Season casino feats: wagers placed at VIP tables, progressive jackpots hit,
  /// and the biggest net win on one settled hand, spin, roll or poker hand.
  vipWagers       Int       @default(0)
  jackpots        Int       @default(0)
  biggestWinCents BigInt    @default(0)
  lastRatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([roundPlayerId, cityId])
  @@index([cityId])
}

/// 1.2.0-B. One progressive pool per round/machine. It is house money, never player net worth.
model CasinoJackpot {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  machineKey String
  poolCents  BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roundId, machineKey])
  @@index([machineKey])
}

/// 1.8.0-A. Shared, server-cached pregame moneyline snapshot from the active provider.
/// Player reads never call the provider; refreshes are performed by one background poller.
model SportsbookEvent {
  id String @id @default(cuid())

  providerEventId    String    @unique
  sport              String
  homeTeam           String
  awayTeam           String
  startsAt           DateTime
  status             String    @default("PRE")
  homeOdds           Int?
  awayOdds           Int?
  homeScore          Int?
  awayScore          Int?
  oddsUpdatedAt      DateTime?
  /// Slice B. Provider currently supplying the canonical event's prices.
  oddsProvider       String    @default("therundown")
  settledAt          DateTime?
  /// Provider (or later, provider set) that supplied the grading result.
  settledProvider    String    @default("")
  lastSeenAt         DateTime  @default(now())
  /// 1.8.0-C. Result checks are paced per event, so a long game does not spend a datapoint every poll.
  resultCheckCount   Int       @default(0)
  resultCheckedAt    DateTime?
  nextResultCheckAt  DateTime?
  resultError        String    @default("")
  /// Slice D. Why this event needs staff attention (disagreement, one cancellation, or no result after 72h).
  resultReviewReason String    @default("")
  resultReviewAt     DateTime?
  /// How the result was graded: FEED, ADMIN_RECHECK, ADMIN_RESOLUTION or ADMIN_VOID ('' until settled).
  settledVia         String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bets    SportsbookBet[]
  sources SportsbookEventSource[]

  @@index([sport, startsAt, status])
  @@index([status, settledAt])
  @@index([resultReviewAt])
}

/// Slice B. One provider's listing of a canonical sportsbook event.
model SportsbookEventSource {
  id String @id @default(cuid())

  eventId String
  event   SportsbookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  provider          String
  providerEventId   String
  status            String    @default("PRE")
  homeOdds          Int?
  awayOdds          Int?
  homeScore         Int?
  awayScore         Int?
  lastSeenAt        DateTime  @default(now())
  resultCheckCount  Int       @default(0)
  resultCheckedAt   DateTime?
  nextResultCheckAt DateTime?
  resultError       String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, providerEventId])
  @@index([provider, nextResultCheckAt])
  @@index([eventId])
}

/// Provider quota and last successful snapshot time; one row per provider id.
/// The datapoints* columns hold the adapter's billing units (datapoints, credits or objects).
model SportsbookProviderState {
  id String @id @default("therundown")

  lastPolledAt         DateTime?
  lastDatapoints       Int       @default(0)
  datapointsUsed       Int       @default(0)
  datapointsLimit      Int       @default(0)
  datapointsRemaining  Int?
  datapointsPeriod     String    @default("")
  quotaObservedAt      DateTime?
  lastErrorAt          DateTime?
  lastError            String    @default("")
  /// 1.8.0-C. lastPolledAt is the last successful odds snapshot; lastAttemptAt is the last try.
  lastAttemptAt        DateTime?
  lastResultCheckAt    DateTime?
  consecutiveFailures  Int       @default(0)
  /// Slice C. Successful provider runs used for sticky-primary recovery.
  consecutiveSuccesses Int       @default(0)
  lastSuccessAt        DateTime?
  /// Three provider-wide failed runs open the circuit for 30 minutes.
  circuitOpenUntil     DateTime?
  /// One poller at a time across server instances; cleared when a refresh finishes.
  pollLeaseUntil       DateTime?
  /// League key -> { lastAttemptAt, lastSuccessAt, lastError, lastErrorAt, eventsSeen }.
  leagueStatus         Json      @default("{}")
  updatedAt            DateTime  @updatedAt
}

/// Slice C. Sticky odds source and optional staff override for one league.
model SportsbookLeagueProviderState {
  league String @id

  activeOddsProvider String   @default("therundown")
  activeSince        DateTime @default(now())
  pinnedOddsProvider String?
  updatedAt          DateTime @updatedAt

  @@index([activeOddsProvider])
}

/// 1.8.0-E. One row per feed run that held the lease, kept 90 days, for reviewing provider usage.
model SportsbookFeedRun {
  id String @id @default(cuid())

  startedAt       DateTime
  provider        String   @default("therundown")
  oddsPolled      Boolean
  requests        Int
  datapoints      Int
  snapshots       Int
  failedSnapshots Int
  pulled          Int
  resultChecks    Int
  settled         Int
  /// Listings that could not be safely matched to a canonical game during this run.
  matcherMisses   Int      @default(0)
  /// Per league: attempted, served, primary, switched and matcherMisses.
  leagueActivity  Json     @default("{}")
  failed          Boolean
  error           String   @default("")

  @@index([startedAt])
}

/// An immutable casino-chip wager. Price/payout and the originating casino bankroll are
/// pinned at acceptance; actionId makes retries a single charge. Nullable casino fields
/// preserve settlement of legacy tickets created before sportsbook chip origins were stored.
model SportsbookBet {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer     @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  eventId       String
  event         SportsbookEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  casinoSessionId String?
  casinoSession   CasinoSession? @relation(fields: [casinoSessionId], references: [id], onDelete: SetNull)
  casinoCityId    String?
  casinoCity      City?          @relation("SportsbookBetCasinoCity", fields: [casinoCityId], references: [id], onDelete: SetNull)

  actionId             String
  /// Provider whose displayed price was pinned when the ticket was accepted.
  oddsProvider         String    @default("therundown")
  selection            String
  oddsAmerican         Int
  stakeCents           BigInt
  payoutCents          BigInt
  status               String    @default("OPEN")
  settledAt            DateTime?
  startedNotifiedAt    DateTime?
  settlementNotifiedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([roundPlayerId, actionId])
  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([eventId, status])
  @@index([status, startedNotifiedAt])
  @@index([casinoSessionId])
  @@index([casinoCityId, status])
}

/// 0.6.0-D. The box attached to one away-held block. A home block never needs one.
/// Runs are the only intended way to move stock in or out; later D slices enforce that.
model TurfOutpost {
  id String @id @default(cuid())

  turfId String @unique
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  ownerId String
  owner   RoundPlayer @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  cashCents BigInt @default(0)
  beer      Int    @default(0)
  /// Product-key -> quantity. Crack is stored here too because this is not home inventory.
  products  Json   @default("{}")

  /// Trips D2. The boss walked this corner: its crew stays put until `moraleUntil`.
  visitedAt   DateTime?
  moraleUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// 0.6.0-A. Turns a crew has worked on a block lately. You cannot claim a block you have
/// never worked, and presence fades on the ruleset's half-life, settled from `at` on read.
model TurfPresence {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Ruleset district key, e.g. CASINO.
  district String

  /// Turns worked, as of `at`. Faded on read, never by a sweep.
  turns Float    @default(0)
  at    DateTime @default(now())

  @@unique([roundPlayerId, cityId, district])
}

/// 0.6.0-C. A player-vs-player attempt to take one block. The attacking squad
/// is committed at start and the fight lands after the warning window.
enum TurfPushStatus {
  PENDING
  LANDED
}

model TurfPush {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  attackerId         String
  attacker           RoundPlayer @relation("TurfPushAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  /// Alliance snapshots make shared revenge stable if either player later leaves.
  attackerAllianceId String?

  /// Holder when the push started. The block may be abandoned before it lands.
  defenderId         String
  defender           RoundPlayer @relation("TurfPushDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  defenderAllianceId String?

  squad              Int
  /// Morale and the exact guns committed from home.
  attackerCrew       Json
  turnsSpent         Int
  actionId           String
  startedAt          DateTime
  landsAt            DateTime
  status             TurfPushStatus   @default(PENDING)
  settledAt          DateTime?
  /// True only when this push actually transferred the block to the attacker.
  captured           Boolean          @default(false)
  result             Json?
  attackerCreditedAt DateTime?
  alliesCalledAt     DateTime?
  /// Public turf-feed claim, parallel to RaidBattle.discordPostedAt.
  discordPostedAt    DateTime?
  /// 0.9.0-G. When the holder was told their block is being pushed (once their Lookouts saw it),
  /// and when their alliance was told about the call for help.
  defenderAlertedAt  DateTime?
  alliesAlertedAt    DateTime?
  /// Private notification collection is independent from the public feed.
  alertsCollectedAt  DateTime?
  backups            TurfPushBackup[]

  @@unique([attackerId, actionId])
  @@index([turfId, status])
  @@index([roundId, status, landsAt])
  @@index([roundId, captured, settledAt(sort: Desc)])
  @@index([alertsCollectedAt, settledAt])
  @@index([attackerId, turfId, startedAt(sort: Desc)])
  @@index([attackerId, captured, settledAt(sort: Desc)])
  @@index([defenderAllianceId, attackerId, captured, settledAt(sort: Desc)])
  @@index([attackerId, attackerCreditedAt])
}

/// Real home/alliance help committed to a pending turf push. C landing decides
/// whether an ally's uncertain reinforcement actually arrives.
model TurfPushBackup {
  id String @id @default(cuid())

  pushId String
  push   TurfPush @relation(fields: [pushId], references: [id], onDelete: Cascade)

  playerId String
  player   RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  /// OWNER or ALLY.
  kind       String
  thugs      Int
  crew       Json
  sentAt     DateTime
  showedUp   Boolean?
  wounded    Int       @default(0)
  creditedAt DateTime?

  @@unique([pushId, playerId])
  @@index([playerId, creditedAt])
}

/// 0.6.0-E. One continuous stretch where a crew held a block with one alliance
/// identity. Alliance membership changes split the segment so old hours never move
/// retroactively to a new alliance.
model TurfHoldSegment {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  holderId String
  holder   RoundPlayer @relation(fields: [holderId], references: [id], onDelete: Cascade)

  holderPublicPimpId Int
  holderName         String

  /// Snapshot only. We deliberately do not FK this because disband/rename history must survive.
  allianceId   String?
  allianceName String?
  allianceTag  String?

  startedAt DateTime
  endedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([roundId, holderId, startedAt])
  @@index([roundId, allianceId, startedAt])
  @@index([turfId, endedAt])
}

/// 0.6.0-E. One durable alliance city-control change. Snapshot names/tags keep
/// history readable if an alliance later renames or disbands.
model TurfControlEvent {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  previousAllianceId   String?
  previousAllianceName String?
  previousAllianceTag  String?
  nextAllianceId       String?
  nextAllianceName     String?
  nextAllianceTag      String?

  previousBlocksHeld Int @default(0)
  nextBlocksHeld     Int @default(0)
  blocksTotal        Int

  happenedAt        DateTime
  discordPostedAt   DateTime?
  alertsCollectedAt DateTime?

  @@index([roundId, happenedAt(sort: Desc)])
  @@index([discordPostedAt, happenedAt])
  @@index([alertsCollectedAt, happenedAt])
}

/// 0.6.0-F. One seeded late-round Federal sweep. The target and clock are fixed per
/// round, so the warning and the sweep can be replayed/idempotently claimed by Discord.
model TurfCrackdown {
  id String @id @default(cuid())

  roundId String @unique
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  warningAt DateTime
  sweepAt   DateTime
  sweptAt   DateTime?

  holdersAffected Int  @default(0)
  thugsPickedUp   Int  @default(0)
  /// Per-holder result snapshots for receipts/feed summaries.
  results         Json @default("[]")

  warningDiscordPostedAt DateTime?
  sweepDiscordPostedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warningAt])
  @@index([sweepAt, sweptAt])
  @@index([warningDiscordPostedAt, warningAt])
  @@index([sweepDiscordPostedAt, sweepAt])
}

/// 0.6.0-B. The daily turf-tax cap is per payer and holder. The worker's burn is not
/// stored here; only the minted holder share needs a cap and a dashboard/history read.
model TurfTaxLedger {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  payerId String
  payer   RoundPlayer @relation("TurfTaxPayer", fields: [payerId], references: [id], onDelete: Cascade)

  holderId String
  holder   RoundPlayer @relation("TurfTaxHolder", fields: [holderId], references: [id], onDelete: Cascade)

  /// UTC calendar day, stored at midnight.
  day DateTime

  mintedCents   BigInt @default(0)
  /// House-minted tax already credited to the holder's home cash or, in 0.6.0-D, an outpost box.
  creditedCents BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, payerId, holderId, day])
  @@index([roundId, holderId, day])
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

/// Short-lived record of a completed resource-changing action. A repeated
/// actionId replays the stored result instead of executing twice.
model ProcessedAction {
  id String @id @default(cuid())

  /// Client generated. Scoped to the player, so one player's action id can
  /// never collide with or block another's.
  actionId String

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  action String
  result Json

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([roundPlayerId, actionId])
  @@index([expiresAt])
}

/// 1.0.0-E. Something the server refused because it looked like an exploit or a bug:
/// a database guard, a broken invariant, a hit between linked accounts, a flood of
/// refused requests. The same thing from the same account on the same day folds into
/// one row. No foreign keys: a flag outlives what it points at.
model ExploitFlag {
  id            String   @id @default(cuid())
  fingerprint   String   @unique
  kind          String
  /// info, warning or critical.
  severity      String   @default("warning")
  accountId     String?
  roundPlayerId String?
  roundId       String?
  route         String?
  message       String
  detail        Json?
  occurrences   Int      @default(1)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  reviewedAt         DateTime?
  reviewedByUsername String?
  /// dismissed or actioned.
  resolution         String?
  reviewNote         String?

  @@index([reviewedAt, lastSeenAt(sort: Desc)])
  @@index([accountId, lastSeenAt(sort: Desc)])
}

/// 1.1.0-D. A block war against a player-held block: declared, opened with a fight, then a
/// siege that builds Control until the attacker wins, or the holder breaks it, concedes, or
/// the time limit runs out. Everything is settled lazily, like turf pushes.
model BlockWar {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  turfId String
  turf   Turf   @relation(fields: [turfId], references: [id], onDelete: Cascade)

  attackerId         String
  attacker           RoundPlayer @relation("BlockWarAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  attackerAllianceId String?
  defenderId         String
  defender           RoundPlayer @relation("BlockWarDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  defenderAllianceId String?

  goal       BlockWarGoal
  status     BlockWarStatus @default(OPENING)
  actionId   String
  declaredAt DateTime
  endsBy     DateTime

  /// Control 0..100, as of `controlAt`, while a siege is on.
  control        Float     @default(0)
  controlAt      DateTime?
  siegeSince     DateTime?
  /// Every hour of siege so far, and every fight, for fatigue.
  siegeHours     Float     @default(0)
  fights         Int       @default(0)
  /// After a lost assault or a broken siege, when the declarer may assault again.
  nextAssaultAt  DateTime?
  fatigueAtStart Float     @default(0)

  /// One ally slot per side for the whole war, the cut its caller promised (0..0.5), the
  /// call's open window, and whether the ally actually fought.
  attackerAllyId     String?
  defenderAllyId     String?
  attackerCut        Float     @default(0)
  defenderCut        Float     @default(0)
  attackerCallUntil  DateTime?
  defenderCallUntil  DateTime?
  attackerAllyFought Boolean   @default(false)
  defenderAllyFought Boolean   @default(false)

  winner                  BlockWarSide?
  /// CONTROL, CONCEDED, WITHDREW, TIMEOUT, ABANDONED or CUTOFF.
  endReason               String?
  endedAt                 DateTime?
  result                  Json?
  /// The public Discord street feed: when the declaration and the end were posted.
  discordDeclaredPostedAt DateTime?
  discordEndedPostedAt    DateTime?

  squads    BlockWarSquad[]
  fightRows BlockWarFight[]

  @@unique([attackerId, actionId])
  @@index([turfId, status])
  @@index([roundId, status])
  @@index([attackerId, status])
  @@index([defenderId, status])
}

/// A fight in a block war: the opening fight, a re-assault after a lost one, or the holder's
/// attempt to break the siege. It lands at `landsAt`, after the warning or muster window.
model BlockWarFight {
  id String @id @default(cuid())

  warId String
  war   BlockWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  kind      BlockWarFightKind
  startedAt DateTime
  landsAt   DateTime
  /// PENDING, LANDED or CANCELLED.
  status    String            @default("PENDING")
  result    Json?

  @@index([warId, status])
}

/// Thugs (and their guns) a crew has committed to a block war: the declarer's squad, the
/// holder's backup, an ally. They leave home while committed, like a push squad, and come
/// back through the player's own credit pass, so nobody else's row is written for them.
model BlockWarSquad {
  id String @id @default(cuid())

  warId String
  war   BlockWar @relation(fields: [warId], references: [id], onDelete: Cascade)

  playerId String
  player   RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  side            BlockWarSide
  /// DECLARER, HOLDER or ALLY.
  role            String
  /// The fight it was sent to, or null for the occupying squad's siege presence.
  fightId         String?
  sent            Int
  /// Still deployed. Wounded thugs go home as they are hurt; the rest when it is released.
  thugs           Int
  wounded         Int          @default(0)
  /// Morale and the exact guns committed from home.
  crew            Json
  active          Boolean      @default(true)
  recoverAt       DateTime?
  /// On a Take, the declarer's thugs that stay on as the new corner crew.
  posted          Int          @default(0)
  /// Paid with the squad's final credit: Sack loot or an ally's cut, and Heat.
  payoutCents     BigInt       @default(0)
  heat            Int          @default(0)
  /// What the owner's credit pass has already taken back.
  creditedThugs   Int          @default(0)
  creditedWounded Int          @default(0)
  gunsCreditedAt  DateTime?
  createdAt       DateTime     @default(now())

  @@index([playerId, active])
  @@index([warId, active])
}

enum BlockWarGoal {
  TAKE
  SACK
}

enum BlockWarStatus {
  OPENING
  SIEGE
  BETWEEN
  ENDED
}

enum BlockWarSide {
  ATTACKER
  DEFENDER
}

enum BlockWarFightKind {
  OPENING
  ASSAULT
  BREAK
}

// ---------------------------------------------------------------------------
// Law enforcement (1.3.0)
// ---------------------------------------------------------------------------

/// 1.3.0-A. One city's Case on one player: what that city's police have on them. Stored
/// in hundredths of a point (the ruleset's caseMax x 100 at most). Private to its player,
/// and gone with the round like every RoundPlayer row. Heat is unaffected by it.
model PlayerCase {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  caseHundredths Int       @default(0)
  /// The Wanted stage the Case last read as; a rise logs CASE_STAGE_UP once.
  stage          String    @default("QUIET")
  /// 1.3.0-B. When `caseHundredths` was last brought up to date. Cooling after it is worked
  /// out on read and written as a COOLING receipt with the next change.
  caseAt         DateTime  @default(now())
  /// 1.3.0-B. The player's last act that added evidence here. Cooling starts a quiet spell after it.
  lastEvidenceAt DateTime?
  /// 1.3.0-B. Cash moved in this city on `reportDay` (UTC), for currency reports.
  reportDay      String?
  reportCents    BigInt    @default(0)
  /// 1.3.0-F. The highest stage this Case has reached since it last left Quiet, and when it
  /// left Quiet. Both reset when it cools back to Quiet. Ledger's Jobs read them.
  peakStage      String    @default("QUIET")
  openedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, cityId])
  @@index([cityId])
}

/// 1.3.0-A. An itemised, immutable change to a Case: why it exists. Keyed on the act that
/// caused it, so a retried action or a re-run settle never adds evidence twice.
model PlayerCaseReceipt {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// What drew it: SCOUT, PRODUCE, RUN_SALE, COMBAT, CONVOY, TORCH, SACK, RACKETS, CRACKDOWN,
  /// and from 1.3.0-B BUST, ARREST, ROAD_STOP, HIJACK, CURRENCY_REPORT, LAUNDERING and COOLING.
  source              String
  sourceKey           String
  /// Heat the act drew, before the Heat meter's cap.
  heat                Float
  deltaHundredths     Int
  caseAfterHundredths Int
  stageAfter          String
  /// 1.3.0-B. This change took the Case to a higher stage; the alert collector tells the player.
  stageUp             Boolean   @default(false)
  alertsCollectedAt   DateTime?
  createdAt           DateTime  @default(now())

  @@unique([roundPlayerId, sourceKey])
  @@index([stageUp, alertsCollectedAt])
  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([roundPlayerId, cityId, createdAt(sort: Desc)])
}

/// 1.3.0-C. A warrant a city's police drafted when the player's Case there reached the Warrant
/// stage. It names one target and is served at `servesAt` unless answered first. A personal
/// warrant past `servesAt` waits (WAITING) until the boss is in that city, or the round ends.
model PlayerWarrant {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// HIDEOUT, BUSINESS or PERSONAL.
  target     String
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  /// OPEN, WAITING, SERVED, LAWYERED, or (1.3.0-D) QUASHED by a District Attorney.
  status     String    @default("OPEN")
  draftedAt  DateTime
  servesAt   DateTime
  resolvedAt DateTime?
  /// What serving or answering it did: seizures, fines, the shut window, the lock-up, or the fee.
  outcome    Json      @default("{}")

  /// Alert collection markers, one per event the player is told about.
  draftAlertedAt    DateTime?
  waitingAlertedAt  DateTime?
  resolvedAlertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roundPlayerId, status])
  @@index([status, servesAt])
  @@index([cityId])
  @@index([businessId])
}

/// 1.3.0-D. A corrupt official on one player's payroll in one city: a Precinct Captain, a
/// District Attorney, a Judge or a Customs Officer. Paid by the week; works only while paid.
/// Every favor adds exposure; past the line Internal Affairs opens a file, and an official
/// still on the books when `stingAt` comes is stung, which ends them and adds evidence.
model PlayerOfficial {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  cityId String
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// CAPTAIN, DA, JUDGE or CUSTOMS.
  role         String
  /// ACTIVE (working while `paidUntil` is ahead), CUT (let go) or STUNG (caught by Internal Affairs).
  status       String    @default("ACTIVE")
  hiredAt      DateTime
  paidUntil    DateTime
  /// Exposure points from favors. Starts again from zero with each new hire.
  exposure     Int       @default(0)
  /// Internal Affairs opened a file at `iaOpenedAt`; the sting lands at `stingAt` unless cut first.
  iaOpenedAt   DateTime?
  stingAt      DateTime?
  /// A DA can quash again from here.
  quashReadyAt DateTime?
  endedAt      DateTime?

  /// Alert collection markers.
  iaAlertedAt    DateTime?
  stungAlertedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, cityId, role])
  @@index([status, stingAt])
  @@index([cityId])
}

/// 1.3.0-D. A tip bought from an informant: information, never protection. SWEEP names the
/// federal sweep's city and time before it is public; CITY names a city's police lines.
model PlayerTip {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  kind    String
  cityId  String?
  city    City?   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  payload Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([cityId])
}

/// 1.4.0-B. A player's seasonal standing with one faction. Starts at zero every round; only the
/// player's own one-time Jobs add to it, each with a receipt.
model PlayerFactionStanding {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// KINGS, OUTFIT, ROAD_SAINTS, CARTEL_LINE or CIVIC_HANDSHAKE.
  factionKey          String
  points              Int       @default(0)
  /// The tier the standing last read as; a rise logs FACTION_TIER_UP once.
  tier                String    @default("UNKNOWN")
  /// 1.4.0-F. When the player reached Inner Circle, and when the street feed posted it.
  innerCircleAt       DateTime?
  innerCirclePostedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, factionKey])
  @@index([innerCirclePostedAt, innerCircleAt])
}

/// 1.4.0-B. An immutable change to faction standing, keyed on the act that caused it so a retry
/// never pays twice. The receipts always add up to the stored standing.
model PlayerFactionReceipt {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  factionKey  String
  /// JOB (a one-time Job), CONTRACT (a sponsored board contract, 1.4.0-C), later ADMIN and others.
  source      String
  sourceKey   String
  delta       Int
  pointsAfter Int
  tierAfter   String

  createdAt DateTime @default(now())

  @@unique([roundPlayerId, sourceKey])
  @@index([roundPlayerId, factionKey, createdAt])
}

/// 1.4.0-D. A Connected nudge taking effect: which faction, which nudge, the percent the ruleset
/// pinned, and what it saved. Keyed on the act it applied to, so a retried action or a re-run
/// settle never logs twice. Read-only to play; G's admin view audits it.
model PlayerFactionPerkUse {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  factionKey String
  /// CORNER_UPKEEP, TOMMY_WEAPONS, BODYGUARD_TICKETS, PIP_PRODUCT or OFFICIAL_EXPOSURE.
  kind       String
  sourceKey  String
  percent    Int
  /// What it saved: { cents }, { beer, product } or { exposure }.
  saved      Json

  createdAt DateTime @default(now())

  @@unique([roundPlayerId, sourceKey])
  @@index([roundPlayerId, factionKey, createdAt])
}

/// 1.4.0-D. An early warning from a faction the player is Trusted with that has reached the bell.
/// Keyed on the warning itself (a shield, a run's leg, a drought, a Case nearing a stage), so the
/// alert sweep sends each warning once however often it looks.
model PlayerFactionWarning {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  factionKey        String
  warningKey        String
  /// What the warning said and where it pointed, for the push and Discord alert.
  text              String    @default("")
  href              String    @default("/game/quests#factions")
  /// When the alert collector turned it into push and Discord alerts.
  alertsCollectedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([roundPlayerId, warningKey])
  @@index([alertsCollectedAt, createdAt])
}

model CityMemoryEvent {
  id                String             @id @default(cuid())
  criminalCaseFiles CriminalCaseFile[]
  roundId           String
  round             Round              @relation(fields: [roundId], references: [id], onDelete: Cascade)
  cityId            String
  city              City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  kind              String
  visibility        String             @default("public")
  actors            Json               @default("[]")
  summary           Json               @default("{}")
  idempotencyKey    String             @unique
  happenedAtActive  DateTime?
  happenedAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())

  @@index([roundId, cityId, happenedAt(sort: Desc)])
  @@index([roundId, kind, happenedAt(sort: Desc)])
}

model Operation {
  id                 String                 @id @default(cuid())
  roundId            String
  round              Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  cityId             String
  city               City                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  template           String                 @default("CORNER_TAKEOVER")
  status             String                 @default("INTEL")
  leaderId           String
  leader             RoundPlayer            @relation("OperationLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  target             Json                   @default("{}")
  roles              Json                   @default("{}")
  report             Json?
  /// 2.2.0. Null keeps the Corner Takeover prototype interpreter.
  catalogKey         String?
  catalogVersion     String?
  rulesSnapshot      Json?
  windows            Json                   @default("[]")
  committedCostCents Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  participants       OperationParticipant[]
  transitions        OperationTransition[]
  sourceClaims       OperationSourceClaim[]
  grants             OperationGrant[]

  @@index([roundId, status, createdAt(sort: Desc)])
  @@index([leaderId, createdAt(sort: Desc)])
}

model OperationParticipant {
  id            String      @id @default(cuid())
  operationId   String
  operation     Operation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  role          String
  status        String      @default("LOCKED")
  invitedById   String?
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([operationId, role])
  @@index([roundPlayerId, status])
}

/// 2.2.0. Append-only status history for criminal operations. Business-operations admin does not read these rows.
model OperationTransition {
  id          String    @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  actorId     String?
  fromStatus  String
  toStatus    String
  reason      String
  createdAt   DateTime  @default(now())

  @@index([operationId, createdAt])
}

/// 2.2.0. One limited source (stash, shipment, or threat) can be claimed by one operation in a round.
model OperationSourceClaim {
  id          String    @id @default(cuid())
  roundId     String
  sourceKind  String
  sourceId    String
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([roundId, sourceKind, sourceId])
  @@index([operationId])
}

/// 2.2.0. Backstop so a retry cannot pay the same participant twice. The ledger itself does not dedupe.
model OperationGrant {
  id            String    @id @default(cuid())
  operationId   String
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  roundPlayerId String
  kind          String
  createdAt     DateTime  @default(now())

  @@unique([operationId, roundPlayerId, kind])
}

model IntelRumor {
  id         String       @id @default(cuid())
  roundId    String
  round      Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  ownerId    String
  owner      RoundPlayer  @relation("IntelRumorOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId   String?
  target     RoundPlayer? @relation("IntelRumorTarget", fields: [targetId], references: [id], onDelete: Cascade)
  cityId     String
  city       City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  district   String?
  topic      String
  confidence String       @default("rumor")
  sources    Json         @default("[]")
  detail     Json         @default("{}")
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([ownerId, topic])
  @@index([ownerId, expiresAt])
  @@index([roundId, cityId, confidence])
  @@index([targetId])
}

model LegacyEntry {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceRoundId  String
  sourceRound    Round    @relation(fields: [sourceRoundId], references: [id], onDelete: Restrict)
  kind           String
  title          String
  summary        Json     @default("{}")
  coverNewsId    String?
  idempotencyKey String   @unique
  awardedAt      DateTime @default(now())

  @@index([accountId, awardedAt(sort: Desc)])
  @@index([sourceRoundId, kind])
}

// Living Streets 2.0.0-B. Case files are player-owned evidence narratives,
// separate from federal PlayerCase, quests, and GameEventParticipation.
enum CriminalCaseStatus {
  LOCKED
  AVAILABLE
  ACTIVE
  SOLVED
  CLOSED
  EXPIRED
}

model RivalryRelationship {
  id                String                       @id @default(cuid())
  roundId           String
  round             Round                        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantAId    String
  participantA      RoundPlayer                  @relation("RivalryParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantBId    String
  participantB      RoundPlayer                  @relation("RivalryParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  rulesetId         String
  rulesetVersion    String
  status            RivalryStatus                @default(ACTIVE)
  mutuality         RivalryMutuality             @default(UNKNOWN)
  scoreA            Int                          @default(0)
  scoreB            Int                          @default(0)
  lastSettledAt     DateTime?
  archivedAt        DateTime?
  suppressedAt      DateTime?
  suppressionReason String?
  sources           RivalrySourceReceipt[]
  transitions       RivalryStateTransition[]
  contracts         RivalryFeudContract[]
  settlements       RivalrySettlement[]
  stories           RivalryPublicStoryDecision[]
  reports           RivalrySuppressionReport[]
  awards            RivalryAwardClaim[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([roundId, participantAId, participantBId])
  @@index([roundId, status, updatedAt])
  @@index([participantAId, roundId, updatedAt])
  @@index([participantBId, roundId, updatedAt])
}

model RivalrySourceReceipt {
  id             String              @id @default(cuid())
  relationshipId String
  relationship   RivalryRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  sourceKind     String
  sourceId       String
  participantId  String
  participant    RoundPlayer         @relation("RivalrySourceParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  outcome        String
  scoreDelta     Int                 @default(0)
  settledAt      DateTime
  visibility     RivalryVisibility   @default(INVOLVED_ONLY)
  decisionReason String?
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now())

  @@unique([relationshipId, sourceKind, sourceId])
  @@index([relationshipId, settledAt])
  @@index([sourceKind, sourceId])
}

model RivalryStateTransition {
  id             String              @id @default(cuid())
  relationshipId String
  relationship   RivalryRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  fromStatus     RivalryStatus?
  toStatus       RivalryStatus
  reason         String
  createdAt      DateTime            @default(now())

  @@index([relationshipId, createdAt])
}

model RivalryFeudContract {
  id             String              @id @default(cuid())
  relationshipId String
  relationship   RivalryRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  proposerId     String
  proposer       RoundPlayer         @relation("RivalryContractProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  targetId       String
  target         RoundPlayer         @relation("RivalryContractTarget", fields: [targetId], references: [id], onDelete: Cascade)
  status         String              @default("PROPOSED")
  objective      Json
  terms          Json
  expiresAt      DateTime
  acceptedAt     DateTime?
  settledAt      DateTime?
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())

  @@index([relationshipId, status, expiresAt])
  @@index([targetId, createdAt])
}

model RivalrySettlement {
  id             String              @id @default(cuid())
  relationshipId String
  relationship   RivalryRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  contractId     String?
  status         String
  reason         String
  receipt        Json                @default("{}")
  settledAt      DateTime            @default(now())

  @@unique([relationshipId, contractId, status])
  @@index([relationshipId, settledAt])
}

model RivalryPublicStoryDecision {
  id             String              @id @default(cuid())
  relationshipId String
  relationship   RivalryRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  sourceId       String?
  published      Boolean             @default(false)
  suppressed     Boolean             @default(false)
  headline       String?
  reason         String?
  decidedBy      String?
  decidedAt      DateTime            @default(now())

  @@index([relationshipId, published, decidedAt])
}

model RivalrySuppressionReport {
  id             String              @id @default(cuid())
  relationshipId String
  relationship   RivalryRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  reporterId     String?
  reason         String
  status         String              @default("OPEN")
  operatorId     String?
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())

  @@index([relationshipId, status, createdAt])
}

model RivalryAwardClaim {
  id              String              @id @default(cuid())
  relationshipId  String
  relationship    RivalryRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  roundPlayerId   String
  roundPlayer     RoundPlayer         @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  awardKey        String
  sourceMilestone String
  claimedAt       DateTime            @default(now())

  @@unique([relationshipId, roundPlayerId, awardKey])
  @@index([roundPlayerId, claimedAt])
}

enum RivalryStatus {
  ACTIVE
  MUTUAL
  ONE_SIDED
  SUPPRESSED
  CEASEFIRE
  TIMEOUT
  DEFEATED
  CLOSED
}

enum RivalryMutuality {
  UNKNOWN
  MUTUAL
  ONE_SIDED
  SUPPRESSED
}

enum RivalryVisibility {
  PARTICIPANT
  INVOLVED_ONLY
  PUBLIC
  SUPPRESSED
}

model CriminalCaseFile {
  id              String                 @id @default(cuid())
  roundId         String
  round           Round                  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           RoundPlayer            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cityId          String
  city            City                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  storyKey        String
  caseKey         String
  rulesetId       String
  rulesetVersion  String
  sourceMemoryId  String?
  sourceMemory    CityMemoryEvent?       @relation(fields: [sourceMemoryId], references: [id], onDelete: SetNull)
  offerDedupeKey  String                 @unique
  offeredAtActive DateTime?
  cluePlan        Json                   @default("[]")
  branchKeys      Json                   @default("[]")
  status          CriminalCaseStatus     @default(AVAILABLE)
  expiresAtActive DateTime
  acceptedAt      DateTime?
  solvedAt        DateTime?
  chosenBranch    String?
  outcomeTitle    String?
  outcomeSummary  String?
  outcomeCategory String?
  rewardCents     Int                    @default(0)
  rewardClaimedAt DateTime?
  chosenAt        DateTime?
  closedAt        DateTime?
  expiredAt       DateTime?
  evidence        CriminalCaseEvidence[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([ownerId, roundId, status, createdAt(sort: Desc)])
  @@index([roundId, cityId, createdAt(sort: Desc)])
  @@index([sourceMemoryId])
  @@index([ownerId, offeredAtActive])
  @@index([roundId, cityId, offeredAtActive])
}

// Every entry links to a verified server-side action receipt. No raw recon
// payload or secret case details are written to public Activity/News.
model CriminalCaseEvidence {
  id              String           @id @default(cuid())
  caseId          String
  caseFile        CriminalCaseFile @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clueKey         String
  sourceKind      String
  sourceReceiptId String
  observedAt      DateTime
  recordedAt      DateTime         @default(now())

  @@unique([caseId, clueKey])
  @@unique([caseId, sourceKind])
  @@unique([caseId, sourceReceiptId])
  @@unique([sourceReceiptId])
  @@index([caseId, recordedAt])
}

/**
 * 2.0.0-G: disabled authoring proposals, never executable by live gameplay.
 */
model AdminLivingStoryDraft {
  id                        String   @id @default(cuid())
  key                       String
  baseRulesetId             String
  baseRulesetVersion        String
  title                     String
  caseKey                   String
  eventKinds                Json     @default("[]")
  audience                  String
  visibility                String
  expiresAfterActiveMinutes Int
  rewardBudgetCents         Int      @default(0)
  enabled                   Boolean  @default(false)
  revision                  Int      @default(1)
  createdByAccountId        String
  updatedByAccountId        String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([baseRulesetId, key])
  @@index([baseRulesetId, updatedAt(sort: Desc)])
}
