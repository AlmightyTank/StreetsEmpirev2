// StreetsEmpire - 0.1.0 "Classic Foundation"
// Ruleset: classic-og-v0.1
//
// Money is stored as INTEGER CENTS (BigInt). $1.00 = 100. Never floats.
// Anything not player-facing in 0.1.0 (PvP, alliances, travel) is deliberately
// absent, but the shapes below are chosen so 0.2.0 does not need a redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts & sessions
// ---------------------------------------------------------------------------

/// A permanent player identity. Survives every round.
model Account {
  id                          String    @id @default(cuid())
  username                    String
  /// Lowercased username. Enforces case-insensitive uniqueness.
  usernameNormalized          String    @unique
  /// Lowercased email. Private account recovery and login address.
  email                       String    @unique
  emailVerifiedAt             DateTime?
  /// Set for every account that existed before email verification was required: they may
  /// keep playing without verifying. Accounts created later are never grandfathered.
  verificationGrandfatheredAt DateTime?
  /// When the player accepted the game rules, and which version of them.
  rulesAcceptedAt             DateTime?
  rulesAcceptedVersion        String?
  /// rc.2. When the player closed their own account (isActive false). Null for staff deactivations.
  closedAt                    DateTime?
  /// rc.2. The address the account signed up from, for the per-address daily sign-up cap.
  registeredIp                String?
  /// rc.5. When the player confirmed at sign-up that they are 13 or older. The rules
  /// agreement asks every player too (Discord sign-ups included).
  ageConfirmedAt              DateTime?
  /// rc.3. Authenticator-app two-step sign-in. Secrets are AES-GCM sealed (auth/totp.ts).
  twoFactorSecret             String?
  /// Set while the player is scanning the QR code, before they confirm a first code.
  twoFactorPendingSecret      String?
  twoFactorEnabledAt          DateTime?
  /// The last code step used, so a code cannot be used twice.
  twoFactorLastStep           Int?
  passwordHash                String

  discordId       String?   @unique
  discordUsername String?
  discordAvatar   String?
  discordLinkedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  isActive     Boolean @default(true)
  isAdmin      Boolean @default(false)
  betaApproved Boolean @default(false)

  /// 0.3.0-B. A timed suspension. The account signs back in on its own once this
  /// passes; the fields are cleared lazily on the next sign-in attempt.
  suspendedUntil      DateTime?
  suspendedReason     String?
  suspendedByUsername String?
  /// 1.0.0-E. A ban: the account is shut down (isActive false) for this recorded reason.
  bannedAt            DateTime?
  bannedReason        String?
  bannedByUsername    String?

  /// 0.9.0-H. Communication restriction: no private messages or wire posts while it
  /// runs. The account still plays. Permanent wins over a date; both cleared by unmute.
  commsMutedUntil      DateTime?
  commsMutedPermanent  Boolean   @default(false)
  commsMuteReason      String?
  commsMutedByUsername String?

  sessions               Session[]
  bugReports             BugReport[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  trustedDevices         TrustedDevice[]
  knownDevices           AccountDevice[]
  loginChallenges        LoginChallenge[]
  passwordResetTokens    PasswordResetToken[]
  accountEmailTokens     AccountEmailToken[]
  forumLink              ForumLink?
  forumLinkRequest       ForumLinkRequest?
  notificationSettings   NotificationSettings?
  notificationOutbox     NotificationOutbox[]
  pushSubscriptions      PushSubscription[]
  profile                AccountProfile?
  cosmeticUnlocks        AccountCosmeticUnlock[]
  roundPlayers           RoundPlayer[]
  authoredNews           GameNews[]              @relation("GameNewsAuthor")
  adminAuditEntries      AdminAuditLog[]         @relation("AdminAuditActor")
  messageBlocksMade      PlayerBlock[]           @relation("PlayerBlocker")
  messageBlocksReceived  PlayerBlock[]           @relation("PlayerBlocked")
  messageReports         PlayerMessageReport[]
  /// 0.9.0-H.
  mutesMade              PlayerMute[]            @relation("PlayerMuter")
  mutesReceived          PlayerMute[]            @relation("PlayerMuted")
  moderationNotes        AccountModerationNote[]
  surveySubmissions      SurveySubmission[]
  experienceEvents       PlayerExperienceEvent[]
  experiencePoints       Int                     @default(0)

  @@index([registeredIp, createdAt])
}

/// Permanent account progress, separate from season resources and Street Pass Cred.
model PlayerExperienceEvent {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  sourceKey String
  source    String
  amount    Int
  awardedAt DateTime @default(now())

  @@unique([accountId, sourceKey])
  @@index([accountId, awardedAt(sort: Desc)])
}

/// 0.9.0-H. Private admin notes on an account. Never shown to the player.
model AccountModerationNote {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  authorAccountId String?
  authorUsername  String
  body            String

  createdAt DateTime @default(now())

  @@index([accountId, createdAt(sort: Desc)])
}

/// 0.3.0-B. One row per admin action: who, what, when, and the target before
/// and after. The app only ever inserts these.
/// 1.0.0-A. Which environment owns this database. A production server refuses a
/// database claimed by beta and the reverse, so a wrong DATABASE_URL fails loudly
/// at boot instead of mixing live and test data. One row, id "singleton".
model DeploymentIdentity {
  id              String   @id @default("singleton")
  environment     String
  claimedAt       DateTime @default(now())
  lastBootAt      DateTime @default(now())
  lastBootVersion String
}

model AdminAuditLog {
  id String @id @default(cuid())

  /// Null once the acting account is deleted; actorUsername keeps the name.
  actorAccountId String?
  actor          Account? @relation("AdminAuditActor", fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorUsername  String

  /// Dotted verb, e.g. round.schedule or round.end-early.
  action     String
  targetType String
  targetId   String?
  reason     String?

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
}

/// Cosmetic and preference settings. Pure prestige: never affects round starts,
/// action math, stores, ranks or combat.
model AccountProfile {
  accountId String  @id
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  activeTitleKey        String?
  titlePlacement        String  @default("prefix")
  /// 0.9.0-F. Optional public crew name, account-level so it carries across seasons.
  crewName              String?
  profileBio            String?
  profileImageUrl       String?
  profileBannerUrl      String?
  profileEffect         String  @default("none")
  activeProfileFrameKey String?
  activeAvatarFrameKey  String?
  activeSiteThemeKey    String?
  /// Player-selected visual skin per inventory item key. Cosmetic only.
  itemCosmetics         Json    @default("{}")
  /// THUG / HOE visual styles. Crew is aggregate inventory, so the style applies to the whole type.
  crewCosmetics         Json    @default("{}")
  /// Slice E. Visitors see the owner's site theme on their public profile.
  showThemeOnProfile    Boolean @default(true)
  /// Slice E. Visitors see the owner's item and crew look on their public profile.
  showLookOnProfile     Boolean @default(true)
  featuredBadgeKeys     Json    @default("[]")
  profileAccent         String  @default("default")
  uiDensity             String  @default("comfortable")
  reducedMotion         Boolean @default(false)
  moneyFormat           String  @default("full")
  defaultLanding        String  @default("game")
  /// Start daily, weekly and city board work as soon as it appears.
  autoAcceptBoardWork   Boolean @default(true)
  /// 1.0.0-B. Tutorial progress: intro completed/skipped, page intros seen, guide
  /// dismissed for a season. Never gameplay state; see OnboardingService.
  onboarding            Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Permanent account cosmetics. Display metadata is snapshotted when earned so
/// titles and badges survive ruleset changes and round resets.
model AccountCosmeticUnlock {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  key         String
  kind        String
  title       String
  description String
  rarity      String
  styleKey    String?

  /// Quest key or another permanent account reward source.
  sourceQuestKey       String
  sourceRulesetId      String
  sourceRulesetVersion String
  awardedAt            DateTime @default(now())

  @@unique([accountId, key])
  @@index([accountId, awardedAt])
  @@index([key])
}

/// Verified public profile connection; owned by the permanent account.
model ForumLink {
  accountId     String   @id
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  forumOrigin   String
  forumUserId   String
  forumUsername String
  createdAt     DateTime @default(now())

  @@unique([forumOrigin, forumUserId])
}

/// Only the latest request in the initiating game session can be completed.
model ForumLinkRequest {
  accountId String   @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  nonceHash String   @unique
  sessionId String
  expiresAt DateTime
}

/// Opt-in alerts for one account: which categories, and which channels deliver them.
/// turnsArmed: turns were below the cap at the last check, so reaching it sends one reminder.
/// rankRoundId/rankLastNational: the national rank last seen, to notice losing #1 or the top 10.
model NotificationSettings {
  accountId             String    @id
  account               Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  turnsEnabled          Boolean   @default(false)
  turnsArmed            Boolean   @default(false)
  turnsLastSentAt       DateTime?
  attacksEnabled        Boolean   @default(false)
  roundEnabled          Boolean   @default(false)
  rankEnabled           Boolean   @default(false)
  turfEnabled           Boolean   @default(false)
  turfEnabledAt         DateTime?
  allianceEnabled       Boolean   @default(false)
  allianceEnabledAt     DateTime?
  rankRoundId           String?
  rankLastNational      Int?
  /// Discord DMs; only delivered while Discord is linked.
  discordEnabled        Boolean   @default(true)
  /// Web Push to every registered device.
  pushEnabled           Boolean   @default(false)
  /// 0.9.0-G categories. Like the ones above they switch outside alerts (Discord, push);
  /// the in-game bell is controlled separately by `bellMuted`.
  turfPushEnabled       Boolean   @default(false)
  reinforcementsEnabled Boolean   @default(false)
  convoyEnabled         Boolean   @default(false)
  runsEnabled           Boolean   @default(false)
  revengeEnabled        Boolean   @default(false)
  ordersEnabled         Boolean   @default(false)
  announcementsEnabled  Boolean   @default(false)
  messagesEnabled       Boolean   @default(false)
  /// 1.3.0-B. A Case rising to a new Wanted stage. On by default: the ladder promises a warning.
  lawEnabled            Boolean   @default(true)
  /// 1.4.0-D. Early warnings from a faction the player is Trusted with. The bell always has them.
  factionsEnabled       Boolean   @default(false)
  /// 0.9.0-G master switch: pauses every outside alert without losing category choices.
  alertsPaused          Boolean   @default(false)
  /// 0.9.0-G quiet hours, minutes after local midnight in `timeZone`. Both set or neither;
  /// a window may wrap past midnight. The bell still records everything.
  quietStartMinute      Int?
  quietEndMinute        Int?
  timeZone              String?
  /// 0.9.0-G categories hidden from the in-game bell (their events stay in Activity).
  bellMuted             Json      @default("[]")
  updatedAt             DateTime  @updatedAt

  @@index([turnsEnabled])
}

enum NotificationChannel {
  DISCORD
  PUSH
}

/// One alert waiting for one channel. The server works out what is due once and
/// writes a row per channel; each channel claims its own rows, so none steals another's.
model NotificationOutbox {
  id        String              @id @default(cuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  /// attacks | turns | round | rank | turf | alliance
  category  String
  /// The alert itself, without any channel address (see @streets/shared NotificationPayload).
  payload   Json
  /// e.g. battle:<id>:<account>:PUSH, so a repeated collection never duplicates an alert.
  dedupeKey String              @unique
  createdAt DateTime            @default(now())
  claimedAt DateTime?

  @@index([channel, claimedAt, createdAt])
  @@index([createdAt])
}

/// A browser or phone that accepts Web Push for an account.
model PushSubscription {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  deviceLabel   String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([accountId])
}

enum AccountEmailTokenPurpose {
  VERIFY_EMAIL
  CHANGE_EMAIL
}

model AccountEmailToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  purpose  AccountEmailTokenPurpose
  newEmail String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  userAgent String?
  ip        String?

  @@index([accountId])
  @@index([expiresAt])
}

/// Server-side session record. The cookie carries a random token; only its
/// SHA-256 hash is stored, so a database leak cannot be replayed as a login.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  userAgent         String?
  ip                String?
  /// rc.2. How the session signed in: PASSWORD or DISCORD. Admin tools can require DISCORD.
  method            String    @default("PASSWORD")
  /// rc.3. True when this sign-in passed an authenticator (or recovery) code.
  twoFactor         Boolean   @default(false)
  /// rc.4. "Keep me signed in": a long session that renews while used. False: ends with the
  /// browser, or after a short idle time.
  remember          Boolean   @default(true)
  /// rc.4. Hard end, however active the session is. Null on sessions from before rc.4
  /// (then createdAt plus the maximum).
  absoluteExpiresAt DateTime?
  /// rc.4. When this session last proved a second factor (Discord sign-in or a code).
  /// Admin tools need it to be recent.
  secondFactorAt    DateTime?
  /// rc.4. Wrong codes entered while signed in; too many signs the session out.
  codeFailures      Int       @default(0)

  @@index([accountId])
  @@index([expiresAt])
}

/// rc.3. One-use codes for signing in when the authenticator phone is lost. Only hashes are kept.
model TwoFactorRecoveryCode {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

/// rc.4. A browser that passed two-step sign-in with "Trust this browser" ticked: sign-ins
/// from it skip the code until it expires or is forgotten. The cookie holds the token;
/// only its hash is stored.
model TrustedDevice {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([accountId])
  @@index([expiresAt])
}

/// rc.5. Browsers this account has signed in from, so a sign-in from a new one can be
/// emailed about. Keyed by a hash of a long-lived per-browser cookie.
model AccountDevice {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  deviceHash  String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([accountId, deviceHash])
}

/// rc.3. A sign-in that passed the password (or Discord) and now waits for the authenticator code.
model LoginChallenge {
  id        String @id @default(cuid())
  tokenHash String @unique

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// PASSWORD or DISCORD: what the session will record once the code is right.
  method    String
  /// rc.4. The "Keep me signed in" choice, carried to the session the code makes.
  remember  Boolean  @default(true)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

/// rc.2. A bug a player reported from the game. Staff read and resolve these in Admin → Bug reports.
model BugReport {
  id String @id @default(cuid())

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// Kept so the report still says who sent it after the account is gone.
  username  String

  /// GAMEPLAY, DISPLAY, ACCOUNT, PERFORMANCE or OTHER.
  category   String
  summary    String
  details    String
  pagePath   String?
  userAgent  String?
  appVersion String?

  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  resolvedByUsername String?
  /// FIXED, WONT_FIX or DUPLICATE.
  resolution         String?
  /// Staff only: why it was resolved, kept in the queue and the audit log.
  resolutionNote     String?

  /// GAME (the report form) or DISCORD (/bug).
  source             String    @default("GAME")
  /// Optional words for the reporter, sent with the "your report was resolved" notice.
  playerReply        String?
  /// When that notice was collected; set at once for reports resolved before notices existed.
  reporterNotifiedAt DateTime?

  @@index([resolvedAt, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
}

/// What the Discord bot posts to the staff channel: a new bug report, its
/// resolution (an edit of the first post), held patch notes. Claimed once, like news.
model DiscordStaffPost {
  id        String    @id @default(cuid())
  /// BUG_REPORT, BUG_REPORT_RESOLVED or PATCH_NOTES_HELD.
  kind      String
  /// The bug report or news post it is about; read fresh when the bot claims it.
  targetId  String
  createdAt DateTime  @default(now())
  claimedAt DateTime?
  /// The staff channel message, so a later post about the same target can edit it.
  messageId String?
  /// Why Discord refused it, as the bot reported it.
  error     String?

  @@index([claimedAt, createdAt])
  @@index([kind, targetId])
}

// ---------------------------------------------------------------------------
// Player surveys
// ---------------------------------------------------------------------------

/// Admin-authored feedback request. Surveys are account-scoped for completion
/// so one account can never earn the same survey reward twice, even if round
/// player state changes.
model Survey {
  id String @id @default(cuid())

  title       String
  description String
  status      SurveyStatus @default(DRAFT)

  /// Optional release/change labels such as 1.1.0-F, Stores, Combat or Mobile UI.
  releaseTag String?
  featureTag String?

  /// Null means the survey is not limited to one round.
  roundId String?
  round   Round?  @relation(fields: [roundId], references: [id], onDelete: SetNull)

  /// Reward definitions use the same shape as quest/pass rewards. Phase B/C
  /// validates and grants them; Phase A only stores the authored snapshot.
  rewards Json @default("[]")

  startsAt    DateTime?
  endsAt      DateTime?
  publishedAt DateTime?
  closedAt    DateTime?
  /// Set when the alert collector has fanned this live survey out to players.
  announcedAt DateTime?

  /// Keep the author name even if that admin account is later removed.
  createdByUsername String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions   SurveyQuestion[]
  submissions SurveySubmission[]

  @@index([status, startsAt, endsAt])
  @@index([status, announcedAt])
  @@index([roundId, status])
  @@index([releaseTag])
  @@index([featureTag])
}

/// One ordered question in a survey. Published survey structure will be treated
/// as immutable by the admin service so historical answers keep their meaning.
model SurveyQuestion {
  id String @id @default(cuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  type        SurveyQuestionType
  prompt      String
  description String?
  required    Boolean            @default(true)
  position    Int

  /// Text questions may use these; null means the service default.
  minLength Int?
  maxLength Int?

  /// Rating questions may use these; the first release supports 1..10.
  ratingMin Int?
  ratingMax Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options SurveyOption[]
  answers SurveyAnswer[]

  @@unique([surveyId, position])
  @@index([surveyId, type])
}

/// Ordered choice for SINGLE_CHOICE or MULTIPLE_CHOICE questions.
model SurveyOption {
  id String @id @default(cuid())

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Stable machine value stored in answers; label is player-facing copy.
  value    String
  label    String
  position Int

  @@unique([questionId, value])
  @@unique([questionId, position])
}

/// A completed survey. The unique account key is the duplicate-reward barrier.
/// roundPlayerId records which round player received a round-scoped reward.
model SurveySubmission {
  id String @id @default(cuid())

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  roundPlayerId String?
  roundPlayer   RoundPlayer? @relation(fields: [roundPlayerId], references: [id], onDelete: SetNull)

  submittedAt DateTime @default(now())

  /// Exact reward definition snapshot used for this completion.
  rewardSnapshot  Json      @default("[]")
  rewardGrantedAt DateTime?

  answers SurveyAnswer[]

  @@unique([surveyId, accountId])
  @@index([surveyId, submittedAt(sort: Desc)])
  @@index([accountId, submittedAt(sort: Desc)])
  @@index([roundPlayerId])
}

/// One answer per question in one completed submission. JSON supports booleans,
/// option values, option arrays, ratings and text without lossy coercion.
model SurveyAnswer {
  id String @id @default(cuid())

  submissionId String
  submission   SurveySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  value Json

  createdAt DateTime @default(now())

  @@unique([submissionId, questionId])
  @@index([questionId, createdAt])
}

// ---------------------------------------------------------------------------
// Rounds
// ---------------------------------------------------------------------------

enum RoundStatus {
  SCHEDULED
  REGISTRATION
  ACTIVE
  ENDED
  ARCHIVED
}

enum QuestStatus {
  LOCKED
  AVAILABLE
  ACTIVE
  READY_TO_TURN_IN
  COMPLETED
  FAILED
  EXPIRED
}

enum QuestRepeatability {
  ONCE
  DAILY
  WEEKLY
  REPEATABLE
}

enum SurveyStatus {
  DRAFT
  SCHEDULED
  LIVE
  CLOSED
}

enum SurveyQuestionType {
  YES_NO
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  RATING
  SHORT_TEXT
  LONG_TEXT
}

/// Relationship standing for one player. Historically this held store-trader
/// standing only; the unified Jobs system also stores named contact reputation
/// here so old rounds and current contacts can coexist without copying scores.
model PlayerReputation {
  id            String @id @default(cuid())
  roundPlayerId String
  /// Relationship key. Historical store keys include CORNER/TOMMY/CHARLIE/PIP;
  /// current job contacts may also use MAMA_KING/WHEELS/VIC/BLOCKS.
  trader        String

  points      Int       @default(0)
  /// Day the regular-trade credit was last paid, so it can be paid at most
  /// once a day without keeping a history of every trade.
  creditedOn  DateTime?
  /// Legacy one-favor completion marker. Current Jobs use PlayerQuest instead.
  questDoneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roundPlayer RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  @@unique([roundPlayerId, trader])
  @@index([roundPlayerId])
}

// ---------------------------------------------------------------------------
// Consumable favor inventory
// ---------------------------------------------------------------------------

model PlayerFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// Stable ruleset-defined favor key.
  key                String
  quantity           Int     @default(0)
  totalGranted       Int     @default(0)
  /// Most recent job that added this favor to the stack.
  lastSourceQuestKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, key])
  @@index([roundPlayerId, updatedAt])
  @@index([key])
}

// ---------------------------------------------------------------------------
// Admin favor content controls
// ---------------------------------------------------------------------------

/// Per-ruleset emergency switch for favor effects. Missing rows mean enabled,
/// so pinned rulesets keep their original behavior until an admin intervenes.
model FavorContentSetting {
  id String @id @default(cuid())

  rulesetId      String
  rulesetVersion String
  key            String
  isEnabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rulesetId, rulesetVersion, key])
  @@index([rulesetId, rulesetVersion, isEnabled])
}

// ---------------------------------------------------------------------------
// Active timed favors
// ---------------------------------------------------------------------------

model PlayerActiveFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// STREET, UNDERWORLD or MUSCLE. Only one live timed favor per category.
  category  String
  favorKey  String
  startedAt DateTime
  expiresAt DateTime

  @@unique([roundPlayerId, category])
  @@index([roundPlayerId, expiresAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Armed single-use favors
// ---------------------------------------------------------------------------

model PlayerArmedFavor {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  category String
  favorKey String
  armedAt  DateTime @default(now())

  @@unique([roundPlayerId, category])
  @@index([roundPlayerId, favorKey])
}

// ---------------------------------------------------------------------------
// Street Pass (docs/STREET-PASS.md)
// ---------------------------------------------------------------------------

/// A player's Street Cred for the round's pass. Created on the first Cred earned.
model StreetPassProgress {
  id String @id @default(cuid())

  roundPlayerId String      @unique
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// The ruleset's streetPass.key, e.g. street-pass-s1.
  passKey                String
  /// Cred earned, late-join bonus included.
  cred                   Int       @default(0)
  /// Fixed when the row is created, from how long the round had run when the player joined.
  lateJoinBonusPercent   Int       @default(0)
  /// Start of the daily window the turn Cred cap is counting, and the base turn Cred counted in it.
  turnCredWindowStartsAt DateTime?
  turnCredInWindow       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One claimed tier. The unique key is what stops a tier paying twice.
model StreetPassClaim {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  passKey   String
  tier      Int
  /// True when round close granted an unclaimed permanent cosmetic tier.
  automatic Boolean  @default(false)
  claimedAt DateTime @default(now())

  @@unique([roundPlayerId, passKey, tier])
}

// ---------------------------------------------------------------------------
// Permanent per-round unlocks
// ---------------------------------------------------------------------------

model PlayerUnlock {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// Stable ruleset-defined key, e.g. PRODUCT_METH_ACCESS.
  key            String
  /// Quest that granted it, when the unlock came from a job reward.
  sourceQuestKey String?
  awardedAt      DateTime @default(now())

  @@unique([roundPlayerId, key])
  @@index([roundPlayerId, awardedAt])
  @@index([key])
}

// ---------------------------------------------------------------------------
// Handcrafted quests
// ---------------------------------------------------------------------------

/// Version-pinned quest content. Definitions are separate from PlayerQuest so
/// one ruleset can publish a catalog once and every seasonal RoundPlayer can
/// progress through it independently.
model QuestDefinition {
  id String @id @default(cuid())

  /// Stable key inside one ruleset version, e.g. FIRST_NIGHT_OUT.
  key            String
  rulesetId      String
  rulesetVersion String

  title       String
  description String
  /// Future contact/NPC key. Null permits system/event quests.
  contactKey  String?
  /// STORY, SIDE, CONTRACT, DAILY, WEEKLY, SECRET, ALLIANCE, CITY_CONTRACT or EVENT.
  type        String
  /// Free-form gameplay grouping such as STREET, COMBAT, TRAVEL or TURF.
  category    String
  /// STREET_JOB, CONTRACT, SERIOUS_BUSINESS, HIGH_RISK or KINGPIN_CONTRACT.
  difficulty  String

  /// JSON keeps the foundation extensible while Phase B supplies typed
  /// objective/prerequisite/reward kinds in the ruleset package.
  prerequisites   Json @default("[]")
  objectives      Json
  bonusObjectives Json @default("[]")
  rewards         Json
  followUpKeys    Json @default("[]")
  availability    Json @default("{}")

  repeatability       QuestRepeatability @default(ONCE)
  expiresAfterMinutes Int?
  isEnabled           Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerQuests PlayerQuest[]

  @@unique([rulesetId, rulesetVersion, key])
  @@index([rulesetId, rulesetVersion, isEnabled])
  @@index([contactKey, isEnabled])
}

/// One player's attempt at one quest. The attempt number prevents
/// daily/weekly/repeatable contracts from requiring a second schema later,
/// while ONCE quests naturally stay on attempt 1.
model PlayerQuest {
  id String @id @default(cuid())

  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  questDefinitionId String
  questDefinition   QuestDefinition        @relation(fields: [questDefinitionId], references: [id], onDelete: Restrict)
  progressReceipts  QuestProgressReceipt[]

  attempt   Int         @default(1)
  status    QuestStatus @default(AVAILABLE)
  isTracked Boolean     @default(false)

  objectiveProgress Json    @default("{}")
  bonusProgress     Json    @default("{}")
  chosenBranch      String?
  rewardState       Json    @default("{}")

  acceptedAt  DateTime?
  completedAt DateTime?
  claimedAt   DateTime?
  failedAt    DateTime?
  expiresAt   DateTime?
  /// Set when the player abandons this attempt, so auto-accept leaves it alone.
  abandonedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, questDefinitionId, attempt])
  @@index([roundPlayerId, status])
  @@index([questDefinitionId, status])
  @@index([status, expiresAt])
}

/// Idempotency/audit receipt for one source event applied to one quest attempt.
/// The source key is usually activity:<PlayerActivity.id>; explicit emitters may
/// use another stable domain key.
model QuestProgressReceipt {
  id String @id @default(cuid())

  playerQuestId String
  playerQuest   PlayerQuest @relation(fields: [playerQuestId], references: [id], onDelete: Cascade)

  sourceKey String
  eventType String
  /// Objective deltas actually credited by this event.
  applied   Json   @default("{}")

  createdAt DateTime @default(now())

  @@unique([playerQuestId, sourceKey])
  @@index([playerQuestId, createdAt])
  @@index([sourceKey])
}

model Round {
  id   String @id @default(cuid())
  name String
  slug String @unique

  rulesetId          String
  rulesetVersion     String
  /// Per-round Street Pass reward edits, frozen when registration opens.
  streetPassOverride Json?

  status RoundStatus @default(SCHEDULED)

  startsAt DateTime
  endsAt   DateTime

  /// 1.0.0-E. A paused round refuses player actions; timers already running still land.
  pausedAt           DateTime?
  pauseReason        String?
  pausedByUsername   String?
  /// Minutes of completed pauses, for the record and for extending the end on resume.
  pausedMinutesTotal Int       @default(0)

  registrationOpensAt DateTime?

  /// Round alerts collected for players, each once. Rounds that already opened
  /// or ended before these existed were backfilled.
  alertsOpenedAt     DateTime?
  alertsEndingSoonAt DateTime?
  alertsEndedAt      DateTime?
  /// When the Discord bot claimed the public round-end post.
  discordEndedAt     DateTime?

  /// Next OG-style public pimp id to hand out. Raw database ids are never
  /// exposed; players see e.g. BigDaddy (#1842).
  nextPublicPimpId Int @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players              RoundPlayer[]
  news                 GameNews[]
  alliances            Alliance[]
  highMarkets          HighMarket[]
  turf                 Turf[]
  turfTax              TurfTaxLedger[]
  turfPushes           TurfPush[]
  turfControlEvents    TurfControlEvent[]
  turfHoldSegments     TurfHoldSegment[]
  turfCrackdown        TurfCrackdown?
  directMessages       DirectMessage[]
  businesses           Business[]
  blockWars            BlockWar[]
  surveys              Survey[]
  casinoJackpots       CasinoJackpot[]
  casinoPokerTables    CasinoPokerTable[]
  supplySupplierStocks SupplySupplierStock[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Cities
// ---------------------------------------------------------------------------

/// Travel does not exist in 0.1.0, but every player has a home city from day
/// one and the modifiers are already wired into the ruleset math.
model City {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  sortOrder Int     @default(0)
  isEnabled Boolean @default(false)

  // 0.5.0-A: a city's character (prices, supply, police, Heat levels, roads and the
  // old scout/income/crack modifiers) lives in the round's pinned ruleset.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players           RoundPlayer[]
  turf              Turf[]
  turfPresence      TurfPresence[]
  turfControlEvents TurfControlEvent[]
  turfCrackdowns    TurfCrackdown[]
  casinoWallets     CasinoWallet[]
  casinoSessions    CasinoSession[]
  casinoLedger      CasinoLedgerEntry[]
  casinoRatings     CasinoRating[]
  playerCases       PlayerCase[]
  caseReceipts      PlayerCaseReceipt[]
  warrants          PlayerWarrant[]
  officials         PlayerOfficial[]
  tips              PlayerTip[]
  npcGangs          NpcGang[]           @relation("NpcGangHomeCity")
}

// ---------------------------------------------------------------------------
// Round players
// ---------------------------------------------------------------------------

model RoundPlayer {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Player-visible OG id, unique inside the round.
  publicPimpId Int

  displayName String

  cityId String
  city   City   @relation(fields: [cityId], references: [id])

  /// Integer cents.
  cashCents BigInt @default(0)

  turns                 Int       @default(0)
  lastTurnCalculationAt DateTime  @default(now())
  lastActiveAt          DateTime  @default(now())
  /// Durable away-bonus state. Prevents collecting twice by refresh spam.
  lastAwayBonusAt       DateTime?

  payoutPercent Int @default(50)

  whores       Int @default(0)
  thugs        Int @default(0)
  woundedThugs Int @default(0)

  condoms  Int @default(0)
  medicine Int @default(0)
  crack    Int @default(0)
  beer     Int @default(0)

  pistols  Int @default(0)
  shotguns Int @default(0)
  tek9s    Int @default(0)
  ak47s    Int @default(0)

  /// What each shop currently has on the shelf for this player, and the clock
  /// each shelf refills on. Same lazy-regeneration shape as turns: the counter only
  /// moves when the player is looked at. A ruleset with no limit on a weapon
  /// simply never reads its pair.
  pistolStock    Int      @default(0)
  pistolStockAt  DateTime @default(now())
  shotgunStock   Int      @default(0)
  shotgunStockAt DateTime @default(now())
  tek9Stock      Int      @default(0)
  tek9StockAt    DateTime @default(now())
  ak47Stock      Int      @default(0)
  ak47StockAt    DateTime @default(now())

  lowRiderStock   Int      @default(0)
  lowRiderStockAt DateTime @default(now())

  condomStock     Int      @default(0)
  condomStockAt   DateTime @default(now())
  medicineStock   Int      @default(0)
  medicineStockAt DateTime @default(now())
  beerStock       Int      @default(0)
  beerStockAt     DateTime @default(now())
  crackStock      Int      @default(0)
  crackStockAt    DateTime @default(now())
  thugStock       Int      @default(0)
  thugStockAt     DateTime @default(now())

  lowRiders         Int @default(0)
  /// 1.5.0-B. Separate vehicle classes; Low-Riders remain in the legacy field.
  sedans            Int @default(0)
  vans              Int @default(0)
  /// 1.5.0-C. At home but out of action until the garage repairs (Damaged) or
  /// recovers (Disabled) them. Not in the Ready counts above.
  damagedLowRiders  Int @default(0)
  damagedSedans     Int @default(0)
  damagedVans       Int @default(0)
  disabledLowRiders Int @default(0)
  disabledSedans    Int @default(0)
  disabledVans      Int @default(0)

  /// 0.9.0-F. Largest whores + thugs this crew has had this round. Profile history
  /// only; raised on every action and settle, never lowered.
  peakCrew Int @default(0)

  /// Weapon access, earned with reputation and never revoked once granted.
  shotgunUnlocked Boolean @default(false)
  tek9Unlocked    Boolean @default(false)
  ak47Unlocked    Boolean @default(false)

  /// Consecutive trips worked without sending anyone out short on condoms.
  /// The clerk's favour is the only thing that reads it.
  cleanShiftStreak Int @default(0)

  /// 0.4.0-C. Attention the crew's product draws, 0..ruleset heat max. Decays on the turn clock
  /// (lastTurnCalculationAt), so it needs no clock of its own. Always 0 on rounds without Heat.
  heat                    Int                      @default(0)
  /// 0.5.0-C. Locked up after an arrest at home: no actions until then.
  lockedUntil             DateTime?
  /// 0.5.0-D. On the road to a new home until then: no actions, and still a target in
  /// the old city (cityId changes on arrival). The move itself is a Relocation row.
  movingUntil             DateTime?
  /// Trips C. A beaten boss heals until then: no trips, no riding along, and the
  /// lieutenant keeps running home.
  laidUpUntil             DateTime?
  /// 0.5.0-E. Thugs out on a tail or riding backup for a convoy: still the player's, still
  /// in net worth, but not fit for anything else until the fight is settled.
  busyThugs               Int                      @default(0)
  /// 0.6.0-A. Thugs standing on corners this crew holds: still the player's and still in
  /// net worth, but not at home to work, cover the street, cook or defend. Unlike
  /// `busyThugs` they have no deadline: they stand there until they are pulled or pushed off.
  postedThugs             Int                      @default(0)
  /// 0.6.0-B. Net-worth value of guns removed from the home arsenal and posted on turf.
  postedNetWorthCents     BigInt                   @default(0)
  /// 0.6.0-D. Net-worth value stored in away outpost boxes.
  outpostNetWorthCents    BigInt                   @default(0)
  /// 1.1.0-B. Thugs and girls working a business. Still counted in `thugs` and `whores`
  /// (and in net worth), but never fit at home and never working the street.
  businessThugs           Int                      @default(0)
  businessWhores          Int                      @default(0)
  /// 1.6.0-A. Thugs assigned to dealer crews. Still owned, but unavailable for other work.
  dealerThugs             Int                      @default(0)
  /// 1.6.5-A. What the player owes the loan shark: every loan's unpaid obligation plus unpaid
  /// late fees. Held under the ruleset's debt ceiling; comes off net worth at the cash weight.
  loanDebtCents           BigInt                   @default(0)
  /// 1.6.5-A. Every late fee ever assessed this round, paid or not. Held under the ruleset's fee cap.
  loanFeesAssessedCents   BigInt                   @default(0)
  loanCollectionState     LoanCollectionState      @default(CLEAR)
  /// 1.6.5-E. While RECOVERING: installments still to be paid on time before new loans unlock.
  loanRecoveryNeeded      Int                      @default(0)
  /// 1.6.5-E. When the player went into collections: only income earned since is garnished.
  loanCollectionsSince    DateTime?
  /// 1.2.0-A. City chip wallets, open bankroll sessions and immutable casino receipts.
  casinoWallets           CasinoWallet[]
  casinoSessions          CasinoSession[]
  casinoLedger            CasinoLedgerEntry[]
  /// 1.3.0-A. What each city's police have on this player, and every change to it.
  cases                   PlayerCase[]
  caseReceipts            PlayerCaseReceipt[]
  factionStandings        PlayerFactionStanding[]
  factionReceipts         PlayerFactionReceipt[]
  factionPerkUses         PlayerFactionPerkUse[]
  factionWarnings         PlayerFactionWarning[]
  warrants                PlayerWarrant[]
  /// 1.3.0-D. Corrupt officials on the payroll, and tips bought from informants.
  officials               PlayerOfficial[]
  tips                    PlayerTip[]
  npcGang                 NpcGang?
  randomEncounters        RandomEncounter[]
  casinoFreeSpinBonus     CasinoFreeSpinBonus?
  casinoBlackjackShoes    CasinoBlackjackShoe[]
  casinoBlackjackHands    CasinoBlackjackHand[]
  casinoBlackjackActions  CasinoBlackjackAction[]
  casinoStreetDiceRounds  CasinoStreetDiceRound[]
  casinoStreetDiceActions CasinoStreetDiceAction[]
  casinoPokerHands        CasinoPokerHand[]
  casinoPokerActions      CasinoPokerAction[]
  casinoPokerSeats        CasinoPokerSeat[]
  casinoPokerTableActions CasinoPokerTableAction[]
  /// 1.2.0-E. Rated play per casino city: theo, status and comps.
  casinoRatings           CasinoRating[]
  /// 1.1.0-C. The crew's live rackets, racket key -> strength (0..1], rebuilt on every
  /// business settle so any system can read them off the player row.
  racketEffects           Json                     @default("{}")
  /// Heat washed by laundering rackets on `launderedDay` (UTC) and over the round, for the caps.
  launderedDay            String?
  launderedHeatToday      Int                      @default(0)
  launderedHeatRound      Int                      @default(0)
  /// 1.3.0-B. Case washed by laundering on `launderedCaseDay` (UTC), in hundredths, for the daily cap.
  launderedCaseDay        String?
  launderedCaseToday      Int                      @default(0)
  /// 1.3.0-C. Police losses (busts, arrests, raids, fines) on `policeLossDay` (UTC), at net-worth
  /// value, for the daily cap. Busts and arrests count toward it but are never reduced by it.
  policeLossDay           String?
  policeLossCents         BigInt                   @default(0)
  /// 1.3.0-C. A lawyer on retainer until then.
  lawyerRetainedUntil     DateTime?
  /// Rocks sold to Pip this round, for his favour. Cumulative, never reset.
  rocksSuppliedToPip      Int                      @default(0)
  /// Drive-bys carried out this round, landed or not, for Charlie's favour.
  driveBysDone            Int                      @default(0)
  /// 0.3.0-B favours. Store purchases this round, whichever shop sold them. Rows from
  /// rounds before these were added start at zero.
  condomsBought           Int                      @default(0)
  medicineBought          Int                      @default(0)
  beerBought              Int                      @default(0)
  pistolsBought           Int                      @default(0)
  /// Raids carried out this round in any form but the drive-by, landed or not.
  raidsDone               Int                      @default(0)

  /// Derived from supplies, protection and fatigue. Stored so it can be read
  /// and ranked without recomputing, but never the source of truth.
  whoreHappiness Int @default(100)
  thugHappiness  Int @default(100)

  /// Integer cents.
  netWorthCents     BigInt @default(0)
  /// 0.5.0-B. Net worth of what is out on a run (cash, cars, escorts, cargo), which has
  /// left the columns above. Zero when nothing is out.
  awayNetWorthCents BigInt @default(0)

  localRank           Int?
  nationalRank        Int?
  localRankSinceAt    DateTime @default(now())
  nationalRankSinceAt DateTime @default(now())

  dailyStartingLocalRank    Int?
  dailyStartingNationalRank Int?
  /// When the daily rank snapshot above was taken. Null means never.
  dailyRankSnapshotAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity              PlayerActivity[]
  inAppNotifications    InAppNotification[]
  scheduledAlerts       ScheduledAlert[]
  economyLedger         EconomyLedgerEntry[]
  processedActions      ProcessedAction[]
  reputation            PlayerReputation[]
  playerQuests          PlayerQuest[]
  permanentUnlocks      PlayerUnlock[]
  favorInventory        PlayerFavor[]
  activeFavors          PlayerActiveFavor[]
  armedFavors           PlayerArmedFavor[]
  streetPassProgress    StreetPassProgress?
  streetPassClaims      StreetPassClaim[]
  surveySubmissions     SurveySubmission[]
  raidsSent             RaidBattle[]         @relation("RaidAttacker")
  raidsReceived         RaidBattle[]         @relation("RaidDefender")
  combatInjuries        CombatInjury[]
  observedIntel         CombatIntel[]        @relation("IntelObserver")
  targetedIntel         CombatIntel[]        @relation("IntelTarget")
  raidProtectedUntil    DateTime?
  raidCooldownUntil     DateTime?
  lastRaidedAt          DateTime?
  /// Drive-bys run on their own clocks so one can set up a raid.
  driveByCooldownUntil  DateTime?
  driveByProtectedUntil DateTime?
  lastDrivenByAt        DateTime?

  /// Seasonal hideout rooms. These reset naturally because each round creates
  /// a fresh RoundPlayer row, while ended rows keep the final build archived.
  hideoutSafeRoomLevel            Int     @default(0)
  hideoutLookoutsLevel            Int     @default(0)
  hideoutWorkshopLevel            Int     @default(0)
  hideoutBackOfficeLevel          Int     @default(0)
  /// 0.6.0-D. One level opens a second concurrent travel run.
  hideoutGarageLevel              Int     @default(0)
  /// 0.7.0-F. Which guns home squads and run escorts consume first.
  hideoutWeaponPriority           String  @default("POWER")
  /// 0.7.0-G. Permanent for this RoundPlayer; the next season starts clean.
  hideoutSafeRoomSpecialization   String?
  hideoutLookoutsSpecialization   String?
  hideoutWorkshopSpecialization   String?
  hideoutBackOfficeSpecialization String?

  /// 0.3.0-C. The alliance this player is in now, and since when. Shared revenge only
  /// counts hits on the alliance from after the member joined.
  allianceId            String?
  alliance              Alliance?            @relation("AllianceMembers", fields: [allianceId], references: [id], onDelete: SetNull)
  allianceJoinedAt      DateTime?
  /// The alliance this player last left or was kicked from. Until the cooldown passes
  /// they cannot join or found an alliance, and they and that alliance cannot hit each other.
  formerAllianceId      String?
  allianceCooldownUntil DateTime?
  allianceInvites       AllianceInvite[]     @relation("AllianceInvitee")
  /// 0.4.0-A. Every product except crack, which stays on the `crack` column in every round.
  products              PlayerProduct[]
  productShelves        ProductShelf[]
  /// 1.6.0-A. Supply network records, scoped to this round's player.
  supplyOrders          SupplyOrder[]
  supplyPickups         SupplyPickup[]
  supplyWarehouses      SupplyWarehouse[]
  supplySafehouses      SupplySafehouse[]
  dealerCrews           DealerCrew[]
  dealerStaff           DealerStaff[]
  supplyMovements       SupplyMovement[]
  /// 1.6.5-A. Loan shark contracts and their history, scoped to this round's player.
  loans                 Loan[]
  loanInstallments      LoanInstallment[]
  loanPayments          LoanPayment[]
  loanFees              LoanFee[]
  loanEvents            LoanEvent[]
  /// 1.7.0-A. The individual thugs and workers behind the counts above, and their migration.
  crewMembers           CrewMember[]
  crewMemberEvents      CrewMemberEvent[]
  crewRosterMigration   CrewRosterMigration?
  /// 0.5.0-B. Runs out of town, Pip's shelves in other cities, and what the crew saw there.
  runs                  Run[]
  cityShelves           CityShelf[]
  citySightings         CitySighting[]
  relocations           Relocation[]
  /// Trips A. The boss away from home and back.
  bossTrips             BossTrip[]
  /// Trips C. Hits on a visiting boss: started and taken.
  bossHitsStarted       BossHit[]            @relation("BossHitAttacker")
  bossHitsTaken         BossHit[]            @relation("BossHitOwner")
  /// Trips D2. Backup sent to allies' bosses, and sit-downs proposed and received.
  bossHitBackups        BossHitBackup[]
  sitDownsProposed      SitDown[]            @relation("SitDownProposer")
  sitDownsInvited       SitDown[]            @relation("SitDownInvitee")
  convoyTailsOwned      ConvoyTail[]         @relation("ConvoyTailOwner")
  convoyTailsStarted    ConvoyTail[]         @relation("ConvoyTailAttacker")
  convoyBackups         ConvoyBackup[]
  convoyRecon           ConvoyRecon?
  /// 0.6.0-A. Blocks this crew holds, and the blocks it has worked lately.
  turfHeld              Turf[]               @relation("TurfHolder")
  businessesStaffed     Business[]           @relation("BusinessStaffOwner")
  turfPresence          TurfPresence[]
  turfTaxPaid           TurfTaxLedger[]      @relation("TurfTaxPayer")
  turfTaxEarned         TurfTaxLedger[]      @relation("TurfTaxHolder")
  /// 0.6.0-C. Turf wars started against or defended by this crew.
  turfPushesStarted     TurfPush[]           @relation("TurfPushAttacker")
  turfPushesDefended    TurfPush[]           @relation("TurfPushDefender")
  blockWarsDeclared     BlockWar[]           @relation("BlockWarAttacker")
  blockWarsDefended     BlockWar[]           @relation("BlockWarDefender")
  blockWarSquads        BlockWarSquad[]
  turfPushBackups       TurfPushBackup[]
  /// 0.6.0-D. Supply/tax boxes for away turf.
  turfOutposts          TurfOutpost[]
  turfHoldSegments      TurfHoldSegment[]
  /// 0.4.0-B. Which products each job burns, in order.
  supplyPolicies        WorkSupplyPolicy[]
  /// 0.3.0-D. Wire posts written, and the private rolodex in both directions.
  wirePosts             AllianceWirePost[]   @relation("WireAuthor")
  contacts              PlayerContact[]      @relation("ContactOwner")
  contactOf             PlayerContact[]      @relation("ContactTarget")
  messagesSent          DirectMessage[]      @relation("DirectMessageSender")
  messagesReceived      DirectMessage[]      @relation("DirectMessageRecipient")

  @@unique([roundId, accountId])
  @@unique([roundId, publicPimpId])
  @@index([roundId, netWorthCents(sort: Desc)])
  @@index([roundId, cityId, netWorthCents(sort: Desc)])
  @@index([allianceId])
}

/// Server-run street crews that use the same seasonal body as a player crew, with
/// a small scheduler profile layered on top.
model NpcGang {
  id String @id @default(cuid())

  roundPlayerId String      @unique
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  archetype String
  tier      String

  homeCityId String
  homeCity   City   @relation("NpcGangHomeCity", fields: [homeCityId], references: [id])

  aggression Int
  ambition   Int
  discipline Int

  nextActionAt DateTime
  lastActionAt DateTime?
  dormantUntil DateTime?

  memory Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nextActionAt])
  @@index([homeCityId, tier])
}

// ---------------------------------------------------------------------------
// Alliances (0.3.0-C)
// ---------------------------------------------------------------------------

/// A crew of players inside one round. Resets with the round like everything else.
model Alliance {
  id      String @id @default(cuid())
  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  name              String
  /// Lowercased. A disbanded alliance gets its id appended so the name is free again.
  nameNormalized    String
  /// Shown in brackets beside member names, e.g. [NYC].
  tag               String
  tagNormalized     String
  /// 0.9.0-E alliance profile shown to members and public rankings/detail pages.
  description       String @default("")
  recruitmentStatus String @default("CLOSED")

  /// A RoundPlayer id. No foreign key: leadership moves inside the same locked
  /// transaction as membership, and a disbanded alliance keeps its last leader.
  leaderId String

  disbandedAt   DateTime?
  disbandReason String?

  /// 0.3.0-C recruitment thread in the forum's recruitment tag. Posted once, by the leader.
  /// forumPostStartedAt claims the post so a double click cannot open two threads.
  forumDiscussionId  String?
  forumPostStartedAt DateTime?
  forumError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members RoundPlayer[]      @relation("AllianceMembers")
  invites AllianceInvite[]
  events  AllianceEvent[]
  wire    AllianceWirePost[]

  @@unique([roundId, nameNormalized])
  @@unique([roundId, tagNormalized])
  @@index([roundId, disbandedAt])
}

/// A standing offer to one player. Accepting re-checks the cap under the alliance lock.
model AllianceInvite {
  id            String      @id @default(cuid())
  allianceId    String
  alliance      Alliance    @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  inviteeId     String
  invitee       RoundPlayer @relation("AllianceInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  /// Display name of whoever sent it, kept as text so it survives them leaving.
  invitedByName String
  createdAt     DateTime    @default(now())
  expiresAt     DateTime

  @@unique([allianceId, inviteeId])
  @@index([inviteeId, expiresAt])
}

/// 0.3.0-D. A short post only the alliance's current members can read.
/// Removed posts stay for moderation history but are never shown to players.
model AllianceWirePost {
  id         String      @id @default(cuid())
  allianceId String
  alliance   Alliance    @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  authorId   String
  author     RoundPlayer @relation("WireAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  /// MESSAGE or ANNOUNCEMENT. Text keeps old rows/migrations simple.
  kind       String      @default("MESSAGE")
  pinned     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  /// Set when the author, the alliance leader or an admin removed it.
  removedAt         DateTime?
  removedByName     String?
  /// author, leader or admin.
  removedByRole     String?
  removedReason     String?
  /// 0.9.0-G. When announcement alerts for this post were collected.
  alertsCollectedAt DateTime?

  @@index([allianceId, createdAt(sort: Desc)])
  @@index([alertsCollectedAt, createdAt])
  @@index([allianceId, kind, pinned, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

/// 0.4.0-A. Stock of one product for one round player. Crack is never stored here: it keeps
/// the RoundPlayer.crack column so older rounds and every crack reader stay unchanged. Which
/// products exist, and what they do, comes from the round's pinned ruleset.
model PlayerProduct {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  /// Ruleset product key, e.g. ECSTASY.
  productKey    String
  quantity      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([roundPlayerId, productKey])
}

/// 0.4.0-D. Pip's shelf for one non-crack product, per player, on the lazy restock clock.
/// No row means a full shelf; crack keeps its crackStock columns.
model ProductShelf {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  productKey    String
  stock         Int
  stockAt       DateTime

  @@unique([roundPlayerId, productKey])
}

enum SupplyOrderStatus {
  OPEN
  PARTIALLY_COLLECTED
  FULFILLED
  CANCELLED
}

enum SupplyPickupStatus {
  PLANNED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum DealerCrewStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum SupplyMovementKind {
  ORDERED
  PICKED_UP
  STORED
  ASSIGNED_TO_DEALER
  SOLD
  RETURNED
  /// 1.6.0-I. An audited staff correction: quantityDelta is signed.
  CORRECTED
}

/// 1.6.0-A. Prepaid bulk stock reserved from a ruleset-defined supplier.
/// All quantities are game units; cash is integer cents.
model SupplyOrder {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  supplierKey       String
  supplierCitySlug  String
  productKey        String
  quantityOrdered   Int
  quantityCollected Int               @default(0)
  unitCostCents     Int
  totalPaidCents    BigInt
  status            SupplyOrderStatus @default(OPEN)
  /// Durable idempotency key for order placement, independent of the short-lived action cache.
  requestKey        String            @db.VarChar(128)
  pickups           SupplyPickup[]
  movements         SupplyMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, requestKey])
  @@index([roundPlayerId, status, createdAt])
  @@index([roundPlayerId, supplierCitySlug, createdAt])
}

/// 1.6.0-B. Round-wide supplier stock reserved by prepaid orders.
model SupplySupplierStock {
  id                String @id @default(cuid())
  roundId           String
  round             Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  supplierKey       String
  productKey        String
  quantityAvailable Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundId, supplierKey, productKey])
  @@index([roundId, supplierKey])
}

/// 1.6.0-A. One vehicle-sized pickup batch from a prepaid order.
model SupplyPickup {
  id                String           @id @default(cuid())
  /// The paid order a pickup collects. 1.6.0-F: null for a shipment between warehouses.
  orderId           String?
  order             SupplyOrder?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 1.6.0-F. Whose load it is, and what it carries.
  roundPlayerId     String
  roundPlayer       RoundPlayer      @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  productKey        String
  /// 1.6.0-F. A shipment's source warehouse. Its units leave that warehouse at dispatch.
  sourceWarehouseId String?
  sourceWarehouse   SupplyWarehouse? @relation("ShipmentSource", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  runId             String?
  run               Run?             @relation(fields: [runId], references: [id], onDelete: SetNull)

  routeKey            String
  originCitySlug      String
  destinationCitySlug String
  quantity            Int
  vehicleLoadout      Json               @default("{}")
  status              SupplyPickupStatus @default(PLANNED)
  requestKey          String             @db.VarChar(128)
  dispatchedAt        DateTime?
  expectedArrivalAt   DateTime?
  /// 1.6.0-C. When the load came off the supplier's dock and onto the run.
  loadedAt            DateTime?
  deliveredAt         DateTime?
  /// 1.6.0-C. What made it into storage; `quantity` less this was lost on the road.
  deliveredQuantity   Int                @default(0)
  /// 1.6.0-C. Where the load is headed: held against the warehouse's room until it lands.
  warehouseId         String?
  warehouse           SupplyWarehouse?   @relation("PickupDestination", fields: [warehouseId], references: [id], onDelete: SetNull)
  movements           SupplyMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, requestKey])
  @@unique([sourceWarehouseId, requestKey])
  @@index([orderId, status])
  @@index([roundPlayerId, createdAt])
  @@index([runId])
  @@index([warehouseId, status])
}

enum SupplyWarehouseKind {
  STASH
  WAREHOUSE
}

/// 1.6.0-D. A foothold in a city: what a warehouse away from home, and later a dealer crew, needs.
model SupplySafehouse {
  id             String      @id @default(cuid())
  roundPlayerId  String
  roundPlayer    RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  citySlug       String
  isActive       Boolean     @default(true)
  upkeepCents    BigInt
  paidThrough    DateTime
  purchasedCents BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, citySlug])
  @@index([roundPlayerId, isActive])
}

/// 1.6.0-A. A bounded storage location in one ruleset city. 1.6.0-D: bought, or the free home stash.
model SupplyWarehouse {
  id             String              @id @default(cuid())
  roundPlayerId  String
  roundPlayer    RoundPlayer         @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  citySlug       String
  name           String
  capacityUnits  Int
  isActive       Boolean             @default(true)
  /// 1.6.0-D. The free home stash, or a warehouse the player bought.
  kind           SupplyWarehouseKind @default(WAREHOUSE)
  /// 1.6.0-D. Upkeep each period, and how far it is paid. Null: no upkeep (the stash).
  upkeepCents    BigInt              @default(0)
  paidThrough    DateTime?
  /// 1.6.0-D. What the player paid for it.
  purchasedCents BigInt              @default(0)
  stock          SupplyStock[]
  movements      SupplyMovement[]
  pickups        SupplyPickup[]      @relation("PickupDestination")
  shipmentsOut   SupplyPickup[]      @relation("ShipmentSource")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, citySlug, name])
  @@index([roundPlayerId, citySlug, isActive])
}

/// 1.6.0-A. Physical stock held at a warehouse, separate from dealer allocations.
model SupplyStock {
  id          String          @id @default(cuid())
  warehouseId String
  warehouse   SupplyWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productKey  String
  quantity    Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productKey])
  @@index([productKey])
}

/// 1.6.0-A. A player-managed crew assigned to one city district.
model DealerCrew {
  id                 String           @id @default(cuid())
  roundPlayerId      String
  roundPlayer        RoundPlayer      @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  citySlug           String
  districtKey        String
  status             DealerCrewStatus @default(ACTIVE)
  /// 1.6.0-E. Units each of its dealers holds, summed: zero with nobody posted.
  capacityUnits      Int
  operatingCostCents BigInt           @default(0)
  /// 1.6.0-E. The one product it sells, and the price it asks a unit.
  productKey         String?
  priceCents         Int?
  /// 1.6.0-F. Sales are settled up to here, in whole intervals; null while it has never worked.
  salesSettledAt     DateTime?
  /// 1.6.0-F. The part of a unit sold but not yet whole, carried to the next batch.
  salesCarry         Float            @default(0)
  staff              DealerStaff[]
  inventory          DealerStock[]
  sales              DealerSale[]
  movements          SupplyMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, citySlug, districtKey])
  @@index([roundPlayerId, citySlug, status])
}

/// 1.6.0-A. One promoted thug's dealer career. Releasing him returns a thug to the pool;
/// the career row and experience remain so rehiring him restores his earned skill.
model DealerStaff {
  id               String      @id @default(cuid())
  roundPlayerId    String
  roundPlayer      RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  dealerCrewId     String?
  dealerCrew       DealerCrew? @relation(fields: [dealerCrewId], references: [id], onDelete: Restrict)
  experiencePoints Int         @default(0)
  assignedAt       DateTime    @default(now())
  releasedAt       DateTime?
  /// 1.7.0-A. The crew member who carries this career, under the same id.
  crewMember       CrewMember?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roundPlayerId, dealerCrewId, releasedAt])
  @@index([roundPlayerId, experiencePoints])
}

/// 1.6.0-A. Stock assigned to a dealer crew, separate from warehouse stock.
model DealerStock {
  id           String     @id @default(cuid())
  dealerCrewId String
  dealerCrew   DealerCrew @relation(fields: [dealerCrewId], references: [id], onDelete: Cascade)
  productKey   String
  quantity     Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealerCrewId, productKey])
  @@index([productKey])
}

/// 1.6.0-A. Immutable batch of dealer sales for reconciliation and the player ledger.
model DealerSale {
  id             String     @id @default(cuid())
  dealerCrewId   String
  dealerCrew     DealerCrew @relation(fields: [dealerCrewId], references: [id], onDelete: Cascade)
  productKey     String
  batchKey       String     @db.VarChar(128)
  quantity       Int
  unitPriceCents Int
  grossCents     BigInt
  crewCutCents   BigInt     @default(0)
  netCents       BigInt
  createdAt      DateTime   @default(now())

  @@unique([dealerCrewId, batchKey])
  @@index([dealerCrewId, createdAt(sort: Desc)])
}

/// 1.6.0-A. Immutable stock movement journal; cash movements use EconomyLedgerEntry.
model SupplyMovement {
  id            String             @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer        @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  kind          SupplyMovementKind
  productKey    String
  quantityDelta Int
  fromLocation  String?
  toLocation    String?
  orderId       String?
  order         SupplyOrder?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  pickupId      String?
  pickup        SupplyPickup?      @relation(fields: [pickupId], references: [id], onDelete: SetNull)
  warehouseId   String?
  warehouse     SupplyWarehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  dealerCrewId  String?
  dealerCrew    DealerCrew?        @relation(fields: [dealerCrewId], references: [id], onDelete: SetNull)
  requestKey    String             @db.VarChar(128)
  metadata      Json?
  createdAt     DateTime           @default(now())

  @@unique([roundPlayerId, requestKey])
  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([orderId, createdAt])
  @@index([pickupId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([dealerCrewId, createdAt])
}

// ---------------------------------------------------------------------------
// Crew roster (1.7.0)
// ---------------------------------------------------------------------------

enum CrewMemberRole {
  THUG
  WORKER
}

/// Where a member is. Every status but RELEASED is counted in the player's thugs or whores.
enum CrewMemberStatus {
  /// At home and fit for work.
  AVAILABLE
  /// Working a job: see the assignment.
  ASSIGNED
  /// Out on a run, a tail or backup (the player's busy thugs).
  IN_TRANSIT
  /// Wounded and healing.
  RECOVERING
  /// No longer in the crew. The record and its career stay for history and a return.
  RELEASED
}

enum CrewAssignmentKind {
  BUSINESS
  DEALER
  TURF
}

enum CrewMemberEventKind {
  /// Already in the crew when the roster was first built.
  MIGRATED
  JOINED
  ASSIGNED
  UNASSIGNED
  RELEASED
  /// A released member back in the crew, career intact.
  REHIRED
}

/// 1.7.0-A. One thug or worker. The player's counts stay authoritative: members are kept in
/// step with them, so a member is never created or released except to match a count.
model CrewMember {
  id               String              @id @default(cuid())
  roundPlayerId    String
  roundPlayer      RoundPlayer         @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  role             CrewMemberRole
  /// Order of joining in this round's roster, 1-based and never reused.
  serial           Int
  status           CrewMemberStatus    @default(AVAILABLE)
  assignmentKind   CrewAssignmentKind?
  /// The business, dealer crew or turf a member is assigned to, when it is known.
  assignmentRef    String?
  experiencePoints Int                 @default(0)
  /// 1.6 dealer career this member carries; the member keeps the career's id.
  dealerStaffId    String?             @unique
  dealerStaff      DealerStaff?        @relation(fields: [dealerStaffId], references: [id], onDelete: SetNull)
  joinedAt         DateTime
  statusSince      DateTime
  releasedAt       DateTime?
  events           CrewMemberEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, serial])
  @@index([roundPlayerId, role, status])
  @@index([roundPlayerId, assignmentKind, assignmentRef])
}

/// 1.7.0-A. A member's history: joining, assignments and releases. Immutable.
model CrewMemberEvent {
  id             String              @id @default(cuid())
  memberId       String
  member         CrewMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roundPlayerId  String
  roundPlayer    RoundPlayer         @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  kind           CrewMemberEventKind
  assignmentKind CrewAssignmentKind?
  assignmentRef  String?
  at             DateTime

  @@index([memberId, at])
  @@index([roundPlayerId, at(sort: Desc)])
}

/// 1.7.0-A. The audit of a player's first roster build: the counts it read, and what it made.
/// One per player, so a retry finds it and never builds a second roster.
model CrewRosterMigration {
  id             String      @id @default(cuid())
  roundPlayerId  String      @unique
  roundPlayer    RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  rulesetId      String
  /// The counts the roster was built from, and the member totals it ended with.
  before         Json
  after          Json
  membersCreated Int
  dealerCareers  Int
  createdAt      DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Loan shark (1.6.5)
// ---------------------------------------------------------------------------

enum LoanStatus {
  ACTIVE
  /// An installment passed its due time unpaid and still has something owing.
  DELINQUENT
  PAID_OFF
}

enum LoanInstallmentStatus {
  SCHEDULED
  PAID
  /// Passed its due time unpaid. Stays owed; becomes PAID once it is paid off.
  MISSED
}

enum LoanPaymentKind {
  /// Collected by the server when an installment fell due.
  SCHEDULED
  /// Paid by the player, early, partly or in full.
  MANUAL
  /// 1.6.5-E. Taken under collection pressure.
  COLLECTION
}

enum LoanFeeKind {
  LATE
  /// 1.6.5-E. Reserved for a bounded collection consequence.
  COLLECTION
}

enum LoanCollectionState {
  CLEAR
  DELINQUENT
  /// 1.6.5-E. Past the configured delinquency threshold.
  COLLECTIONS
  /// 1.6.5-E. Overdue cleared; new loans unlock after enough on-time installments.
  RECOVERING
}

enum LoanEventKind {
  ACCEPTED
  PAYMENT
  INSTALLMENT_MISSED
  FEE_ASSESSED
  PAID_OFF
  COLLECTION_CHANGED
  /// 1.6.5-F. An audited staff correction: a late fee waived, or a missed installment excused.
  CORRECTED
}

/// 1.6.5-A. One accepted loan shark contract: the terms quoted, pinned to the ruleset it
/// was accepted under, and what has been paid against them. Cash is integer cents.
/// Outstanding = (principal - principalPaid) + (contractFee - contractFeePaid - contractFeeWaived)
///             + (lateFeesAssessed - lateFeesPaid).
model Loan {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  /// Which quote this was. 1.6.5-B names the offer tiers.
  offerKey       String
  rulesetId      String
  rulesetVersion String

  principalCents         BigInt
  contractFeeCents       BigInt
  /// Principal plus contract fee: reserved against the debt ceiling at acceptance.
  obligationCents        BigInt
  principalPaidCents     BigInt @default(0)
  contractFeePaidCents   BigInt @default(0)
  /// Contract fee not yet earned when the loan was paid off early, forgiven.
  contractFeeWaivedCents BigInt @default(0)
  /// The fixed fee for one missed installment, and the most this loan can ever be charged.
  lateFeeCents           BigInt
  lateFeeCapCents        BigInt
  lateFeesAssessedCents  BigInt @default(0)
  lateFeesPaidCents      BigInt @default(0)
  /// 1.6.5-F. Late fees forgiven by an audited staff correction. Still counted as assessed.
  lateFeesWaivedCents    BigInt @default(0)

  installmentCount         Int
  installmentIntervalHours Int
  status                   LoanStatus @default(ACTIVE)
  /// Durable idempotency key for acceptance, independent of the short-lived action cache.
  requestKey               String     @db.VarChar(128)
  acceptedAt               DateTime
  paidOffAt                DateTime?

  installments LoanInstallment[]
  payments     LoanPayment[]
  fees         LoanFee[]
  events       LoanEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roundPlayerId, requestKey])
  @@index([roundPlayerId, status, acceptedAt])
}

/// 1.6.5-A. One scheduled installment: its share of the principal and contract fee, due on
/// the server clock. Late fees belong to the loan, not to an installment.
model LoanInstallment {
  id            String      @id @default(cuid())
  loanId        String
  loan          Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)

  sequence               Int
  dueAt                  DateTime
  principalCents         BigInt
  contractFeeCents       BigInt
  principalPaidCents     BigInt                @default(0)
  contractFeePaidCents   BigInt                @default(0)
  /// Its fee share forgiven by an early payoff.
  contractFeeWaivedCents BigInt                @default(0)
  status                 LoanInstallmentStatus @default(SCHEDULED)
  /// When the server found it unpaid at its due time. Kept after it is paid, for history.
  missedAt               DateTime?
  paidAt                 DateTime?
  /// 1.6.5-F. A miss excused by staff: rescheduled, its late fee waived. The first due time and
  /// the miss stay on record; each excusal starts a new generation of settle keys.
  excusedAt              DateTime?
  originalDueAt          DateTime?
  fees                   LoanFee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loanId, sequence])
  @@index([roundPlayerId, status, dueAt])
}

/// 1.6.5-A. Immutable receipt for cash paid to the loan shark, split the way it was applied.
model LoanPayment {
  id                     String          @id @default(cuid())
  loanId                 String
  loan                   Loan            @relation(fields: [loanId], references: [id], onDelete: Cascade)
  roundPlayerId          String
  roundPlayer            RoundPlayer     @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  kind                   LoanPaymentKind
  /// A manual payment's request key, or the installment a scheduled payment settled.
  requestKey             String          @db.VarChar(128)
  amountCents            BigInt
  lateFeeCents           BigInt
  contractFeeCents       BigInt
  principalCents         BigInt
  /// Unearned contract fee forgiven because this payment paid the loan off early. Not cash.
  contractFeeWaivedCents BigInt          @default(0)
  /// The player's total debt once this payment landed.
  debtAfterCents         BigInt
  createdAt              DateTime        @default(now())

  @@unique([roundPlayerId, requestKey])
  @@index([loanId, createdAt])
}

/// 1.6.5-A. Immutable record of a fee added to a loan's balance. One per missed installment
/// and kind; an assessment the caps cut to zero is still recorded, so it is never retried.
model LoanFee {
  id            String           @id @default(cuid())
  loanId        String
  loan          Loan             @relation(fields: [loanId], references: [id], onDelete: Cascade)
  roundPlayerId String
  roundPlayer   RoundPlayer      @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  installmentId String?
  installment   LoanInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  kind          LoanFeeKind
  requestKey    String           @db.VarChar(128)
  /// What was charged after the caps; the fixed fee it was cut down from.
  amountCents   BigInt
  quotedCents   BigInt
  /// 1.6.5-F. How much of it staff waived, and when. The fee itself stays on record.
  waivedCents   BigInt           @default(0)
  waivedAt      DateTime?
  createdAt     DateTime         @default(now())

  /// Once per miss: the key carries the installment and, after an excusal, its generation.
  @@unique([roundPlayerId, requestKey])
  @@index([installmentId, kind])
  @@index([loanId, createdAt])
}

/// 1.6.5-A. The loan journal: acceptance, payments, missed installments, fees, payoff and
/// collection changes, each with the player's debt after it. Immutable.
model LoanEvent {
  id             String        @id @default(cuid())
  roundPlayerId  String
  roundPlayer    RoundPlayer   @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  loanId         String?
  loan           Loan?         @relation(fields: [loanId], references: [id], onDelete: SetNull)
  kind           LoanEventKind
  /// Signed change to the player's debt: up for an acceptance or fee, down for a payment.
  debtDeltaCents BigInt        @default(0)
  debtAfterCents BigInt
  requestKey     String        @db.VarChar(128)
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@unique([roundPlayerId, requestKey])
  @@index([roundPlayerId, createdAt(sort: Desc)])
  @@index([loanId, createdAt])
}

/// 0.5.0-B. A run: Low-Riders, escorts, cash and product out on the road. What it took is
/// all it has; everything it holds comes home when it does.
model Run {
  id             String         @id @default(cuid())
  roundPlayerId  String
  roundPlayer    RoundPlayer    @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  status         RunStatus      @default(ACTIVE)
  /// City slug the run left from and returns to.
  homeCity       String
  lowRiders      Int
  /// 1.5.0-B. Class composition for this run; old runs default to Low-Riders.
  vehicleLoadout Json           @default("{\"LOW_RIDER\":1}")
  /// 1.5.0-C. The part of the loadout that comes home Damaged or Disabled:
  /// { damaged: {LOW_RIDER, SEDAN, VAN}, disabled: {...} }. Empty is a clean run.
  vehicleDamage  Json           @default("{}")
  escortThugs    Int
  /// The run's wallet, integer cents. Never below zero.
  cashCents      BigInt
  startCashCents BigInt
  /// 0.6.0-D. Beer carried by the run for outpost supply.
  beer           Int            @default(0)
  startBeer      Int            @default(0)
  turnsSpent     Int
  launchedAt     DateTime       @default(now())
  returnedAt     DateTime?
  /// 0.5.0-C. Stops whose road in has been rolled for a police stop, counted from the first.
  roadChecks     Int            @default(0)
  /// 0.5.0-E. Escorts wounded in a convoy fight: not fit to fight again on this run, and
  /// still healing when they get home if their wounds have not run out.
  woundedEscorts Int            @default(0)
  /// 0.9.0-G. When the "run made it home" alert was collected.
  homeAlertedAt  DateTime?
  /// 0.5.0-E. When the run was last hit, for the re-hit cooldown.
  lastHitAt      DateTime?
  /// 0.5.0-E. The guns the escorts carry, out of home stock, best first. A bust or an
  /// arrest on the run takes them all.
  pistols        Int            @default(0)
  shotguns       Int            @default(0)
  tek9s          Int            @default(0)
  ak47s          Int            @default(0)
  /// Trips B. The boss rides with this run: its towns hold it until the player leaves,
  /// the hotel bills its cash by the hour, and the lieutenant runs home until it is back.
  bossAboard     Boolean        @default(false)
  /// Trips B. Everything the hotel has taken from the run's cash.
  hotelCents     BigInt         @default(0)
  /// Trips B. The arrival of the stay being billed, and the hours of it paid so far.
  hotelStayAt    DateTime?
  hotelHours     Int            @default(0)
  tails          ConvoyTail[]
  stops          RunStop[]
  cargo          RunCargo[]
  trades         RunTrade[]
  incidents      RunIncident[]
  supplyPickups  SupplyPickup[]

  @@index([homeAlertedAt, returnedAt])
  @@index([roundPlayerId, status])
}

enum RunStatus {
  ACTIVE
  RETURNED
}

/// 0.5.0-B. One leg of a run and the stop it ends at. The last stop is always home, with no
/// trading window. Where the run is at any moment is worked out from these times.
model RunStop {
  id       String    @id @default(cuid())
  runId    String
  run      Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  order    Int
  city     String
  /// City slugs driven from the previous stop to this one, both ends included.
  route    Json
  departAt DateTime
  arriveAt DateTime
  /// When the trading window closes. Null for the drive home.
  leaveAt  DateTime?

  @@unique([runId, order])
}

/// 0.5.0-B. What is in the trunk.
model RunCargo {
  id            String @id @default(cuid())
  runId         String
  run           Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  productKey    String
  quantity      Int
  /// What was loaded at home, for the receipt.
  startQuantity Int

  @@unique([runId, productKey])
}

/// 0.5.0-B. Every trade a run made, for the receipt.
model RunTrade {
  id         String   @id @default(cuid())
  runId      String
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  city       String
  productKey String
  /// "buy" or "sell".
  direction  String
  /// 0.5.0-C. "pip" (his counter) or "market" (the high market).
  venue      String   @default("pip")
  quantity   Int
  unitCents  Int
  totalCents BigInt
  createdAt  DateTime @default(now())

  @@index([runId])
}

/// 0.5.0-B. Pip's shelf for one product in another city, per player, on the lazy restock clock.
/// No row means a full shelf at the city's supply level.
model CityShelf {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  city          String
  productKey    String
  stock         Int
  stockAt       DateTime

  @@unique([roundPlayerId, city, productKey])
}

/// 0.5.0-B. What a player's crew last saw at Pip's counter in a city: supply, prices and stock.
/// 0.5.0-E. A tail on a run: the attacker's squad is committed, and the hit lands at
/// `landsAt` if the run is still in reach of `city` then.
enum ConvoyTailStatus {
  PENDING
  LANDED
  ESCAPED
}

model ConvoyTail {
  id                 String           @id @default(cuid())
  runId              String
  run                Run              @relation(fields: [runId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              RoundPlayer      @relation("ConvoyTailOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  attackerId         String
  attacker           RoundPlayer      @relation("ConvoyTailAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  /// "HOME" (a squad from where the attacker lives) or "RUN" (the escorts of the attacker's own run).
  source             String
  attackerRunId      String?
  /// The city whose reach the hit lands in.
  city               String
  squad              Int
  /// The squad as it set out: morale, weapons, and the supply boost it burned.
  attackerCrew       Json
  turnsSpent         Int
  actionId           String
  startedAt          DateTime
  landsAt            DateTime
  status             ConvoyTailStatus @default(PENDING)
  settledAt          DateTime?
  /// The fight and what moved, for both sides' reports.
  result             Json?
  /// When the attacker's side (loot, the squad home, its wounds) reached them.
  attackerCreditedAt DateTime?
  alliesCalledAt     DateTime?
  voidedAt           DateTime?
  /// 0.9.0-G. When the run's owner was told (once their Lookouts saw the tail), and when
  /// their alliance was told about the call.
  ownerAlertedAt     DateTime?
  alliesAlertedAt    DateTime?
  backups            ConvoyBackup[]

  @@unique([attackerId, actionId])
  @@index([runId, status])
  @@index([status, landsAt])
  @@index([attackerId, attackerCreditedAt])
}

/// 0.5.0-E. A player's last recon of the area: the runs coming near, in town or leaving
/// where they live and where their run is, as seen then. Only a run it found can be tailed.
model ConvoyRecon {
  id            String      @id @default(cuid())
  roundPlayerId String      @unique
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  seenAt        DateTime
  expiresAt     DateTime
  /// The targets as seen, for the page and for checking a tail.
  targets       Json
  /// Trips C. Bosses visiting the area that the recon spotted.
  bossTargets   Json        @default("[]")
}

/// 0.5.0-E. Thugs sent to a convoy's fight by its owner or an ally. They come home after
/// it, win or lose, with any wounds they took.
model ConvoyBackup {
  id         String      @id @default(cuid())
  tailId     String
  tail       ConvoyTail  @relation(fields: [tailId], references: [id], onDelete: Cascade)
  playerId   String
  player     RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// "OWNER" or "ALLY".
  kind       String
  thugs      Int
  /// Weapons and morale as they rode out.
  crew       Json
  sentAt     DateTime
  wounded    Int         @default(0)
  creditedAt DateTime?

  @@unique([tailId, playerId])
  @@index([playerId, creditedAt])
}

/// Trips D2. Thugs an ally who lives where a boss is hit sends to the fight. They come home
/// after it, win or lose, with any wounds, at the ally's next settle.
model BossHitBackup {
  id         String      @id @default(cuid())
  hitId      String
  hit        BossHit     @relation(fields: [hitId], references: [id], onDelete: Cascade)
  playerId   String
  player     RoundPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  thugs      Int
  /// Weapons and morale as they rode out.
  crew       Json
  sentAt     DateTime
  wounded    Int         @default(0)
  creditedAt DateTime?

  @@unique([hitId, playerId])
  @@index([playerId, creditedAt])
}

enum SitDownStatus {
  PENDING
  AGREED
  DECLINED
  EXPIRED
}

/// Trips D2. Two bosses in one city sit down. Agreed, neither crew can hit the other
/// until `truceUntil`.
model SitDown {
  id         String        @id @default(cuid())
  roundId    String
  city       String
  proposerId String
  proposer   RoundPlayer   @relation("SitDownProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  inviteeId  String
  invitee    RoundPlayer   @relation("SitDownInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status     SitDownStatus @default(PENDING)
  proposedAt DateTime
  expiresAt  DateTime
  answeredAt DateTime?
  truceUntil DateTime?

  @@index([proposerId, status])
  @@index([inviteeId, status])
  @@index([roundId, truceUntil])
}

/// 0.5.0-D. A move of the whole operation to another city. Pending until `arrivedAt`.
model Relocation {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  fromCity      String
  toCity        String
  feeCents      BigInt
  startedAt     DateTime
  arrivesAt     DateTime
  arrivedAt     DateTime?

  @@index([roundPlayerId, startedAt(sort: Desc)])
  @@index([arrivedAt, arrivesAt])
}

/// Trips A. The boss away from home. Stage A flies only; DRIVE is the entourage's way (B).
enum BossTripMode {
  FLY
  DRIVE
}

enum BossTripStatus {
  ACTIVE
  RETURNED
}

/// Trips A. The boss leaves home for a stay in another city and comes back. Home keeps
/// working, run by a lieutenant. Where the boss is follows from the four timestamps, so
/// the trip settles lazily, like a run: it is home once `returnsAt` has passed.
model BossTrip {
  id                   String         @id @default(cuid())
  roundPlayerId        String
  roundPlayer          RoundPlayer    @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  status               BossTripStatus @default(ACTIVE)
  mode                 BossTripMode   @default(FLY)
  /// City slug the boss left from and comes back to.
  homeCity             String
  /// City slug the boss is visiting.
  city                 String
  /// The trip's wallet, integer cents. Never below zero. All the boss has in town.
  bankrollCents        BigInt
  startBankrollCents   BigInt
  /// What the ticket cost, from home cash at launch.
  ticketCents          BigInt
  /// Everything paid to the hotel: the stay at launch, extensions out of the bankroll.
  hotelCents           BigInt
  turnsSpent           Int
  departedAt           DateTime
  arrivesAt            DateTime
  stayUntil            DateTime
  returnsAt            DateTime
  returnedAt           DateTime?
  /// Trips C. When the boss was last hit, for the re-hit cooldown.
  lastHitAt            DateTime?
  /// Trips D. Fit thugs flying with the boss, out of home until the trip is back, and how
  /// many of them were wounded protecting the boss.
  bodyguards           Int            @default(0)
  woundedBodyguards    Int            @default(0)
  /// Trips D. Guns rented in town from Tommy's connect, by weapon key: handed back at
  /// check-out, never owned. And everything the rent has cost.
  rentedGuns           Json           @default("{}")
  gunRentCents         BigInt         @default(0)
  /// Trips D2. What airport security took from the bankroll, and the minutes it cost.
  airportSeizedCents   BigInt         @default(0)
  airportDelayMinutes  Int            @default(0)
  /// Trips D2. When security checked the flight home (the boss leaving town), once.
  airportHomeCheckedAt DateTime?
  hits                 BossHit[]

  @@index([roundPlayerId, status])
  @@index([city, status, arrivesAt])
}

/// Trips C. Locals hitting a boss who is visiting their city. The squad is committed when
/// it starts; the hit lands when the window closes, in the owner's trip settle, if the boss
/// is still in town. The attacker's side reaches them at their next settle, like a convoy.
model BossHit {
  id                 String           @id @default(cuid())
  tripId             String
  trip               BossTrip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              RoundPlayer      @relation("BossHitOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  attackerId         String
  attacker           RoundPlayer      @relation("BossHitAttacker", fields: [attackerId], references: [id], onDelete: Cascade)
  /// The city the hit lands in: the trip's city, where the attacker lives.
  city               String
  squad              Int
  /// Trips D. The squad as it set out: morale and the guns it carries.
  attackerCrew       Json?
  turnsSpent         Int
  actionId           String
  startedAt          DateTime
  landsAt            DateTime
  status             ConvoyTailStatus @default(PENDING)
  settledAt          DateTime?
  /// What moved, for both sides' reports.
  result             Json?
  attackerCreditedAt DateTime?
  /// Trips D2. When the boss called allies who live in the city, and who answered.
  alliesCalledAt     DateTime?
  backups            BossHitBackup[]

  @@unique([attackerId, actionId])
  @@index([tripId, status])
  @@index([status, landsAt])
  @@index([attackerId, attackerCreditedAt])
}

/// 0.5.0-C. What went wrong on a run: a police stop on a road, or a bust or arrest in a town.
enum RunIncidentKind {
  STOP
  BUST
  ARREST
}

model RunIncident {
  id        String          @id @default(cuid())
  runId     String
  run       Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      RunIncidentKind
  /// The town, for a bust or arrest; the city the road led to, for a stop.
  city      String
  /// The road, for a stop: "I-95".
  road      String?
  /// Units taken, by product.
  seized    Json
  fineCents BigInt
  at        DateTime

  @@index([runId])
}

/// 0.5.0-C. One shared high market per round, city and product. Only the push off the
/// baseline is stored: the baseline itself is the round's seeded schedule.
model HighMarket {
  id         String   @id @default(cuid())
  roundId    String
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  city       String
  productKey String
  /// Share off the baseline as of `pushAt`, wearing off from there.
  push       Float    @default(0)
  pushAt     DateTime

  @@unique([roundId, city, productKey])
}

model CitySighting {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  city          String
  seenAt        DateTime
  counter       Json

  @@unique([roundPlayerId, city])
}

/// 0.4.0-B. What one job burns: a district worked on a Scout trip, or PRODUCE. No row means
/// the default, crack only, as every older round works.
model WorkSupplyPolicy {
  id            String      @id @default(cuid())
  roundPlayerId String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  /// Ruleset district key, e.g. CASINO, or PRODUCE.
  job           String
  primary       String
  fallback      String?
  emergency     String?
  /// Only the primary is ever burned.
  strict        Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@unique([roundPlayerId, job])
}

/// 0.3.0-D. A player's private rolodex entry for another player in the same round.
model PlayerContact {
  id        String      @id @default(cuid())
  ownerId   String
  owner     RoundPlayer @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetId  String
  target    RoundPlayer @relation("ContactTarget", fields: [targetId], references: [id], onDelete: Cascade)
  /// 0.9.0-D. Player-chosen rolodex lane. Derived lanes such as alliance and blocked are not stored here.
  kind      String      @default("CONTACT")
  note      String      @default("")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([ownerId, targetId])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([ownerId, kind, updatedAt(sort: Desc)])
}

/// 0.9.0-B. One private message between current-round player identities.
/// Each side archives independently; rows remain for the other side and moderation.
model DirectMessage {
  id String @id @default(cuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  senderId String
  sender   RoundPlayer @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   RoundPlayer @relation("DirectMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  /// Client-generated retry key. Unique per sender so a retried send is replay-safe.
  actionId String
  subject  String
  body     String

  createdAt         DateTime  @default(now())
  readAt            DateTime?
  /// 0.9.0-G. When the recipient's outside alert for this message was collected.
  alertsCollectedAt DateTime?

  senderArchivedAt    DateTime?
  recipientArchivedAt DateTime?
  /// 0.9.0-H. "Delete conversation": gone from that side's folders for good. The row
  /// stays for the other side and as report evidence.
  senderHiddenAt      DateTime?
  recipientHiddenAt   DateTime?

  reports PlayerMessageReport[]

  @@unique([senderId, actionId])
  @@index([recipientId, recipientArchivedAt, readAt, createdAt(sort: Desc)], map: "DirectMessage_recipient_inbox_idx")
  @@index([senderId, senderArchivedAt, createdAt(sort: Desc)], map: "DirectMessage_sender_sent_idx")
  @@index([roundId, createdAt(sort: Desc)], map: "DirectMessage_round_created_idx")
  @@index([alertsCollectedAt, createdAt])
}

/// Account-level communication block. It survives seasonal RoundPlayer resets.
model PlayerBlock {
  id String @id @default(cuid())

  blockerAccountId String
  blocker          Account @relation("PlayerBlocker", fields: [blockerAccountId], references: [id], onDelete: Cascade)

  blockedAccountId String
  blocked          Account @relation("PlayerBlocked", fields: [blockedAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerAccountId, blockedAccountId])
  @@index([blockedAccountId, createdAt(sort: Desc)], map: "PlayerBlock_blocked_created_idx")
}

/// Purpose-driven report record. Admin moderation tooling can resolve these later
/// without granting a casual private-message browser.
model PlayerMessageReport {
  id String @id @default(cuid())

  messageId String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// Null for an automated spam flag (0.9.0-H).
  reporterAccountId String?
  reporter          Account? @relation(fields: [reporterAccountId], references: [id], onDelete: Cascade)

  /// 0.9.0-H. PLAYER or AUTO.
  source String @default("PLAYER")
  reason String

  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?
  resolvedByUsername String?
  /// 0.9.0-H. DISMISSED or ACTIONED.
  resolution         String?
  resolutionNote     String?

  @@unique([messageId, reporterAccountId])
  @@index([resolvedAt, createdAt(sort: Desc)], map: "PlayerMessageReport_resolution_idx")
  @@index([reporterAccountId, createdAt(sort: Desc)], map: "PlayerMessageReport_reporter_idx")
}

/// 0.9.0-H. A player-side mute: messages from the muted account arrive already
/// archived, unread-free and alert-free. The sender is never told.
model PlayerMute {
  id String @id @default(cuid())

  muterAccountId String
  muter          Account @relation("PlayerMuter", fields: [muterAccountId], references: [id], onDelete: Cascade)

  mutedAccountId String
  muted          Account @relation("PlayerMuted", fields: [mutedAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([muterAccountId, mutedAccountId])
}

/// The alliance's own history: founded, joined, left, kicked, handed over, renamed, disbanded.
model AllianceEvent {
  id          String   @id @default(cuid())
  allianceId  String
  alliance    Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)
  type        String
  /// Names as text: history outlives membership.
  actorName   String?
  subjectName String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([allianceId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// News & activity
// ---------------------------------------------------------------------------

model GameNews {
  id String @id @default(cuid())

  /// Null = global announcement, shown in every round.
  roundId String?
  round   Round?  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  title String
  body  String

  isPinned    Boolean  @default(false)
  publishedAt DateTime @default(now())

  /// When the Discord bot claimed it for the news channel. Posts from before
  /// auto-posting were backfilled so the first run doesn't flood the channel.
  discordPostedAt DateTime?
  /// Why Discord refused the post, as the bot reported it. Set together with
  /// discordPostedAt = null; the bot skips it until an admin resends it.
  discordError    String?

  /// 1.0.0-E. A broadcast reaches every player of the season: the bell and their alert channels.
  broadcast   Boolean   @default(false)
  broadcastAt DateTime?

  createdByAccountId String?
  createdBy          Account? @relation("GameNewsAuthor", fields: [createdByAccountId], references: [id], onDelete: SetNull)

  /// 0.3.0-B forum announcements mirror. The discussion id is set once the forum
  /// accepted the post; forumError keeps the last failure for a retry.
  forumDiscussionId String?
  forumPostedAt     DateTime?
  forumError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([roundId, isPinned, publishedAt(sort: Desc)])
}

/// What the Discord bot last reported about its news channel, one row per
/// feature ("news"). Lets the admin panel say why posts are not reaching Discord.
model DiscordBotStatus {
  id         String   @id
  /// Last time the bot checked in for this feature.
  lastSeenAt DateTime
  /// The channel name it posts to, while it can.
  channel    String?
  /// Why it cannot post right now, or null when the channel is usable.
  problem    String?
}

/// 0.3.0-B. A short site-wide notice (maintenance, downtime, round reminders)
/// shown above every page while it is live.
model SiteBanner {
  id String @id @default(cuid())

  message             String
  /// info, warning or critical.
  tone                String    @default("info")
  /// 1.0.0-E. notice, or maintenance: a scheduled outage with its own window.
  kind                String    @default("notice")
  maintenanceStartsAt DateTime?
  maintenanceEndsAt   DateTime?

  startsAt DateTime @default(now())
  endsAt   DateTime

  /// No foreign key: a banner outlives the admin who posted it.
  createdByAccountId String?
  createdByUsername  String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([startsAt, endsAt])
}

/// 0.3.0-B. An admin asked the Discord bot to re-sync roles now instead of on its
/// next scheduled pass. A null discordId means every member. The bot claims each
/// request once, like the news and alert queues.
model DiscordResyncRequest {
  id String @id @default(cuid())

  discordId String?

  /// No foreign key: the request outlives the admin who made it.
  requestedByAccountId String?
  requestedByUsername  String

  createdAt DateTime  @default(now())
  claimedAt DateTime?

  @@index([claimedAt, createdAt])
}

enum ActivityType {
  RAID_ATTACK
  GAME_ANNOUNCEMENT
  RAID_DEFENSE
  DRIVE_BY_ATTACK
  DRIVE_BY_DEFENSE
  COMBAT_TREATMENT
  COMBAT_RECON
  ROUND_JOINED
  SCOUT
  WORK_STREETS
  PRODUCE_CRACK
