# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://streets:streets@localhost:5433/streets_empire?schema=public"

# --- Server -----------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Secret used to sign the session cookie. Change this. 32+ chars.
SESSION_SECRET="dev-only-session-secret-change-me-please-32chars"
SESSION_COOKIE_NAME="se_session"
# Session lifetime in days
SESSION_TTL_DAYS=30

# Comma separated list of allowed browser origins (dev vite server)
CORS_ORIGINS="http://localhost:5173"
# Public browser origin used after external login redirects.
FRONTEND_ORIGIN="http://localhost:5173"

# Optional Discord OAuth login. In the Discord developer portal, set the redirect
# URI to http://localhost:5173/api/auth/discord/callback for local Vite.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:5173/api/auth/discord/callback"

# Optional SMTP mailer used for password recovery emails.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Street Empire <no-reply@streetempire.local>"
PASSWORD_RESET_TTL_MINUTES=60
