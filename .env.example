# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://streets:streets@localhost:5433/streets_empire?schema=public"

# --- Server -----------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Secret used to sign the session cookie. Change this. 32+ chars.
SESSION_SECRET="dev-only-session-secret-change-me-please-32chars"
SESSION_COOKIE_NAME="se_session"
# Session lifetime in days
# "Keep me signed in": a session ends after this many days without a visit (it renews while used).
SESSION_TTL_DAYS=30
# rc.4 (optional). However active, a session ends this long after sign-in; without "Keep me
# signed in", after this many idle hours; "Trust this browser" skips the two-step code this long;
# admin tools ask for a second factor at least this often.
# SESSION_MAX_DAYS=90
# SESSION_SHORT_HOURS=12
# TRUSTED_DEVICE_DAYS=30
# ADMIN_2FA_MAX_AGE_HOURS=12

# Comma separated list of allowed browser origins (dev vite server)
CORS_ORIGINS="http://localhost:5173"
# Public browser origin used after external login redirects.
FRONTEND_ORIGIN="http://localhost:5173"
# Set true only on an invite-only beta/test deployment. Admins always bypass this gate.
BETA_INVITE_ONLY=false
# 1.0.0-A. production | beta | development | test. Optional: without it, an
# invite-only NODE_ENV=production server on its own SESSION_COOKIE_NAME is beta,
# any other production-mode server is production. See docs/DEPLOY.md.
# APP_ENV=development

# Optional Discord OAuth login. In the Discord developer portal, set the redirect
# URI to http://localhost:5173/api/auth/discord/callback for local Vite.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:5173/api/auth/discord/callback"

# Optional verified forum profile linking. Same independent random 64+ character
# secret in Flarum config.php; leave empty until the extension is installed.
FORUM_ORIGIN="https://forum.streetsempire.dev"
FORUM_LINK_SECRET=""
# Optional: mirror admin news into the forum announcements tag. Create an API key
# in Flarum's api_keys table, and use the numeric id of the announcements tag.
# Mirroring stays off while the key or tag id is empty.
FORUM_API_KEY=""
FORUM_API_USER_ID=1
FORUM_NEWS_TAG_ID=""
# Optional (0.3.0-C): the numeric id of a Recruitment tag. Alliance leaders can post
# one recruitment thread there, using the API key above. Off while empty.
FORUM_RECRUITMENT_TAG_ID=""
# Optional beta cosmetic: Discord-linked accounts can select the Beta Tester
# title/badge and beta bot role. Leave false outside beta.
BETA_TESTER_DISCORD_LINKED=false
# Optional legacy beta cosmetic source: visible Flarum groups that also grant it.
BETA_TESTER_FORUM_GROUPS=""

# Optional Discord bot (apps/discord-bot, see its README). The same random 64+
# character secret on the game server and the bot; the game's internal bot API
# stays off while it is empty.
DISCORD_BOT_API_TOKEN=""
# Optional local push from the game server to the bot. Keep this on localhost.
DISCORD_BOT_PUSH_URL="http://127.0.0.1:3002/internal/wake"
DISCORD_BOT_PUSH_TIMEOUT_MS=2000
# Bot only (it also reads DISCORD_CLIENT_ID above and FRONTEND_ORIGIN).
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
GAME_API_URL="http://127.0.0.1:3001"
DISCORD_BOT_LISTEN_HOST="127.0.0.1"
DISCORD_BOT_LISTEN_PORT=3002
DISCORD_SYNC_MINUTES=10
DISCORD_FORUM_GROUPS="Admin,Mod"
# full = game roles plus forum/alliance roles; beta-tester-only = only Beta Tester.
DISCORD_ROLE_SYNC_MODE="full"
# Channel that gets new game news automatically (empty = off), and how often to check.
DISCORD_NEWS_CHANNEL_ID=""
DISCORD_NEWS_MINUTES=1
# Channel that gets public raid results automatically (empty = off).
DISCORD_RAID_FEED_CHANNEL_ID=""
# How often opt-in alerts (/alerts), raid feed posts and round events are checked.
DISCORD_ALERTS_MINUTES=1

# Phone and browser alerts (Web Push). All three empty = off; the Alerts panel says "coming soon".
# Generate a key pair once with: npx web-push generate-vapid-keys
# Never change the pair after players subscribe: every existing device would stop receiving alerts.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact the push services can reach if something goes wrong: mailto:you@example.com or https://...
VAPID_SUBJECT=""

# How long admin audit entries are kept before an admin can purge them.
# 0 keeps every entry forever. Nothing is ever deleted without an admin asking.
ADMIN_AUDIT_RETENTION_DAYS=365

# Optional Resend mailer used for password recovery and email verification.
RESEND_API_KEY=""
EMAIL_FROM="StreetsEmpire <no-reply@streetempire.local>"
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_MINUTES=60

# --- 1.0.0-F operations (all optional) ------------------------------------------
# Maintenance mode: every player request gets 503 and this message; admins, sign-in,
# health checks and the status page stay open. Needs a restart (scripts/ops/maintenance.sh).
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="StreetsEmpire is down for maintenance. We will be back shortly."
# Bearer token for GET /api/metrics (Prometheus text). Empty = the endpoint is off.
# 24+ random characters, e.g. openssl rand -hex 24
METRICS_TOKEN=""
# Backups (npm run ops:backup, see docs/RECOVERY.md). The API reads BACKUP_STATUS_FILE
# to show backup and restore-test health on /admin/monitoring; empty = not watched.
BACKUP_DIR=""
BACKUP_STATUS_FILE=""
BACKUP_MAX_AGE_HOURS=26
RESTORE_TEST_MAX_AGE_DAYS=8
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_LABELLED=5
# Off-server copy: rclone:<remote>:<path> | rsync:<user@host:/path> | s3://<bucket>/<prefix>
BACKUP_OFFSITE=""
# Optional separate, disposable database for restore tests (else a scratch database
# is created and dropped on the same server; the database user then needs CREATEDB).
RESTORE_TEST_DATABASE_URL=""

# Players must verify their email (or sign in with Discord) before they can play.
# Default: on for production and beta, off for development and test. Needs RESEND_API_KEY
# and EMAIL_FROM so the link can arrive.
# REQUIRE_VERIFIED_EMAIL=true
# Players accept the game rules (packages/shared/src/rules-agreement.ts) before they play.
# Same defaults as above.
# REQUIRE_RULES_ACCEPTANCE=true

# --- 1.0.0-rc.2 (optional) --------------------------------------------------------
# Admin tools answer only a session with a second factor: signed in with Discord, or with an
# authenticator code. Same defaults as above (REQUIRE_ADMIN_DISCORD is the rc.2 name, still read).
# See docs/ADMIN-RUNBOOK.md#admin-sign-in.
# REQUIRE_ADMIN_2FA=true
# rc.3: encrypts authenticator secrets in the database. Set it once (openssl rand -base64 48)
# before anyone turns on two-step sign-in, and never change it: that breaks every enrolled app.
# Unset, a key derived from SESSION_SECRET is used, which rotating SESSION_SECRET would break.
# TWO_FACTOR_KEY=
# rc.5: Cloudflare Turnstile "are you human" check on sign-up and password recovery. Both set
# turns it on; either unset leaves it off. Keys from the Cloudflare dashboard -> Turnstile.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# New accounts one address may create in 24 hours; 0 turns the cap off. Going over is
# refused and raised as an exploit flag. Default: 5 on production and beta, off elsewhere.
# SIGNUP_DAILY_LIMIT_PER_IP=5

# --- 1.0.0-H (optional) -----------------------------------------------------------
# Believe X-Forwarded-For. Defaults to true when NODE_ENV=production (nginx in front).
# TRUST_PROXY=true
# Log level override: fatal, error, warn, info, debug, trace (default info in production).
# LOG_LEVEL=info
# The date production secrets were last rotated; npm run ops:launch-check reads it.
# SECRETS_ROTATED_AT=2026-10-01
