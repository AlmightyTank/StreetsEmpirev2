# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://streets:streets@localhost:5433/streets_empire?schema=public"

# --- Server -----------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Secret used to sign the session cookie. Change this. 32+ chars.
SESSION_SECRET="dev-only-session-secret-change-me-please-32chars"
SESSION_COOKIE_NAME="se_session"
# Session lifetime in days
SESSION_TTL_DAYS=30

# Comma separated list of allowed browser origins (dev vite server)
CORS_ORIGINS="http://localhost:5173"
