# StreetsEmpire public-platform Nginx reference
#
# Checkout:
#   /opt/streets-empire/StreetsEmpirev2
#
# API:
#   127.0.0.1:3001
#
# Use this as a reference for /etc/nginx/sites-available/streets-empire.
# Let Certbot manage the listen 443/certificate directives on the VPS.

# Public website: static site + deliberately public API only.
server {
    listen 80;
    listen [::]:80;
    server_name streetsempire.dev www.streetsempire.dev;

    root /opt/streets-empire/StreetsEmpirev2/apps/site/dist;
    index index.html;

    # Hashed Vite assets can be cached indefinitely.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The public host is intentionally NOT a gateway to authenticated game APIs.
    location /api/public/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        return 404;
    }

    # index.html is checked on every load, so a new build is seen at once.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}

# Live game: static game client + full API.
server {
    listen 80;
    listen [::]:80;
    server_name play.streetsempire.dev;

    root /opt/streets-empire/StreetsEmpirev2/apps/web/dist;
    index index.html;

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Web Push service worker must refresh instead of living in a long cache.
    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        try_files $uri =404;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # index.html names this build's hashed scripts, which are cached for a year. It must
    # be checked on every load, or a phone can keep running an old build against a new
    # API (an old log-in page with no "are you human" check, say).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}



# Beta game: completely separate checkout/API/database from live.
server {
    listen 80;
    listen [::]:80;
    server_name beta.streetsempire.dev;

    root /opt/streets-empire/StreetsEmpirev2-beta/apps/web/dist;
    index index.html;

    # Keep test pages out of search engines and caches outside our control.
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header X-StreetsEmpire-Environment "beta" always;

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location = /manifest.webmanifest {
        try_files $uri =404;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # index.html is checked on every load (see the live game). add_header here replaces the
    # server-level headers, so they are repeated.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header X-StreetsEmpire-Environment "beta" always;
    }
}

# After DNS resolves, let Certbot add HTTPS to each hostname:
#
#   sudo certbot --nginx -d streetsempire.dev -d www.streetsempire.dev
#   sudo certbot --nginx -d play.streetsempire.dev
#   sudo certbot --nginx -d beta.streetsempire.dev
#
# Always validate before reload:
#
#   sudo nginx -t
#   sudo systemctl reload nginx
