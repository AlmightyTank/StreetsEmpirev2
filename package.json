{
  "name": "streets-empire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Street Empire - Classic OG reconstruction (ruleset classic-og-v0.1)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @streets/server",
    "dev:web": "npm run dev -w @streets/web",
    "build": "npm run build -w @streets/server && npm run build -w @streets/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:release": "node scripts/qa/release-check.mjs",
    "qa:load": "node scripts/qa/load-smoke.mjs",
    "qa:combat": "node --import tsx scripts/qa/combat-sim.mjs",
    "db:seed:combat": "node --import tsx scripts/qa/seed-combat.mjs",
    "db:seed:combat:recovery": "node --import tsx scripts/qa/seed-combat-recovery.mjs",
    "db:seed:combat:strategy": "node --import tsx scripts/qa/seed-combat-strategy.mjs",
    "db:seed:combat:onboarding": "node --import tsx scripts/qa/seed-combat-onboarding.mjs",
    "qa:combat:browser": "node --import tsx scripts/qa/combat-browser-fixture.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0",
    "dotenv": "^16.4.7"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
