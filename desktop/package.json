{
  "name": "streetsempire-desktop",
  "private": true,
  "version": "0.1.2",
  "description": "StreetsEmpire portable Windows game client with opt-in Discord Rich Presence",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:config": "node scripts/build-config.mjs",
    "start": "npm run prepare:config && electron .",
    "dist:win": "npm run dist:portable",
    "test": "node --test",
    "check": "node --check src/main.cjs && node --check src/discord-ipc.cjs && node --check src/activity.cjs",
    "dist:portable": "npm run prepare:config && electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.streetsempire.desktop",
    "productName": "StreetsEmpire",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "StreetsEmpire-Portable-${version}.${ext}"
    }
  }
}
